{
  "minutesRepo": "acme-co/acme-office",
  "workspaceRepo": "acme-office",
  "displayName": "Acme",
  "repos": {
    "acme-office": {"path": ".", "github": "acme-co/acme-office", "branchPrefix": "feat/", "merge": "land"},
    "acme-web": {"path": "web", "github": "acme-co/web-app", "branchPrefix": "work/", "noPush": ["release", "main"], "merge": "pr", "doneNote": "Done also means the preview deploy is green."},
    "acme-api": {"path": "api", "branchPrefix": "feature/", "merge": "pr"},
    "acme-bot": {"path": "bot"}
  },
  "room": {
    "env": {"ACME_ENV": "dev"},
    "deny": ["Bash(acme-cli deploy*)"],
    "prodRead": ["mcp__acme-prod__*"],
    "portBase": 42000
  },
  "ownerOnly": ["deploying to acme-prod"],
  "tracker": {"type": "none"},
  "sources": {
    "widget-kit": {"url": "https://example.com/widgets/kit", "ref": "v2.1.0", "sha": "0123456789abcdef0123456789abcdef01234567", "dir": "sources/widget-kit", "licence": "MIT", "vetted": "https://example.com/acme-office/issues/7#issuecomment-1"},
    "tagless": {"url": "https://example.com/widgets/tagless", "ref": null, "sha": "fedcba9876543210fedcba9876543210fedcba98", "dir": "sources/tagless", "licence": "Apache-2.0", "vetted": "https://example.com/acme-office/issues/7#issuecomment-2"}
  }
}
