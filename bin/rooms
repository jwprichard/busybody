         and owner_reason(0, "waiting", "idle", "WAITING", {"state": "OPEN", "isDraft": True}) == "draft PR to review"
         and owner_reason(0, "working", "busy", None, {"state": "OPEN", "isDraft": True}) == ""
         and owner_reason(0, "done", "idle", "DONE", {"state": "MERGED", "isDraft": False}) == ""),
        ("a room-less initiative's own open DECISION makes the row need you",
         [(t["needs_you"], t["reason"]) for t in build_tasks({"rooms": []}, [{"number": 3, "title": "t", "labels": [], "comments": [
             {"body": "**DECISION** · x · #3\nwhich?", "url": "https://github.com/acme-co/acme-office/issues/3#c1", "createdAt": "2026-10-06T01:00:00Z"}]}], now)]
         == [(True, "1 decision to answer")]),
        ("an ANSWER by the controller or office closes the earlier DECISIONs, whatever its header shape",
         all(not open_decisions([{"body": "**DECISION** · r · #1\nq?", "url": "https://github.com/acme-co/acme-office/issues/1#c1"},
                                 {"body": ans, "url": "https://github.com/acme-co/acme-office/issues/1#c2"}], now)
             for ans in ("**ANSWER** · owner · control room\n(to https://github.com/acme-co/acme-office/issues/1#c1) go with A",
                         "**ANSWER** · office · #1\ngo with A", "**ANSWER** · controller · #1\n(to https://github.com/acme-co/acme-office/issues/1#c1)"))),
        ("an ANSWER linking a DIFFERENT decision leaves this one open; a stranger's ANSWER closes nothing",
         [d["url"] for d in open_decisions([
             {"body": "**DECISION** · r · #1\nfirst?", "url": "https://github.com/acme-co/acme-office/issues/1#c1"},
             {"body": "**DECISION** · r · #1\nsecond?", "url": "https://github.com/acme-co/acme-office/issues/1#c2"},
             {"body": "**ANSWER** · owner · control room\n(to https://github.com/acme-co/acme-office/issues/1#c2) B", "url": "https://github.com/acme-co/acme-office/issues/1#c3"}], now)]
         == ["https://github.com/acme-co/acme-office/issues/1#c1"]
         and len(open_decisions([{"body": "**DECISION** · r · #1\nq?", "url": "u1"}, {"body": "**ANSWER** · stranger · #1\nok", "url": "u2"}], now)) == 1),
        ("owner reason: a decision, blocked, capped, a PR waiting on the owner; otherwise none",
         owner_reason(1, "working", "busy", None, None) == "1 decision to answer"
         and owner_reason(0, "done", "idle", "DONE", {"state": "OPEN", "isDraft": True}) == "draft PR to review"
         and owner_reason(0, "done", "idle", "DONE", {"state": "OPEN", "isDraft": False}) == "PR ready to merge"
         and owner_reason(0, "idle", "idle", "BLOCKED", None) == "blocked, needs input"
         and owner_reason(0, "capped", "idle", None, None) == "over its spend cap"
         and owner_reason(0, "working", "busy", None, None) == "" and owner_reason(0, "done", "idle", "DONE", None) == ""),
        ("a stage:complete label on an open issue shows it at the top",
         [(t["number"], t["stage"]) for t in build_tasks({"rooms": []}, [{"number": 1, "title": "a", "labels": ["stage:complete"], "comments": []},
          {"number": 2, "title": "b", "labels": ["stage:idea"], "comments": []}], now)] == [(1, "complete"), (2, "idea")]),
        ("a live job between turns is idle", lead_status({"state": "working", "status": "idle"}) == "idle"),
    ]
    import tempfile
    tmp = tempfile.mkdtemp()
    clock, calls = [1000.0], []

    def compute():
        calls.append(1)
        if len(calls) == 3:
            raise RuntimeError("boom")
        return f"doc{len(calls)}"
    first = cached_document(compute, tmp, lambda: clock[0])
    clock[0] += 59
    second = cached_document(compute, tmp, lambda: clock[0])
    clock[0] += 2
    third = cached_document(compute, tmp, lambda: clock[0])
    clock[0] += 61
    fourth = cached_document(compute, tmp, lambda: clock[0])    # compute raises: the last document is served
    # live() adds minutes.stale and age as new top-level fields and leaves every other field as build() made it
    class FakeMinutes:
        stale, synced = True, []
        def __init__(self, repo, cache_dir): pass
        def sync(self, labels=(), issues=(), force=False): FakeMinutes.synced.append(force)
        def issues(self, label, keys=()): return []
        def issue(self, n, keys=()): return None
        def age(self): return 42
    g = globals()
    saved = {k: g[k] for k in ("run", "load_roles", "minutes")}
    try:
        g["run"], g["load_roles"] = (lambda cmd, timeout=60: ""), (lambda: (None, None))
        g["minutes"] = type("M", (), {"Minutes": FakeMinutes})
        doc_live = live(now, fresh=True)
        doc_base = build([], [], {}, "", now, None, None, {}, [])
    finally:
        g.update(saved)
    checks.append(("live() adds minutes.stale/age_s and force follows --fresh, nothing else changes",
                   doc_live.pop("minutes") == {"stale": True, "age_s": 42} and doc_live.pop("gh_usage", 0) != 0 and doc_live.pop("live_sessions", 0) != 0 and doc_live == doc_base and FakeMinutes.synced == [True]))
    ttl0 = cached_document(lambda: "doc-fresh", tmp, lambda: clock[0], ttl=0)
    nocache = tempfile.mkdtemp()
    boom = lambda: (_ for _ in ()).throw(RuntimeError("x"))
    emp = json.loads(cached_document(boom, nocache, lambda: clock[0], empty=empty_document))
    full_none = build([], [], {}, "", now, None, "x")
    checks += [("--fresh (ttl 0) bypasses the document cache", ttl0 == "doc-fresh"),
               ("no cache and a failing build: an empty valid document flagged stale, no traceback",
                emp["rooms"] == [] and emp["minutes"]["stale"] is True and set(emp) - {"minutes"} == set(full_none)),
               ("the document is cached for 60s and shared", (first, second, third, len(calls[:3])) == ("doc1", "doc1", "doc2", 3)),
               ("a failing build serves the last document", fourth == "doc2"),
               ("the minutes client self-test passes",
                subprocess.run([sys.executable, "-I", os.path.join(ENGINE_ROOT, "bin", "lib", "minutes.py"), "--self-test"]).returncode == 0),
               ("the session helper self-test passes (ending a session by pid, and itself)",
                subprocess.run([sys.executable, "-I", os.path.join(ENGINE_ROOT, "bin", "lib", "sessions.py"), "--self-test"]).returncode == 0)]
    import shutil
    shutil.rmtree(tmp, ignore_errors=True)
    bad = [n for n, c in checks if not c]
    print("rooms self-test:", "ok" if not bad else "FAILED: " + "; ".join(bad))
    sys.exit(1 if bad else 0)


def leftovers(doc, now_ms=None, min_age_s=300):
    """Live room-*/role-* sessions (pid alive, under this workspace) that no open issue accounts for: [(name, state)]. Nothing when the
    GitHub reads behind the document are stale or errored (not conclusive), and sessions launched under `min_age_s` ago are skipped
    (their issue may not be in the cached document yet)."""
    m = doc.get("minutes") or {}
    if m.get("stale") or m.get("error") or doc.get("roles_error"):
        return []
    known = {r.get("name") for r in doc.get("rooms", [])} | {s.get("name") for s in doc.get("role_sessions", [])}
    import time
    now_ms = now_ms if now_ms is not None else time.time() * 1000
    return [(s["name"], s.get("state")) for s in doc.get("live_sessions", [])
            if s.get("name") and s["name"] not in known and now_ms - (s.get("started_ms") or 0) >= min_age_s * 1000]


def leftovers_cmd():
    """Session-start check, for the controller session only (never inside a room or role session): one line per leftover with the
    exact command that ends it. Reads the cached document (no per-room gh calls). An error is one line on stderr, never silence."""
    try:
        agents = {a["pid"]: a.get("name") or "" for a in sessions.agents_list(5) if isinstance(a.get("pid"), int)}
        if any(re.match(r"^(room|role)-", agents.get(p, "")) for p in sessions.ancestors()):
            return 0
        doc = json.loads(cached_document(lambda: json.dumps(live(datetime.now(timezone.utc), False), indent=1), empty=empty_document))
        end = os.path.join(ENGINE_ROOT, "bin", "end-session")
        for name, state in leftovers(doc):
            print(f"{name} is still running ({state or 'unknown'}) but no open issue has it: end it with `{end} {name}`")
    except Exception as e:
        print(f"rooms --leftovers: {type(e).__name__}: {str(e)[:150]}", file=sys.stderr)
    return 0


def main(argv):
    if "--self-test" in argv:
        self_test()
    if "--leftovers" in argv:
        sys.exit(leftovers_cmd())
    if "-h" in argv or "--help" in argv or "--json" not in argv:
        print(__doc__)
        sys.exit(0 if ("-h" in argv or "--help" in argv) else 2)
    fresh = "--fresh" in argv   # skip the 60 s document cache and the client's 10 s reuse (after an answer or a command)
    print(cached_document(lambda: json.dumps(live(datetime.now(timezone.utc), fresh), indent=1),
                          ttl=0 if fresh else DOC_TTL, empty=empty_document))


main(sys.argv[1:])
