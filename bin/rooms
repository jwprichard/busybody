#!/usr/bin/python3 -I
"""State of the office: one JSON document merging every project room.

  bin/rooms --json       print the document (no model calls)
  bin/rooms --json --fresh  the same, skipping the 60 s document cache and the minutes client's 10 s reuse (after an answer or a command)
  bin/rooms --leftovers  session-start check: live room-*/role-* sessions no open issue accounts for, each with the command that ends it
  bin/rooms --self-test  check the merge against fixtures/rooms/

Minutes: line 1 `**TYPE** · who · where` then a one-line summary (old `TYPE:` prefixes still read).
Types: PROGRESS DECISION BLOCKED DONE ANSWER WAITING NOTE RECORD. An ANSWER whose "who" is not the
controller or the office is flagged (`flags`, per room `flagged`) and closes no DECISION.
Per open `initiative` issue with a `## Room` block: the Room fields, the latest report comment, `state`
(needs_input|capped|done|waiting|working|idle; waiting = last room minute is WAITING), the room lead's status from `claude agents --json`, spend from
`bin/room-cost --json`, the `bin/status` line and whether the issue is labelled `capped`. Top level `minutes` = {stale, age_s}: whether
the GitHub reads behind the document are stale (served from cache after a failure) and how old the last good one is.
Each room also carries `team` (the Room block's `- team: <name>`, default dev-team), `phases` (from
teams/<team>/team.json, [] when that file is missing or invalid) and `phase` (the last valid `Phase: <name>`
line in the room's own PROGRESS/WAITING minutes, else the last phase while a watcher is alive, else the first
phase when the room has posted at most its first minute, else null).
Top level `decisions[]` = DECISIONs with no later ANSWER, from rooms and from role issues (those carry
`role` and address the running role session, so an answer from the office nudges it).
A role pass runs on its initiative's issue: a DECISION there whose header is `**DECISION** · role-<role>-<slug> · #N`
is addressed to that pass session (never to the room lead), whether or not the initiative has a `## Room` block, and
leaves the room's own `open_decisions` alone. Older passes had an issue of their own (open, title `<role>: <task>`, label `refine`
or `<role>-pass`): those, and the role issue, still feed the list.
Top level `role_sessions[]` = every running `role-<role>-*` session (parallel passes of one role are all listed, each with the initiative
`issue` it posts on), shaped like a room's `lead` (the room lead's status).
Top level `stages` = the stage table, most complete first (`parked` last), and `tasks[]` = the tracker, one row per open initiative issue
(with or without a Room block; a closed one is gone, `stage:complete` is a label on an open one). Role passes are not rows.
Each row: number, name (`Friendly name (N-issue)`), url, stage (the issue's one `stage:<name>` label, none = idea; `stage_warning` when
it has several or an unknown one), needs_you + reason (an unanswered DECISION/BLOCKED, a capped room, a PR waiting on the owner:
a flag, not a stage), worker (its room, if any) and working, age_s (since the last comment). Sorted by stage, most
complete first, then most recently updated first.
Top level `roles[]` = every standing role from `bin/role status --json` (reshaped, no model calls);
`roles_error` says why it is empty when `bin/role` failed. Never breaks the rest of the document.
"""
import json, os, re, subprocess, sys
from datetime import datetime, timezone

ENGINE_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ENGINE_ROOT, "bin", "lib"))
from officeroot import data_root, invoked_root, workspace_root, selftest_reexec  # noqa: E402
selftest_reexec(ENGINE_ROOT)
WORKSPACE_ROOT = workspace_root(ENGINE_ROOT, invoked=invoked_root())
import officeconfig  # noqa: E402
import minutes  # noqa: E402
import prcache  # noqa: E402
import ghusage  # noqa: E402
import sessions  # noqa: E402
from tracker import Tracker  # noqa: E402
OFFICE = officeconfig.load_or_exit(WORKSPACE_ROOT, "rooms")
REPO = OFFICE.minutes_repo
TYPES = "PROGRESS|DECISION|BLOCKED|DONE|ANSWER|WAITING|NOTE|RECORD"
VERBS = tuple(TYPES.split("|"))
# New minute: first line `**TYPE** · who · where`, then a one-line summary. Old: `TYPE:` / `TYPE (…):` prefix.
HEADER_RE = re.compile(rf"^\s*\*\*({TYPES})\*\*\s*·\s*([^·\n]*?)\s*(?:·\s*(.*?))?\s*$", re.I)
VERB_RE = re.compile(rf"^\s*({TYPES})\b[^:\n]*:", re.I)
ANSWER_WRITERS = ("controller", "office", "owner")   # the office posts the owner's answers as `owner`
# Rooms' reply types: a controller NOTE/RECORD/ANSWER is not the room speaking.
CONTROL_TYPES = ("NOTE", "RECORD", "ANSWER")


def run(cmd, timeout=60):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def parse_ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def parse_room(body):
    """Fields of the `## Room` block as a dict; None if the issue has no such block."""
    m = re.search(r"^## Room\s*\n(.*?)(?=^## |\Z)", body or "", re.S | re.M)
    if not m:
        return None
    room = {}
    for line in m.group(1).splitlines():
        kv = re.match(r"^\s*[-*]\s*([\w-]+):\s*(.*?)\s*$", line)
        if kv:
            room[kv.group(1).replace("-", "_")] = kv.group(2)
    return room if room.get("room") else None


def parse_minute(body):
    """{type, who, where, summary, format, flags} for a minute comment; None for chatter.
    New format reads only the header line; old formats (`TYPE:`, `ANSWER (from the user):`) still parse."""
    lines = [l.strip() for l in (body or "").splitlines() if l.strip()]
    if not lines:
        return None
    m = HEADER_RE.match(lines[0])
    if m:
        typ, who, where = m.group(1).upper(), m.group(2).strip(), (m.group(3) or "").strip()
        flags = []
        if typ == "ANSWER" and who.lower() not in ANSWER_WRITERS:
            flags.append("answer not from the controller or the office")
        return {"type": typ, "who": who, "where": where, "summary": lines[1] if len(lines) > 1 else "",
                "format": "header", "flags": flags}
    m = VERB_RE.match(body or "")
    if m:
        return {"type": m.group(1).upper(), "who": "", "where": "", "summary": lines[0],
                "format": "legacy", "flags": []}
    return None


def classify(body):
    p = parse_minute(body)
    return p["type"] if p else None


def first_line(body):
    """What the sticky note and the office show: the summary of a new-format minute, else line 1."""
    p = parse_minute(body)
    if p and p["format"] == "header" and p["summary"]:
        return p["summary"]
    for line in (body or "").splitlines():
        if line.strip():
            return line.strip()
    return ""


def report(c, now):
    p = parse_minute(c.get("body")) or {}
    verb = p.get("type")
    ts = c.get("createdAt") or c.get("created_at") or ""
    return {
        "verb": verb,
        "who": p.get("who", ""),
        "where": p.get("where", ""),
        "flags": p.get("flags", []),
        "first_line": first_line(c.get("body")),
        "url": c.get("url", ""),
        "at": ts,
        "age_s": max(0, int((now - parse_ts(ts)).total_seconds())) if ts else None,
        "body": c.get("body", ""),
    }


def lead_status(agent):
    if not agent:
        return "missing"
    # `claude agents`: `state` is the job's lifecycle (a live background job stays "working"),
    # `status` is turn activity (busy/idle). Trust `status` for busy vs idle when it's present.
    state = str(agent.get("state", "")).lower()
    status = str(agent.get("status", "")).lower()
    blob = f"{state} {status}"
    if any(w in blob for w in ("block", "wait", "input", "needs")):
        return "needs_input"
    activity = status or state
    if any(w in activity for w in ("busy", "working", "running")):
        return "busy"
    return "idle"


def status_lines(text):
    """issue number -> the bin/status block for it (header + step lines)."""
    out, cur = {}, None
    for line in (text or "").splitlines():
        m = re.match(r"^▸ #(\d+)\b", line)
        if m:
            cur = int(m.group(1))
            out[cur] = [line[2:]]
        elif cur and line.startswith("  "):
            out[cur].append(line.strip())
        else:
            cur = None
    return {k: "\n".join(v) for k, v in out.items()}


DECISION_RECORD_RE = re.compile(r"^\s*DECISION\s*\(", re.I)


URL_RE = re.compile(r"https?://[^\s)>\]]+")


def open_decisions(comments, now):
    """DECISION comments with no later ANSWER comment. An attributed `DECISION (user|MAD|…):`
    (old) or a `RECORD` records a decision already made, so it is not a sticky note for the owner.
    A later ANSWER closes every earlier open DECISION, unless it links (a url) a DECISION comment on the issue:
    then it closes only the ones it links. An ANSWER from anyone but the controller or the office is flagged and closes nothing."""
    decisions = [c.get("url") for c in comments if (parse_minute(c.get("body")) or {}).get("type") == "DECISION" and c.get("url")]
    pending = []
    for c in comments:
        p = parse_minute(c.get("body")) or {}
        v = p.get("type")
        if v == "DECISION" and not DECISION_RECORD_RE.match(c.get("body") or ""):
            pending.append(c)
        elif v == "ANSWER" and not p["flags"]:
            linked = {u.rstrip(".,;:") for u in URL_RE.findall(c.get("body") or "")} & set(decisions)
            pending = [d for d in pending if d.get("url") not in linked] if linked else []
    return [report(c, now) for c in pending]


def flagged_answers(comments, now):
    return [report(c, now) for c in comments if (parse_minute(c.get("body")) or {}).get("flags")]


def room_state(lead, capped, comments):
    """The room's state for the office: needs_input, capped, done, waiting, working or idle.
    waiting = the room's own latest minute is WAITING (controller NOTE/RECORD/ANSWER don't count)
    and the lead is not mid-turn."""
    own = [c for c in comments if classify(c.get("body")) not in (None,) + CONTROL_TYPES]
    last = classify(own[-1].get("body")) if own else None
    if lead == "needs_input":
        return "needs_input"
    if capped:
        return "capped"
    if last == "DONE":
        return "done"
    if last == "WAITING" and lead != "busy":
        return "waiting"
    return "working" if lead == "busy" else "idle"


DEFAULT_TEAM = "dev-team"
# A role pass runs a recipe of its own, whatever the issue says.
ROLE_TEAMS = {"analyst": "refine"}
PHASE_RE = re.compile(r"^\s*Phase:\s*([\w.-]+)\s*$", re.I | re.M)
ROOM_MINUTES = ("PROGRESS", "WAITING")


def load_phases(team):
    """The recipe's `phases` from teams/<team>/team.json: a list of names, or None when the file is
    missing, invalid or has no usable list (the recipe name still shows; the phase is unknown)."""
    if not re.fullmatch(r"[\w.-]+", team or ""):
        return None
    try:
        doc = json.load(open(os.path.join(WORKSPACE_ROOT, "teams", team, "team.json")))
    except (OSError, ValueError):
        return None
    phases = doc.get("phases") if isinstance(doc, dict) else None
    if not isinstance(phases, list) or not phases or not all(isinstance(p, str) and p for p in phases):
        return None
    return phases


def watcher_alive(worktree):
    """True when `<worktree>/.claude/watch.json` names a running pid (read-only probe)."""
    if not worktree:
        return False
    try:
        pid = int(json.load(open(os.path.join(worktree, ".claude", "watch.json"))).get("pid"))
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError, TypeError, AttributeError):
        return False


def room_team(team, comments, watching, phases_of=load_phases):
    """{team, phase, phases} for a room. Phase = the last valid `Phase: <name>` line (name in the
    recipe's phases) in the body of the room's own PROGRESS/WAITING minutes, else inferred: watching
    means the last phase, no minutes beyond lead-online means the first. None when unknown."""
    phases = phases_of(team)
    phase = None
    if phases:
        own = [c for c in comments if classify(c.get("body")) not in (None,) + CONTROL_TYPES]
        for c in own:
            if classify(c.get("body")) not in ROOM_MINUTES:
                continue
            for name in PHASE_RE.findall(c.get("body") or ""):
                if name in phases:
                    phase = name
        if phase is None:
            if watching:
                phase = phases[-1]
            elif len(own) <= 1:
                phase = phases[0]
    return {"team": team, "phase": phase, "phases": phases or []}


def role_entry(r):
    """One `bin/role status --json` role, reshaped for the office."""
    cost = r.get("cost") or {}
    con = cost.get("contractors") or {}
    mem = r.get("memory") or {}
    pil = r.get("pilot") or None
    pending = r.get("pending") or []
    return {
        "name": r.get("name", ""),
        "status": r.get("status", "probation"),
        "enabled": bool(r.get("enabled")),
        "goal": r.get("goal") or "",
        "issue": r.get("issue"),
        "use_count": r.get("use_count", 0),
        "pilot": {"uses": pil.get("uses", 0), "weeks": pil.get("weeks", 0), "days": pil.get("days", 0)} if pil else None,
        "last_use": r.get("last_use"),
        "memory": {
            "index_bytes": mem.get("index_bytes", 0), "total_bytes": mem.get("total_bytes", 0),
            "cap_index": mem.get("cap_index", 0), "cap_role": mem.get("cap_role", 0),
            "stale_lines": mem.get("stale_lines", 0), "dated_lines": mem.get("dated_lines", 0),
        },
        "cost": {
            "month": cost.get("month", 0.0), "budget": r.get("budget_usd_month"),
            "contractors_month": con.get("month", 0.0), "contractors_budget": r.get("contractor_budget_usd_month"),
            "last_activity": cost.get("last_activity") or "",
        },
        "drafts": r.get("drafts") or {"approved": 0, "unedited": 0},
        "ratings": r.get("ratings") or {},
        "flags": r.get("flags") or [],
        "pending_files": len(pending),
        "memory_pending": bool(pending),
        "disabled_reason": r.get("disabled_reason"),
    }


def workspace_doc():
    """What the office band needs from office.json: the workspace's name, minutes repo, repos (name and GitHub slug) and tracker."""
    t = Tracker(OFFICE.tracker)
    return {"name": OFFICE.display_name, "minutes_repo": REPO, "workspace_repo": OFFICE.workspace_repo,
            "repos": [{"name": r, "github": OFFICE.github(r)} for r in OFFICE.repos],
            "tracker": {"type": t.type, "name": t.name, "card_url_regex": t.card_re.pattern if t.card_re else None}}


def build_roles(role_doc):
    return [role_entry(r) for r in (role_doc or {}).get("roles", []) if r.get("name")]


def role_of_session(session, roles):
    """The role a `role-<role>-<slug>` session belongs to: the longest known role name that prefixes it, else None."""
    hits = [r for r in roles if (session or "").startswith(f"role-{r}-")]
    return max(hits, key=len) if hits else None


def live_sessions(agents, role, roles):
    """The role's running sessions (`role-<role>-*`, a live process behind each, not another role's), newest first."""
    table = sessions.processes()
    live = [a for a in agents if role_of_session(a.get("name"), roles) == role and sessions.is_live(a, table)]
    return sorted(live, key=lambda a: -(a.get("startedAt") or 0))


def split_decisions(comments, now, roles):
    """(room, passes): an issue's open DECISIONs, split into the room lead's and the role passes' ([(decision, role)])."""
    room_d, pass_d = [], []
    for d in open_decisions(comments, now):
        role = role_of_session(d.get("who"), roles)
        if role:
            pass_d.append((d, role))
        else:
            room_d.append(d)
    return room_d, pass_d


def pass_slug(task):
    """The slug bin/role run puts in the session name (`role-<role>-<slug>`)."""
    return re.sub(r"[^a-z0-9]+", "-", task.lower()).strip("-")[:30].strip("-") or "pass"


def pass_session(agents, role, task):
    """A pass issue's running session: `role-<role>-<slug>[-n]` from its title, not finished, or None."""
    slug = f"role-{role}-{pass_slug(task)}"
    table = sessions.processes()
    live = [a for a in agents if re.fullmatch(re.escape(slug) + r"(-\d+)?", a.get("name") or "") and sessions.is_live(a, table)]
    return sorted(live, key=lambda a: -(a.get("startedAt") or 0))[0] if live else None


def roles_on_disk():
    """Standing roles of this workspace: roles/<name>/role.json (a role with no issue is still a role)."""
    import glob
    return {os.path.basename(os.path.dirname(f)) for f in glob.glob(os.path.join(WORKSPACE_ROOT, "roles", "*", "role.json"))}


def role_inbox(role_issues, agents, now, pass_issues=None, initiatives=(), known_roles=()):
    """(role_sessions[], decisions[]): the sticky notes role sessions have put to the owner, each addressed
    to the running session by name so the office can nudge it; the session entry has the same `lead`
    shape as a room, which is what the nudge reads. Notes come from the pass's own issue (open, titled
    `<role>: <task>`, labelled `refine` or `<role>-pass`) and from the role issue (older passes), and, for a pass on an initiative, from
    that initiative's issue (a minute whose "who" is the pass session), with or without a Room block."""
    sessions, decisions, seen = [], [], set()
    roles = set(role_issues or {}) | set(known_roles)

    def add_session(ag, role, number, comments=()):
        if ag["name"] not in seen:
            seen.add(ag["name"])
            sessions.append({"name": ag["name"], "role": role, "issue": number,
                             "lead": {"status": lead_status(ag), "agent": ag},
                             **room_team(ROLE_TEAMS.get(role, role), comments, False)})

    for iss in sorted(pass_issues or [], key=lambda i: i.get("number", 0)):
        title = iss.get("title", "")
        role, _, task = title.partition(": ")
        labels = [l["name"] if isinstance(l, dict) else l for l in iss.get("labels", [])]
        if not task or role not in (role_issues or {}) or not ({"refine", f"{role}-pass"} & set(labels)):
            continue
        ag = pass_session(agents, role, task)
        name = ag["name"] if ag else f"role-{role}-{pass_slug(task)}"
        if ag:
            add_session(ag, role, iss["number"], iss.get("comments", []))
        for d in open_decisions(iss.get("comments", []), now):
            d.update({"room": name, "issue": iss["number"], "repo": OFFICE.workspace_repo, "role": role})
            decisions.append(d)
    where = {}  # session -> (initiative issue number, its minutes), from the minutes the session wrote there
    for iss in initiatives:
        for c in iss.get("comments", []):
            who = (parse_minute(c.get("body")) or {}).get("who")
            if role_of_session(who, roles):
                where.setdefault(who, (iss["number"], []))[1].append(c)
    for role in sorted(roles):
        iss = (role_issues or {}).get(role)
        live = live_sessions(agents, role, roles)
        for ag in live:
            number, own = where.get(ag["name"], (iss["number"] if iss else None, []))
            add_session(ag, role, number, own)
        name = live[0]["name"] if live else f"role-{role}"
        for d in open_decisions(iss.get("comments", []), now) if iss else []:
            d.update({"room": name, "issue": iss["number"], "repo": OFFICE.workspace_repo, "role": role})
            decisions.append(d)
    for iss in sorted(initiatives, key=lambda i: i.get("number", 0)):
        room = parse_room(iss.get("body")) or {}
        for d, role in split_decisions(iss.get("comments", []), now, roles)[1]:
            d.update({"room": d["who"], "issue": iss["number"], "repo": room.get("repo") or OFFICE.workspace_repo, "role": role})
            decisions.append(d)
    return sessions, decisions


# ---- the task tracker: one row per task -------------------------------------------------------
NAME_MAX = 60
# The ONE table of stages, most complete first, `parked` always last. An issue carries exactly one `stage:<name>` label; the
# document sends this list as `stages` and the office band reads it from there.
STAGES = ("complete", "awaiting-uat", "ci-deploy", "review", "development", "design", "planning", "research", "idea", "parked")
STAGE_PREFIX = "stage:"
PREFIX_RE = re.compile(r"^\s*(?:\[[^\]]*\]\s*|[\w-]+(?:\([^)]*\))?!?:\s+)+")


def friendly_name(title, number):
    """`Friendly name (N-issue)`: the title without `role:` / `type(scope):` / `[tag]` prefixes, trimmed and capped, first letter up."""
    t = PREFIX_RE.sub("", title or "").strip() or (title or "").strip() or "Untitled"
    t = t[0].upper() + t[1:]
    if len(t) > NAME_MAX:    # cut at a word boundary so it still reads as a name
        t = t[:NAME_MAX - 1].rsplit(" ", 1)[0].rstrip(" ,;:-") + "…" if " " in t[:NAME_MAX - 1] else t[:NAME_MAX - 1] + "…"
    return f"{t} ({number}-issue)"


def stage_of(labels):
    """(stage, warning|None) from the `stage:<name>` labels: none = idea; several or an unknown one warn and the first in table order wins."""
    names = sorted({l[len(STAGE_PREFIX):] for l in labels if l.startswith(STAGE_PREFIX)})
    known = [n for n in STAGES if n in names]
    unknown = [n for n in names if n not in STAGES]
    warn = None
    if len(names) > 1:
        warn = f"{len(names)} stage labels: {', '.join(names)}"
    elif unknown:
        warn = f"unknown stage label: {unknown[0]}"
    return (known[0] if known else "idea"), warn


def owner_reason(open_decisions, room_state_, lead, last_own, pr, busy=False):
    """Why the owner is needed ('' = not): an unanswered DECISION or BLOCKED, a capped room, a PR waiting on the owner."""
    if open_decisions:
        return f"{open_decisions} decision{'s' if open_decisions != 1 else ''} to answer"
    if room_state_ == "needs_input" or (last_own == "BLOCKED" and not busy and lead != "busy"):
        return "blocked, needs input"
    if room_state_ == "capped":
        return "over its spend cap"
    if pr and pr.get("state") == "OPEN":
        if not pr.get("isDraft"):
            return "PR ready to merge"
        if room_state_ in ("done", "waiting"):
            return "draft PR to review"
    return ""


def task_sort_key(t):
    return (STAGES.index(t["stage"]), t["age_s"] if t["age_s"] is not None else 1 << 40)


def last_own_verb(comments):
    own = [classify(c.get("body")) for c in comments if classify(c.get("body")) not in (None,) + CONTROL_TYPES]
    return own[-1] if own else None


def age_of(comments, now, field="createdAt"):
    ts = [c.get(field) for c in comments if c.get(field)]
    return max(0, int((now - parse_ts(max(ts))).total_seconds())) if ts else None


def build_tasks(doc, issues, now):
    """The tracker rows: every open initiative issue (with or without a Room block); a closed one is simply gone. Role passes are not rows. Sorted by stage, most complete first, then most recently updated first."""
    rooms = {r["issue"]: r for r in doc["rooms"]}
    rows = []
    for iss in issues:
        n, comments = iss["number"], iss.get("comments", [])
        labels = [l["name"] if isinstance(l, dict) else l for l in iss.get("labels", [])]
        r = rooms.get(n) or {}
        stage, warn = stage_of(labels)
        why = owner_reason(len(open_decisions(comments, now)), r.get("state"), r.get("lead", {}).get("status"), last_own_verb(comments), r.get("pr"))
        rows.append({"number": n, "name": friendly_name(iss.get("title"), n), "url": iss.get("url", ""), "stage": stage, "stage_warning": warn,
                     "needs_you": bool(why), "reason": why, "worker": r.get("name"), "working": r.get("lead", {}).get("status") == "busy",
                     "age_s": age_of(comments, now)})
    return sorted(rows, key=task_sort_key)


def build(issues, agents, costs, status_text, now, role_doc=None, roles_error=None, role_issues=None, pass_issues=None,
          watching=watcher_alive, phases_of=load_phases, known_roles=()):
    by_name = {a.get("name"): a for a in agents}
    sl = status_lines(status_text)
    roles_known = set(role_issues or {}) | set(known_roles)
    caps = costs.get("caps", {"soft": 15.0, "hard": 40.0})
    rooms, decisions = [], []
    for iss in issues:
        room = parse_room(iss.get("body"))
        if not room:
            continue  # no Room block: no room, but a role pass's DECISIONs on it still reach the list (role_inbox)
        name = room["room"]
        labels = [l["name"] if isinstance(l, dict) else l for l in iss.get("labels", [])]
        comments = iss.get("comments", [])
        reports = [c for c in comments if classify(c.get("body"))]
        spend = costs.get("rooms", {}).get(name) or {"today": 0.0, "total": 0.0, "mix": {}}
        today = spend.get("today", 0.0)
        pend = split_decisions(comments, now, roles_known)[0]   # a role pass's DECISION is the pass's, not the room lead's
        status = lead_status(by_name.get(name))
        entry = {
            "name": name,
            "issue": iss["number"],
            "title": iss.get("title", ""),
            "url": iss.get("url", ""),
            "repo": room.get("repo", ""),
            "room": room,
            "latest": report(reports[-1], now) if reports else None,
            "lead": {"status": status, "agent": by_name.get(name)},
            "cost": {
                "today": today, "total": spend.get("total", 0.0), "mix": spend.get("mix", {}),
                "soft_pct": round(100 * today / caps["soft"], 1),
                "hard_pct": round(100 * today / caps["hard"], 1),
                "caps": caps,
            },
            "status_line": sl.get(iss["number"], ""),
            "capped": "capped" in labels,
            "open_decisions": len(pend),
            "state": room_state(status, "capped" in labels, comments),
            "flags": [f for c in flagged_answers(comments, now) for f in c["flags"]],
            "flagged": flagged_answers(comments, now),
            **room_team(room.get("team") or DEFAULT_TEAM, comments, watching(room.get("worktree", "")), phases_of),
        }
        rooms.append(entry)
        for d in pend:
            d.update({"room": name, "issue": iss["number"], "repo": room.get("repo", "")})
            decisions.append(d)
    roles = build_roles(role_doc)
    role_sessions, role_decisions = role_inbox(role_issues, agents, now, pass_issues, issues, known_roles)
    decisions += role_decisions
    doc = {
        "generated_at": now.isoformat(),
        "rooms": rooms,
        "decisions": decisions,
        "roles": roles,
        "role_sessions": role_sessions,
        "roles_error": roles_error,
        "workspace": workspace_doc(),
        "totals": {
            "rooms": len(rooms),
            "decisions": len(decisions),
            "today": round(sum(r["cost"]["today"] for r in rooms), 4),
            "roles": sum(1 for r in roles if r["enabled"]),
            "memory_reviews": sum(1 for r in roles if r["memory_pending"]),
        },
    }
    doc["stages"] = list(STAGES)
    doc["tasks"] = build_tasks(doc, issues, now)
    doc["totals"]["tasks"] = len(doc["tasks"])
    doc["totals"]["needs_you"] = sum(1 for t in doc["tasks"] if t["needs_you"])
    return doc


def load_roles():
    """(bin/role status --json document, None) or (None, why it failed). Never raises."""
    try:
        r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "role"), "status", "--json"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, f"bin/role did not run ({type(e).__name__})"
    if r.returncode != 0:
        why = next((l.strip() for l in r.stderr.splitlines() if l.strip()), f"exit {r.returncode}")
        return None, f"bin/role status failed: {why[:160]}"
    try:
        doc = json.loads(r.stdout)
        if not isinstance(doc, dict):
            raise ValueError("not an object")
        return doc, None
    except ValueError:
        return None, "bin/role status printed no JSON"


def live(now, fresh=False):
    agents = json.loads(run(["claude", "agents", "--json"]) or "[]")
    costs = json.loads(run([os.path.join(ENGINE_ROOT, "bin", "room-cost"), "--all", "--json"]) or "{}")
    status_text = run([os.path.join(ENGINE_ROOT, "bin", "status")])
    role_doc, roles_error = load_roles()
    # Every issue read goes through the minutes client: conditional REST calls into a shared cache, stale on failure.
    role_nums = {r["name"]: r["issue"] for r in (role_doc or {}).get("roles", []) if r.get("issue") and r.get("enabled")}
    pass_labels = sorted({"refine"} | {f"{name}-pass" for name in role_nums}) if role_nums else []
    mc = minutes.Minutes(REPO, CACHE_DIR)
    mc.sync(labels=["initiative"] + pass_labels, issues=list(role_nums.values()), force=fresh)
    issues = mc.issues("initiative")
    role_issues = {name: d for name, n in role_nums.items() for d in [mc.issue(n)] if d}
    pass_issues = []
    for label in pass_labels:
        pass_issues += mc.issues(label, ("number", "title", "labels", "url", "comments"))
    pass_issues = list({i["number"]: i for i in pass_issues}.values())
    doc = build(issues, agents, costs, status_text, now, role_doc, roles_error, role_issues, pass_issues, known_roles=roles_on_disk())
    attach_prs(doc)
    doc["tasks"] = build_tasks(doc, issues, now)   # again: a room's PR decides whether it needs the owner
    doc["totals"]["needs_you"] = sum(1 for t in doc["tasks"] if t["needs_you"])
    # Live room and role sessions, whatever their issue says: `--leftovers` lists the ones whose issue is no longer open
    # Whatever the state says, a session counts when its pid is alive (done and stopped sessions with live pids are the leftovers) and
    # its cwd is under this workspace's data root.
    root = data_root(WORKSPACE_ROOT)
    doc["live_sessions"] = [{"name": a.get("name"), "pid": a.get("pid"), "state": a.get("state"), "cwd": a.get("cwd"), "started_ms": a.get("startedAt")}
                            for a in agents if re.match(r"^(room|role)-", a.get("name") or "") and isinstance(a.get("pid"), int)
                            and sessions.alive(a["pid"]) and (a.get("cwd") or "") .startswith(root.rstrip("/") + "/")]
    # Additive: how fresh the GitHub reads behind this document are. No existing field changes.
    doc["minutes"] = {"stale": mc.stale, "age_s": mc.age()}
    # The hour's GraphQL use, estimated from the gh usage log when the logging shim is installed (no gh call): the band warns at 70%.
    import time
    points = ghusage.hour_graphql_points(CACHE_DIR, time.time())
    doc["gh_usage"] = {"hour_points_est": points, "limit": ghusage.LIMIT} if os.path.isdir(ghusage.log_dir(CACHE_DIR)) else None
    return doc


PR_BUDGET_S = 10   # total seconds of PR lookups per document build


def attach_prs(doc):
    """Each room's PR (`pr`, `pr_checked_at`), from the shared PR cache: at most one gh call per branch per ten minutes, and none for a
    repo with no GitHub remote. The band reads this instead of asking GitHub itself."""
    import time
    root = data_root(WORKSPACE_ROOT)
    deadline = time.time() + PR_BUDGET_S   # the build holds rooms.lock: past the budget, rooms are served from the cache, marked stale
    for r in doc["rooms"]:
        info = r.get("room") or {}
        repo, branch = info.get("repo"), info.get("branch")
        r["pr"], r["pr_checked_at"], r["pr_stale"] = None, None, False
        if not repo or not branch:
            continue
        repo_dir = root if OFFICE.is_workspace(repo) else os.path.join(root, repo)
        r["pr"], r["pr_checked_at"], r["pr_stale"] = prcache.lookup(repo_dir, OFFICE.github(repo), branch, CACHE_DIR, deadline=deadline)


def empty_document(why):
    """A valid document with no rooms, for when nothing can be built and nothing is cached."""
    doc = build([], [], {}, "", datetime.now(timezone.utc), None, why)
    doc["minutes"] = {"stale": True, "age_s": None, "error": why}
    return json.dumps(doc, indent=1)


CACHE_DIR = os.path.join(data_root(WORKSPACE_ROOT), ".cache")   # one cache per workspace, shared by its worktrees
DOC_TTL = 60


def cached_document(compute, cache_dir=None, now=None, ttl=DOC_TTL, wait=30, empty=None):
    """The `--json` document text, shared by every caller for `ttl` seconds: one computes (single-flight, flock), the rest read
    its result. When computing fails the last document is served instead; with none yet, `empty(why)` gives a valid empty one
    (a caller that passes no `empty` gets the exception)."""
    import fcntl, time
    now = now or time.time
    cache_dir = cache_dir or CACHE_DIR
    path = os.path.join(cache_dir, "rooms.json")

    def read():
        try:
            d = json.load(open(path))
            return d["at"], d["text"]
        except (OSError, ValueError, KeyError, TypeError):
            return None, None
    at, text = read()
    if at is not None and now() - at < ttl:
        return text
    os.makedirs(cache_dir, exist_ok=True)
    with open(os.path.join(cache_dir, "rooms.lock"), "w") as lk:
        deadline = time.time() + wait
        while True:
            try:
                fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() > deadline:
                    if text is not None:
                        return text
                    if empty:
                        return empty("another process is still building the first document")
                    raise
                time.sleep(0.2)
        at, text = read()   # the holder we waited for may have just written it
        if at is not None and now() - at < ttl:
            return text
        try:
            fresh = compute()
        except Exception as e:
            print(f"rooms: could not build the document ({type(e).__name__}: {str(e)[:150]}); serving the last one", file=sys.stderr)
            if text is None:
                if empty:
                    return empty(f"could not build the first document: {type(e).__name__}")
                raise
            return text
        tmp = path + f".{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump({"at": now(), "text": fresh}, f)
        os.replace(tmp, path)
        return fresh


