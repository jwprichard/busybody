#!/usr/bin/env bash
# busybody lead-start pre-push seatbelt
# From a room worktree (.claude/worktrees/room-*), rejects any pushed remote ref in PROTECTED. Not a security boundary.
# lead-start writes this repo's values in place of the two @...@ tokens when it installs the hook (the hook runs alone in the clone).
PROTECTED="@PROTECTED@"   # space-separated branch names from office.json noPush; main is always first
MERGE="@MERGE@"           # pr | land
[[ "$PROTECTED" == @* ]] && PROTECTED="main"   # an unsubstituted copy (still starting with @) protects main
# Stdin lines: <local ref> <local sha> <remote ref> <remote sha>. Chains to pre-push.chained if present.
input="$(cat)"
# Only rooms are held back: the user's and the controller's own checkouts push as normal
# (the workspace repo commits straight to main by design).
top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
case "$top" in
  */.claude/worktrees/room-*) is_room=1 ;;
  *) is_room=0 ;;
esac
# The lander (bin/land) writes <token> <sha> to $GIT_COMMON_DIR/busybody-land-grant, exports the token as BUSYBODY_LAND and removes the
# file when its push ends. A push is the lander's only if the environment token matches the file and the pushed commit is the one the
# lander verified. A bare BUSYBODY_LAND=1, a stale token or any other commit is refused.
land_granted() {
  local grant tok sha
  grant="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/busybody-land-grant"
  [[ -n "${BUSYBODY_LAND:-}" && -r "$grant" ]] || return 1
  read -r tok sha < "$grant" || true
  [[ -n "$tok" && "$tok" == "$BUSYBODY_LAND" && -n "$sha" && "$sha" == "$1" ]]
}
while read -r _lref _lsha rref _rsha; do
  b="${rref#refs/heads/}"; [[ "$rref" == "refs/heads/$b" ]] || continue
  for p in $PROTECTED; do
    [[ "$b" == "$p" ]] || continue
    [[ $is_room == 1 ]] || continue
    # a repo that lands (merge "land": no PRs) lets the lander push main: only that commit, only while its one-shot grant exists
    [[ "$MERGE" == land && "$b" == main ]] && land_granted "$_lsha" && continue
    echo "pre-push seatbelt: refusing to push to $b (rooms never push: $PROTECTED)" >&2
    exit 1
  done
done <<<"$input"
chained="$(dirname "$0")/pre-push.chained"
if [[ -x "$chained" ]]; then
  printf '%s\n' "$input" | "$chained" "$@"
  exit $?
fi
exit 0
