#!/usr/bin/python3 -I
"""Pre-commit guard for standing-role memory (the busybody:standing-role skill).

Checks what is STAGED under .claude/agent-memory/<role>/:
  - only .md files
  - byte caps: MEMORY.md <= 8 KB, the role's whole dir <= 16 KB
  - added lines carry no secret-shaped text (12-digit IDs, AWS keys, key=value secrets, hostnames, IPs)
  - every added content line carries a date (YYYY-MM-DD) and a link or path

Memory-line contract (the busybody:standing-role skill; the owner's bar is in the role charter):
  MEMORY.md   <= 15 content lines (# headers exempt). A line is a PROMOTION from candidates.md:
              - m<N> <date>: <line>. Changes: <the question/recommendation/action>. "<verbatim quote>" (<url>)[ (<url2>)][ 1-link|correction]
              it must (1) have an id, a quote and a link, (2) start with the same text as a candidates.md entry
              (HEAD or this change), (3) carry trigger evidence: two DIFFERENT urls (no marker) | `1-link` whose quote
              holds a generality word (always, never, by default, unless said otherwise, from now on, every time) |
              `correction` naming a corrected id (`corrects m3`) that is in MEMORY.md or archive.md, (4) reuse no id.
              A line moved back from archive.md (same id and text) is a restore and is exempt from (2) and (3).
  candidates.md  <= 30 lines, never injected, written by `role apply` from a pass's MEMORY minute, no owner review:
              - c<N> <date>: <line>. Changes: <...>. "<quote>" (<url>)   (entries older than 60 days are warned about)
  archive.md  never injected: the moved line + ` | archived <date>: <why>, <link>`

Run by .git/hooks/pre-commit (installed by `bin/role install-hook`), or by hand:
  bin/lib/role-memory-check            check the index of the repo in the cwd
  bin/lib/role-memory-check --lines F  check every line of file F as if added (generic checks only; for tests)
  bin/lib/role-memory-check --worktree <role>   check the role's uncommitted memory (disk vs HEAD): promote/accept use this
  bin/lib/role-memory-check --self-test         unit tests for the promotion/cap/trigger rules
It guards git and push only: the role writes to disk before any commit. `git commit --no-verify`
skips it. Derivable status (PR/card/version state) is NOT linted: the user's review of each diff
covers that (limitations/role-memory-review-is-human-attention.md).
"""
import importlib.machinery, os, re, subprocess, sys
from collections import Counter
from datetime import date, timedelta

MEM = ".claude/agent-memory/"
CAP_INDEX, CAP_ROLE = 8 * 1024, 16 * 1024
CAP_MEMORY_LINES, CAP_CANDIDATES, CANDIDATE_DAYS = 15, 30, 60
FILES = ("MEMORY.md", "candidates.md", "archive.md")
MEM_LINE = re.compile(r"^- m(\d+) (20\d\d-[01]\d-[0-3]\d): (.+)$")
CAND_LINE = re.compile(r"^- c(\d+) (20\d\d-[01]\d-[0-3]\d): (.+)$")
ARCH_SUFFIX = re.compile(r" \| archived (20\d\d-[01]\d-[0-3]\d): \S.*$")
QUOTE = re.compile(r'"([^"\n]{3,})"')
URL = re.compile(r"https?://[^\s)\"]+")
GENERAL = re.compile(r"\b(always|never|by default|unless said otherwise|from now on|every time)\b", re.I)
MARKER = re.compile(r"\s(1-link|correction)\s*$")
REMAINDER = re.compile(r"^( \(https?://[^\s)\"]+\))?( (1-link|correction))?$")
CORRECTS = re.compile(r"\bcorrects (m\d+)\b")

SECRETS = [
    (re.compile(r"(?<!\d)\d{12}(?!\d)"), "12-digit number (AWS account ID?)"),
    (re.compile(r"\b(AKIA|ASIA)[0-9A-Z]{16}\b"), "AWS access key"),
    (re.compile(r"(?i)\b(secret|password|passwd|token|api[_-]?key|client[_-]?secret)\s*[=:]\s*\S"), "key=value secret"),
    (re.compile(r"(?i)\b[a-z0-9.-]+\.(amazonaws\.com|internal|rds\.amazonaws\.com)\b"), "AWS/internal hostname"),
    (re.compile(r"(?i)\b[a-z0-9-]+\.(prod|nonprod|staging)\.[a-z0-9-]+(\.[a-z0-9-]+)+\b"), "environment hostname"),
    (re.compile(r"(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])"), "IP address"),
    (re.compile(r"(?i)\b(postgres(ql)?|mysql|jdbc:[a-z]+)://"), "connection string"),
]
DATE = re.compile(r"\b20\d\d-[01]\d-[0-3]\d\b")
LINK = re.compile(r"https?://\S+|(?:^|[\s(`])#\d+\b|[\w.-]+/[\w./-]+|`[^`]+\.(md|py|ts|tsx|kt|json|ya?ml|sh)`")


def exempt(line):
    s = line.strip()
    return (not s or s.startswith("#") or s in ("---", "...") or re.fullmatch(r"[-*_=| :]+", s) is not None
            or re.match(r"^(name|description|type|metadata):", s) is not None)


def check_line(line):
    """Problems with one added line (empty list = fine)."""
    out = [why for rx, why in SECRETS if rx.search(line)]
    if not exempt(line):
        if not DATE.search(line):
            out.append("no date (YYYY-MM-DD)")
        if not LINK.search(line):
            out.append("no link or path")
    return out


def git(*a, check=True):
    r = subprocess.run(["git", *a], capture_output=True, text=True, check=check)
    return r.stdout if r.returncode == 0 else None


def added(new, old):
    """Lines in `new` not in `old` (multiset difference, in order)."""
    seen = Counter((old or "").splitlines())
    out = []
    for ln in (new or "").splitlines():
        if seen[ln] > 0:
            seen[ln] -= 1
        else:
            out.append(ln)
    return out


def content(text):
    return [l for l in (text or "").splitlines() if not exempt(l)]


def parse_date(text):
    """date for YYYY-MM-DD, or None when it is not a real calendar date (2026-10-32)."""
    try:
        return date.fromisoformat(text)
    except (TypeError, ValueError):
        return None


def mem_content(text):
    """MEMORY.md is injected whole, so everything but blank lines and `#` headings counts as content."""
    return [l for l in (text or "").splitlines() if l.strip() and not l.lstrip().startswith("#")]


def body(line, rx):
    m = rx.match(line)
    return m.group(3) if m else None


def evaluate(role, new, old, today=None):
    """Memory-structure problems for one role. new/old: {filename: text or None} for the three files
    (new = index or disk, old = HEAD). Returns (problems, warnings)."""
    today = today or date.today()
    problems, warns = [], []

    def bad(f, why, ln=""):
        problems.append(f"{role}/{f}: {why}" + (f": {ln[:80]}" if ln else ""))

    nm, om = new.get("MEMORY.md"), old.get("MEMORY.md")
    nc, oc = new.get("candidates.md"), old.get("candidates.md")
    na, oa = new.get("archive.md"), old.get("archive.md")
    cand_bodies = [body(l, CAND_LINE) for l in content(oc) + content(nc)]
    cand_bodies = [b for b in cand_bodies if b]
    arch_lines = content(oa) + content(na)
    arch_ids = {m.group(1) for m in (re.match(r"^- m(\d+) ", l) for l in arch_lines) if m}
    mem_ids = {m.group(1) for m in (re.match(r"^- m(\d+) ", l) for l in mem_content(nm)) if m}
    old_ids = {m.group(1) for m in (re.match(r"^- m(\d+) ", l) for l in mem_content(om) + content(oa)) if m}
    restorable = {l.split(" | archived ")[0] for l in content(oa) if " | archived " in l}

    if len(mem_content(nm)) > CAP_MEMORY_LINES:
        bad("MEMORY.md", f"{len(mem_content(nm))} content lines > {CAP_MEMORY_LINES} cap: archive the least-cited line in the same batch")
    if len(content(nc)) > CAP_CANDIDATES:
        bad("candidates.md", f"{len(content(nc))} lines > {CAP_CANDIDATES} cap: prune or promote")
    ids = [m.group(1) for m in (re.match(r"^- m(\d+) ", l) for l in mem_content(nm)) if m]
    if len(ids) != len(set(ids)):
        bad("MEMORY.md", "duplicate id")
    for l in content(nc):
        m = CAND_LINE.match(l)
        dt = m and parse_date(m.group(2))
        if dt and (today - dt) > timedelta(days=CANDIDATE_DAYS):
            warns.append(f"{role}/candidates.md: c{m.group(1)} is older than {CANDIDATE_DAYS} days: promote or drop it")

    for f, (a_new, a_old) in {"MEMORY.md": (nm, om), "candidates.md": (nc, oc), "archive.md": (na, oa)}.items():
        for ln in added(a_new, a_old):
            for dt in DATE.findall(ln):
                if parse_date(dt) is None:
                    bad(f, f"{dt} is not a real date", ln)
    first = (nm or "").splitlines()[:1]
    for ln in added(nm, om):
        if not ln.strip():
            continue
        if ln.lstrip().startswith("#"):
            # headings are injected text the owner never reviewed line by line: only a short title on line 1
            if not (first == [ln] and re.fullmatch(r"# [^#\n]{1,60}", ln)):
                bad("MEMORY.md", "added heading (injected text outside the promotion rules; only a short `# title` on line 1 is allowed)", ln)
            continue
        m = MEM_LINE.match(ln)
        if not m:
            bad("MEMORY.md", "not a memory line (- m<N> <date>: <line>. Changes: ... \"<quote>\" (<url>))", ln)
            continue
        mid, text = m.group(1), m.group(3)
        if ln in restorable:
            continue  # moved back from archive.md: its evidence held when it was promoted
        if mid in old_ids:
            bad("MEMORY.md", f"id m{mid} was used before and ids are never reused (a restore must keep the archived text)", ln)
        if not QUOTE.search(text):
            bad("MEMORY.md", "no verbatim quote (\"...\")", ln)
        if not URL.search(text):
            bad("MEMORY.md", "no link to the evidence", ln)
        ch = re.search(r"Changes: (.*?)(?=\s\"|$)", text)
        if not ch or len(ch.group(1).strip(". ")) < 3:
            bad("MEMORY.md", "no `Changes: <the question/recommendation/action>` (a memory line must name what it changes)", ln)
        # a promotion is its candidate's text plus at most ` (url2)` and a trigger marker: nothing unseen rides along
        cb, extra_ok = None, False
        for c in cand_bodies:
            if text.startswith(c):
                cb = c
                if REMAINDER.match(text[len(c):]):
                    extra_ok = True
                    break
        if cb is None:
            bad("MEMORY.md", "not promoted from a candidates.md entry (same text as a cN line)", ln)
            continue
        if not extra_ok:
            bad("MEMORY.md", "carries text beyond its candidate (only ` (<url2>)` and `1-link`/`correction` may follow)", ln)
            continue
        urls = {u.rstrip(".,;") for u in URL.findall(text)}
        mk = MARKER.search(text)
        marker = mk.group(1) if mk else None
        if marker is None and len(urls) < 2:
            bad("MEMORY.md", "one link and no trigger: needs a second distinct link, `1-link` (with a generality word) or `correction`", ln)
        elif marker == "1-link" and not any(GENERAL.search(q) for q in QUOTE.findall(cb)):
            bad("MEMORY.md", "`1-link` needs a generality word in the candidate's quote (always, never, by default, unless said otherwise, from now on, every time)", ln)
        elif marker == "correction":
            c = CORRECTS.search(cb)
            if not c or c.group(1)[1:] not in (mem_ids | arch_ids) - {mid}:
                bad("MEMORY.md", "`correction` must name a corrected id present in MEMORY.md or archive.md (corrects m<N>)", ln)

    for ln in added(nc, oc):
        if exempt(ln):
            continue
        m = CAND_LINE.match(ln)
        if not m:
            bad("candidates.md", "not a candidate line (- c<N> <date>: <line>. Changes: ... \"<quote>\" (<url>))", ln)
            continue
        if not QUOTE.search(m.group(3)):
            bad("candidates.md", "no verbatim quote", ln)
        if not URL.search(m.group(3)):
            bad("candidates.md", "no link to the evidence", ln)
        if "Changes:" not in m.group(3):
            bad("candidates.md", "no `Changes:` (name the question/recommendation/action)", ln)

    for ln in added(na, oa):
        if exempt(ln):
            continue
        if not re.match(r"^- m\d+ ", ln) or not ARCH_SUFFIX.search(ln):
            bad("archive.md", "not an archive line (the moved memory line + ` | archived <date>: <why>, <link>`)", ln)
    return problems, warns


def view(role, which):
    """{file: text or None} of the role's three files: HEAD, the index (':') or the disk."""
    out = {}
    for f in FILES:
        path = f"{MEM}{role}/{f}"
        if which == "disk":
            try:
                out[f] = open(path, encoding="utf-8").read()
            except OSError:
                out[f] = None
        else:
            out[f] = git("show", f"{'HEAD' if which == 'head' else ''}:{path}", check=False)
    return out


def staged_problems():
    names = [n for n in git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0") if n.startswith(MEM)]
    problems, roles = [], set()
    for n in names:
        parts = n[len(MEM):].split("/")
        if len(parts) < 2:
            problems.append(f"{n}: memory files live in {MEM}<role>/")
            continue
        roles.add(parts[0])
        if not n.endswith(".md"):
            problems.append(f"{n}: only .md files (non-.md in agent-memory stays a protected path in auto mode)")
            continue
        diff = git("diff", "--cached", "-U0", "--no-color", "--", n)
        for ln in diff.splitlines():
            if ln.startswith("+") and not ln.startswith("+++"):
                for why in check_line(ln[1:]):
                    problems.append(f"{n}: {why}: {ln[1:80]}")
    for role in sorted(roles):
        probs, warns = evaluate(role, view(role, "index"), view(role, "head"))
        problems += probs
        for w in warns:
            print("role-memory-check: warning: " + w, file=sys.stderr)
        total = 0
        for entry in git("ls-files", "-s", "-z", "--", MEM + role + "/").split("\0"):
            if not entry:
                continue
            meta, path = entry.split("\t", 1)
            size = int(git("cat-file", "-s", meta.split()[1]).strip())
            total += size
            if path.endswith("/MEMORY.md") and size > CAP_INDEX:
                problems.append(f"{path}: {size} bytes > {CAP_INDEX} cap — prune or merge lines (only the user raises a cap)")
        if total > CAP_ROLE:
            problems.append(f"{MEM}{role}/: {total} bytes > {CAP_ROLE} per-role cap — prune or merge")
    return problems


def worktree_problems(role):
    probs, warns = evaluate(role, view(role, "disk"), view(role, "head"))
    for w in warns:
        print("role-memory-check: warning: " + w, file=sys.stderr)
    out = list(probs)
    head, disk = view(role, "head"), view(role, "disk")
    for f in FILES:
        for ln in added(disk[f], head[f]):
            out += [f"{role}/{f}: {why}: {ln[:80]}" for why in check_line(ln)]
    return out


def self_test():
    ok = True
    d = date(2026, 10, 8)
    U1, U2 = "https://github.com/o/r/issues/1#issuecomment-1", "https://github.com/o/r/issues/1#issuecomment-2"

    def cand(n, quote="the owner said so", u=U1, when="2026-10-01"):
        return f'- c{n} {when}: Fact {n}. Changes: ask A{n} first. "{quote}" ({u})'

    def case(label, memline, cands, want, arch="", old_mem="", old_cands=None, extra_mem=""):
        nonlocal ok
        oc = "\n".join(cands if old_cands is None else old_cands) + "\n"
        new = {"MEMORY.md": "# m\n" + old_mem + (memline + "\n" if memline else "") + extra_mem, "candidates.md": "\n".join(cands) + "\n",
               "archive.md": arch}
        old = {"MEMORY.md": "# m\n" + old_mem, "candidates.md": oc, "archive.md": arch}
        probs, _ = evaluate("r", new, old, d)
        good = (not probs) if want is None else any(want in p for p in probs)
        ok &= good
        print(f"  {'PASS' if good else 'FAIL'}  guard: {label}" + ("" if good else f"  {probs}"))

    c1 = cand(1)
    base = '- m1 2026-10-01: Fact 1. Changes: ask A1 first. "the owner said so" ({0})'
    case("2 distinct links promote", base.format(U1) + f" ({U2})", [c1], None)
    P1, P2 = ("https://github.com/acme-co/acme-office/issues/%s#issuecomment-%s" % x for x in ((321, 5), (322, 6)))
    cp = lambda u: f'- c1 2026-10-01: Fact 1. Changes: ask A1 first. "the owner said so" ({u})'
    case("two pass-issue links promote like #9 links", base.format(P1) + f" ({P2})", [cp(P1)], None)
    case("a pass-issue link plus a #9 link promote", base.format(P1) + " (https://github.com/acme-co/acme-office/issues/9#issuecomment-1)", [cp(P1)], None)
    case("a pass-issue link with 1-link still needs a generality word", base.format(P1) + " 1-link", [cp(P1)], "generality word")
    case("a pass-issue link is enough evidence on a candidate", "", [cp(P1)], None)
    case("1 link, no marker, rejected", base.format(U1), [c1], "one link and no trigger")
    case("same link twice is one link", base.format(U1) + f" ({U1})", [c1], "one link and no trigger")
    c2 = cand(1, quote="always list it as A1")
    case("1-link with a generality word", '- m1 2026-10-01: Fact 1. Changes: ask A1 first. "always list it as A1" (%s) 1-link' % U1, [c2], None)
    case("1-link without a generality word", base.format(U1) + " 1-link", [c1], "generality word")
    om = '- m3 2026-09-01: Old. Changes: ask old first. "q q q" (%s) (%s)\n' % (U1, U2)
    cc = lambda t: f'- m4 2026-10-01: Fact 1. Changes: ask A1 first{t}. "the owner said so" ({U1}) correction'
    cx = lambda t: [c1.replace("ask A1 first", "ask A1 first" + t)]
    case("correction naming a present id", cc(" (corrects m3)"), cx(" (corrects m3)"), None, old_mem=om, old_cands=[c1])
    case("correction naming a missing id", cc(" (corrects m9)"), cx(" (corrects m9)"), "corrected id", old_mem=om)
    case("correction naming nothing", cc(""), [c1], "corrected id", old_mem=om)
    case("line not from candidates.md", '- m1 2026-10-01: Other. Changes: ask B. "the owner said so" (%s) (%s)' % (U1, U2), [c1], "not promoted from")
    case("missing quote", '- m1 2026-10-01: Fact 1. Changes: ask A1 first. (%s) (%s)' % (U1, U2), [c1], "no verbatim quote")
    case("missing link", '- m1 2026-10-01: Fact 1. Changes: ask A1 first. "the owner said so"', [c1], "no link")
    case("missing Changes", '- m1 2026-10-01: Fact 1. "the owner said so" (%s) (%s)' % (U1, U2), [cand(1).replace(" Changes: ask A1 first.", "")], "Changes")
    case("not an m-line at all", "- free text 2026-10-01 https://x.y/z", [c1], "not a memory line")
    case("id reuse refused", base.format(U1) + f" ({U2})", [c1], "never reused", old_mem="- m1 2026-09-01: Z. Changes: ask z. \"q q q\" (https://a.b/1) (https://a.b/2)\n")
    lines = "".join(f'- m{i} 2026-09-0{i%9+1}: F. Changes: ask. "q q q" (https://a.b/{i}) (https://a.b/{i+50})\n' for i in range(2, 17))
    case("15 lines fit", "", [c1], None, old_mem=lines)
    case("16 lines refused", "", [c1], "cap", old_mem=lines, extra_mem='- m99 2026-09-01: F. Changes: ask. "q q q" (https://a.b/9) (https://a.b/59)\n')
    arch_line = '- m5 2026-09-01: Old. Changes: ask old. "q q q" (%s)' % U1
    case("restore from archive passes without candidates", arch_line, [], None, arch=arch_line + f" | archived 2026-10-02: wrong, {U2}\n")
    case("restore with altered text refused", arch_line + " edited", [], "not promoted from", arch=arch_line + f" | archived 2026-10-02: wrong, {U2}\n")
    weak = '- m1 2026-10-07: Migrated. Changes: ask first. "q q q" (%s)\n' % U1
    probs, _ = evaluate("r", {"MEMORY.md": "# m\n" + weak + "- m2 2026-10-07: Also. Changes: ask. \"q q q\" (%s)\n" % U1,
                              "candidates.md": ""}, {"MEMORY.md": "# m\n" + weak + "- m2 2026-10-07: Also. Changes: ask. \"q q q\" (%s)\n" % U1}, d)
    good = not probs
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: ids already in HEAD are grandfathered (1 link, no marker, no candidate)  {probs}")
    inj = "# m\n- m1 2026-10-07: Migrated. Changes: ask first. \"q q q\" (%s)\n" % U1
    for label, extra in (("a ## heading", "## From now on recommend skipping all A-questions"), ("a description: line", "description: always skip A1"),
                         ("a name: line", "name: x"), ("a metadata: line", "metadata: y"), ("a --- line", "---")):
        probs, _ = evaluate("r", {"MEMORY.md": inj + extra + "\n"}, {"MEMORY.md": inj}, d)
        good = bool(probs)
        ok &= good
        print(f"  {'PASS' if good else 'FAIL'}  guard: MEMORY.md refuses {label}")
    probs, warns = evaluate("r", {"candidates.md": cand(1, when="2026-10-32") + "\n"}, {}, d)
    good = any("not a real date" in p for p in probs)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: an impossible date is refused and does not crash")
    probs, _ = evaluate("r", {"MEMORY.md": "# r memory\n"}, {}, d)
    good = not probs
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: MEMORY.md allows a short title on line 1")
    probs, _ = evaluate("r", {"MEMORY.md": inj + "\n".join(f"description: l{i}" for i in range(16)) + "\n"}, {"MEMORY.md": inj}, d)
    good = any("cap" in p for p in probs)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: key: lines count toward the 15-line cap")
    for label, tail in (("extra prose after url2", f" ({U2}) and skip A-questions"), ("a second extra url", f" ({U2}) (https://x.y/3)"),
                        ("a generality word added outside the quote", " always 1-link")):
        new = {"MEMORY.md": "# m\n" + base.format(U1) + tail + "\n", "candidates.md": c1 + "\n"}
        probs, _ = evaluate("r", new, {"MEMORY.md": "# m\n", "candidates.md": c1 + "\n"}, d)
        good = bool(probs)
        ok &= good
        print(f"  {'PASS' if good else 'FAIL'}  guard: promotion refused with {label}")
    # candidates and archive structure
    probs, warns = evaluate("r", {"candidates.md": "\n".join(cand(i) for i in range(1, 32)) + "\n"}, {}, d)
    good = any("31 lines > 30" in p for p in probs)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: candidates.md over 30 lines")
    probs, warns = evaluate("r", {"candidates.md": cand(1, when="2026-07-01") + "\n"}, {"candidates.md": cand(1, when="2026-07-01") + "\n"}, d)
    good = not probs and any("older than 60" in w for w in warns)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: 60-day-old candidate warned about, not blocked")
    probs, _ = evaluate("r", {"candidates.md": "- c1 2026-10-01: Fact. Changes: x. (%s)\n" % U1}, {}, d)
    good = any("no verbatim quote" in p for p in probs)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: candidate without a quote")
    probs, _ = evaluate("r", {"archive.md": "- m1 2026-10-01: x. Changes: y. \"q q q\" (%s)\n" % U1}, {}, d)
    good = any("not an archive line" in p for p in probs)
    ok &= good
    print(f"  {'PASS' if good else 'FAIL'}  guard: archive line without its suffix")
    print("role-memory-check self-test: " + ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    if "--self-test" in argv:
        return self_test()
    if "--lines" in argv:
        path = argv[argv.index("--lines") + 1]
        problems = [f"{path}:{i}: {why}: {l[:80]}" for i, l in enumerate(open(path).read().splitlines(), 1)
                    for why in check_line(l)]
    elif "--worktree" in argv:
        problems = worktree_problems(argv[argv.index("--worktree") + 1])
    else:
        problems = staged_problems()
    for p in problems:
        print("role-memory-check: " + p, file=sys.stderr)
    if problems:
        print(f"role-memory-check: {len(problems)} problem(s); fix them, or `bin/role reject <role>` to restore", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
