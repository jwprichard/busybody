#!/usr/bin/python3 -I
"""Desks as named agent types: generate the `desks` plugin from the workspace's team recipes.

  bin/kit build [--out DIR]   write DIR (default <workspace>/desks): .claude-plugin/plugin.json and agents/<team>-<desk>.md for every
                              desk of every project-room recipe in teams/*/team.json (recipes with no desks are skipped).
                              A desk's model is the recipe's. A readOnly desk gets `disallowedTools: Edit, Write, NotebookEdit`:
                              that is "no edit tools", not read-only (Bash stays), so the room deny rules remain the real fence.
                              The body is templates/desk.md. Output is deterministic; commit it so every desk change is a diff.
  bin/kit check [--dir DIR]   regenerate in memory and fail (exit 1) if DIR (default <workspace>/desks) differs, is missing a file,
                              has a stale agent, or holds any file other than plugin.json and agents/*.md
  bin/kit shape [DIR]         only the layout rule: DIR holds nothing but .claude-plugin/plugin.json and agents/*.md (lead-start runs this)
  bin/kit --self-test         build fixture recipes in a scratch workspace and check model, tools, names and drift

The agent types are named `desks:<team>-<desk>` once the plugin is loaded with `claude --plugin-dir <workspace>/desks`
(`bin/lead-start` adds the flag when desks/ exists). A plugin dir that grew hooks/ or .mcp.json would run outside the deny rules.
"""
import importlib.machinery, importlib.util, json, os, shutil, subprocess, sys, tempfile

ENGINE_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ENGINE_ROOT, "bin", "lib"))
from officeroot import selftest_reexec  # noqa: E402
selftest_reexec(ENGINE_ROOT)
import kitlib  # noqa: E402
import deskskills  # noqa: E402
import officeconfig  # noqa: E402

TEMPLATE = os.path.join(ENGINE_ROOT, "templates", "desk.md")


def die(msg, code=1):
    sys.stderr.write(f"kit: {msg}\n")
    sys.exit(code)


def load_team():
    """bin/team as a module (it owns the recipe loader and validator)."""
    path = os.path.join(ENGINE_ROOT, "bin", "team")
    loader = importlib.machinery.SourceFileLoader("busybody_team", path)
    spec = importlib.util.spec_from_loader("busybody_team", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def recipes(team, root):
    """Valid recipes of the workspace at root; stops with the problems if any recipe is invalid."""
    out, bad = [], []
    for n in team.recipe_names(root):
        errs, t = team.validate(root, n)
        if errs:
            bad.append(f"recipe {n} is invalid: " + "; ".join(errs))
        else:
            out.append(t)
    if bad:
        die("; ".join(bad))
    return out


def rendered(team, root, lenient=False):
    """(files, skipped). A refused skill stops the command with one line before anything is written."""
    try:
        return deskskills.render_desks(recipes(team, root), open(TEMPLATE).read(), officeconfig.load(root, {}), lenient)
    except deskskills.SkillError as e:
        die(str(e))


def build(team, root, out):
    files, _ = rendered(team, root)
    for sub in ("agents", ".claude-plugin"):   # only what kit owns is cleared; anything else is left for `check` to flag
        shutil.rmtree(os.path.join(out, sub), ignore_errors=True)
    for rel, text in files.items():
        p = os.path.join(out, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w").write(text)
    n = sum(1 for r in files if r.startswith("agents/"))
    print(f"kit build: {n} desk agent(s) written to {out}")
    return 0


def check(team, root, d):
    if not os.path.isdir(d):
        print(f"kit check: {d} does not exist (run `busybody kit build`)")
        return 1
    files, skipped = rendered(team, root, lenient=True)
    problems = kitlib.drift(d, files, skipped)
    for p in problems:
        print(f"kit check: {p}")
    if problems:
        print("kit check: desks/ is out of date; run `busybody kit build` and commit the result")
        return 1
    for rel in skipped:
        print(f"kit check: warning: {rel} not compared: a source clone it needs is absent")
    print(f"kit check: ok ({d})" + (f", {len(skipped)} skill-dependent agent(s) not compared" if skipped else ""))
    return 0


def shape(d):
    if not os.path.isdir(d):
        die(f"{d} does not exist")
    bad = kitlib.shape_problems(d)
    if bad:
        print(f"kit: {d} must hold only .claude-plugin/plugin.json and agents/*.md, found: " + ", ".join(bad), file=sys.stderr)
        return 1
    return 0


def lead_start_cases(bad):
    """bin/lead-start with a desks/ plugin: the flag, the brief, the deny lines and the pre-launch checks. Stub gh and claude on PATH,
    a scratch workspace (a git repo) and a scratch HOME that trusts the child repo; nothing real is launched."""
    if not all(shutil.which(c) for c in ("jq", "git", "bash")):
        print("kit self-test: NOTE: jq, git or bash missing, skipping the lead-start cases")
        return
    tmp = os.path.realpath(tempfile.mkdtemp())
    try:
        ws, home, stubs, rec = (os.path.join(tmp, x) for x in ("ws", "home", "stubs", "claude.argv"))
        for d in (ws, home, stubs):
            os.makedirs(d)
        genv = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t",
                    GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_SYSTEM="/dev/null")

        def git(cwd, *a):
            subprocess.run(["git", "-C", cwd] + list(a), check=True, capture_output=True, env=genv)

        shutil.copy(os.path.join(ENGINE_ROOT, "fixtures", "office.json"), os.path.join(ws, "office.json"))
        shutil.copytree(os.path.join(ENGINE_ROOT, "templates", "teams", "dev-team"), os.path.join(ws, "teams", "dev-team"))
        open(os.path.join(ws, ".gitignore"), "w").write("acme-web/\n")
        child = os.path.join(ws, "acme-web")
        os.makedirs(child)
        git(child, "init", "-q", "-b", "main")
        git(child, "commit", "-q", "--allow-empty", "-m", "base")
        git(ws, "init", "-q", "-b", "main")
        json.dump({"projects": {child: {"hasTrustDialogAccepted": True}}}, open(os.path.join(home, ".claude.json"), "w"))
        for name, text in (("gh", 'case "$1 $2" in\n"issue view") echo Goal ;;\n"api repos"*) ;;\nesac\n'
                                  'if [ "$1" = api ]; then echo \'[{"body":"PROGRESS: lead online"}]\'; fi\n'),
                           ("claude", f'printf "%s\\0" "$@" > {rec}\n')):
            open(os.path.join(stubs, name), "w").write("#!/bin/sh\n" + text)
            os.chmod(os.path.join(stubs, name), 0o755)
        env = dict(genv, HOME=home, PATH=stubs + os.pathsep + os.environ["PATH"], BUSYBODY_WORKSPACE=ws,
                   BUSYBODY_CONFIG=os.path.join(ws, "office.json"))
        env.pop("BUSYBODY_CONTROLLER", None)

        def lead(*a):
            r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "lead-start"), "acme-web", "slug-a", "--controller", "ctl", "--issue", "5",
                                "--team", "dev-team"] + list(a), env=env, capture_output=True, text=True, cwd=tmp)
            return r.returncode, r.stdout, r.stderr

        desks = os.path.join(ws, "desks")
        rc, o, e = lead("--dry-run")
        if not (rc == 0 and "desks:     none" in o and "--plugin-dir" not in o and "subagent_type" not in o):
            bad.append(f"lead-start --dry-run with no desks/ is unchanged: {rc} {o} {e}")
        subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "build"], env=env, check=True, capture_output=True)
        git(ws, "add", "-A")
        git(ws, "commit", "-q", "-m", "desks")
        rc, o, e = lead("--dry-run")
        if not (rc == 0 and f"--plugin-dir {desks} --settings" in o and 'subagent_type: "desks:dev-team-implementer"' in o
                and 'subagent_type: "desks:dev-team-reviewer"' in o):
            bad.append(f"lead-start --dry-run shows the flag and the agent types: {rc} {o} {e}")
        agent = os.path.join(desks, "agents", "dev-team-implementer.md")
        good = open(agent).read()
        open(agent, "w").write(good + "x\n")
        rc, o, e = lead("--dry-run")
        if not (rc != 0 and "uncommitted changes" in e):
            bad.append(f"an uncommitted change in desks/ must stop the launch: {rc} {e}")
        open(agent, "w").write(good)
        os.makedirs(os.path.join(desks, "hooks"))
        open(os.path.join(desks, "hooks", "hooks.json"), "w").write("{}\n")
        git(ws, "add", "-A")
        git(ws, "commit", "-q", "-m", "hooks")
        rc, o, e = lead("--dry-run")
        if not (rc != 0 and "hooks/hooks.json" in e):
            bad.append(f"a hooks/ dir in desks/ must stop the launch even when committed: {rc} {e}")
        git(ws, "rm", "-q", "-r", "desks/hooks")
        git(ws, "commit", "-q", "-m", "no hooks")
        rc, o, e = lead()   # the real launch, with the stubs: settings, brief and the claude command line
        if rc != 0:
            bad.append(f"lead-start with desks/ failed: {rc} {o} {e}")
        else:
            argv = open(rec).read().split("\0")[:-1]
            i = argv.index("--plugin-dir") if "--plugin-dir" in argv else -1
            if not (i > 0 and argv[i + 1] == desks and i < argv.index("--settings") and argv[:1] == ["--bg"]):
                bad.append(f"claude --bg gets --plugin-dir <ws>/desks: {argv[:12]}")
            if 'subagent_type: "desks:dev-team-implementer"' not in argv[-1]:
                bad.append("the brief names the desk agent types")
            st = json.load(open(os.path.join(child, ".claude", "worktrees", "room-slug-a", ".claude", "room-settings.json")))
            deny = st["permissions"]["deny"]
            if not (f"Edit(/{desks}/**)" in deny and f"Write(/{desks}/**)" in deny):
                bad.append("the room settings deny Edit and Write on desks/")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def skills_cases(bad):
    """Skills from a pinned source: a scratch source repo (real git), a scratch workspace whose office.json pins it, a recipe using it."""
    if not shutil.which("git"):
        print("kit self-test: NOTE: git missing, skipping the skills cases")
        return
    tmp = os.path.realpath(tempfile.mkdtemp())
    try:
        genv = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t",
                    GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_SYSTEM="/dev/null")

        def git(cwd, *a):
            return subprocess.run(["git", "-C", cwd] + list(a), check=True, capture_output=True, text=True, env=genv).stdout.strip()

        ws = os.path.join(tmp, "ws")
        src = os.path.join(ws, "sources", "kit")
        sk = os.path.join(src, "skills")

        def wr(rel, text):
            p = os.path.join(src, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w").write(text)

        os.makedirs(src)
        git(src, "init", "-q", "-b", "main")
        wr("skills/alpha/SKILL.md", "---\nname: alpha\ndescription: the alpha skill\nlicense: MIT\n---\n# Alpha\n\nAlpha body line.\n")
        wr("skills/alpha/references/x.md", "Reference X text.\n")
        wr("skills/beta/SKILL.md", "---\nname: beta\ndescription: beta\n---\nBeta body line.\n")
        git(src, "add", "-A")
        git(src, "commit", "-q", "-m", "skills")
        git(src, "tag", "v1.0.0")
        sha = git(src, "rev-parse", "HEAD")

        def office(**kw):
            s = {"url": "https://example.com/w/kit", "ref": "v1.0.0", "sha": sha, "dir": "sources/kit", "licence": "MIT",
                 "vetted": "https://example.com/m/1"}
            s.update(kw)
            json.dump({"minutesRepo": "a/b", "sources": {"kit": s}}, open(os.path.join(ws, "office.json"), "w"))

        def recipe(*uses):
            t = {"name": "alpha", "purpose": "p", "room": "project", "head": {"role": "room-lead", "model": "sonnet"},
                 "desks": [{"name": "impl", "model": "sonnet", "max": 2, "skills": [dict(u) for u in uses]},
                           {"name": "plain", "model": "sonnet", "max": 1}],
                 "entry": ["a"], "phases": ["work"], "output": "merged-pr", "done": {"check": "pr-merged"},
                 "worktree": True, "draftPr": True, "land": False, "caps": {"softUsdPerDay": 15, "hardUsdPerDay": 40}, "measures": ["cost"]}
            d = os.path.join(ws, "teams", "alpha")
            os.makedirs(d, exist_ok=True)
            json.dump(t, open(os.path.join(d, "team.json"), "w"))
            open(os.path.join(d, "SKILL.md"), "w").write("---\nname: alpha\ndescription: d\n---\n")

        out = os.path.join(ws, "desks")

        def run(*a):
            r = subprocess.run([sys.executable, "-I", os.path.abspath(__file__)] + list(a), env=dict(genv, BUSYBODY_WORKSPACE=ws),
                               capture_output=True, text=True)
            return r.returncode, r.stdout, r.stderr

        def refused(label, want, uses=({"use": "kit:alpha"},)):
            recipe(*uses)
            shutil.rmtree(out, ignore_errors=True)
            rc, o, e = run("build")
            if not (rc != 0 and want in e and len(e.strip().splitlines()) == 1 and not os.path.exists(out)):
                bad.append(f"skills: {label}: wanted a one-line refusal with {want!r} and nothing written, got {rc} {e!r}")

        office()
        recipe({"use": "kit:alpha", "at": "Use this when stuck."}, {"use": "kit:beta"})
        rc, o, e = run("build")
        if rc != 0:
            bad.append(f"skills: build failed: {e}")
            return
        agent = open(os.path.join(out, "agents", "alpha-impl.md")).read()
        want = ["## Skill: alpha (kit@v1.0.0)", "Use this when stuck.", "Alpha body line.", "### x.md", "Reference X text.",
                "## Skill: beta (kit@v1.0.0)", "Beta body line."]
        for w in want:
            if w not in agent:
                bad.append(f"skills: the agent lacks {w!r}")
        if "the alpha skill" in agent or "license: MIT" in agent:
            bad.append("skills: SKILL.md frontmatter is dropped")
        if not (agent.index("## Reporting") < agent.index("## Skill: alpha") < agent.index("## Skill: beta") and agent.endswith("\n")
                and not agent.endswith("\n\n")):
            bad.append("skills: sections follow the desk body, in order, one trailing newline")
        if "## Skill" in open(os.path.join(out, "agents", "alpha-plain.md")).read():
            bad.append("skills: a desk with no skills has none")
        first = agent
        run("build")
        if open(os.path.join(out, "agents", "alpha-impl.md")).read() != first:
            bad.append("skills: build is deterministic")
        office(ref=None)
        recipe({"use": "kit:beta"})
        run("build")
        if f"## Skill: beta (kit@{sha[:12]})" not in open(os.path.join(out, "agents", "alpha-impl.md")).read():
            bad.append("skills: a tagless source is headed with the short sha")
        office()
        # drift: fresh passes; a hand edit fails; with the clone absent the comparison is skipped with a warning
        recipe({"use": "kit:alpha", "at": "Use this when stuck."}, {"use": "kit:beta"})
        run("build")
        rc, o, e = run("check")
        if rc != 0 or "warning" in o:
            bad.append(f"skills: a fresh build passes the drift check: {rc} {o}")
        p = os.path.join(out, "agents", "alpha-impl.md")
        open(p, "a").write("hand edit\n")
        if run("check")[0] != 1:
            bad.append("skills: a hand edit of a skill-bearing agent fails the drift check")
        open(p, "w").write(first)
        open(os.path.join(out, "agents", "alpha-plain.md"), "a").write("hand edit\n")
        if run("check")[0] != 1:
            bad.append("skills: a hand edit of a skill-less agent still fails the drift check")
        run("build")
        moved = src + ".away"
        os.rename(src, moved)
        open(p, "a").write("hand edit\n")   # not compared while the clone is absent
        rc, o, e = run("check")
        if not (rc == 0 and "warning" in o and "alpha-impl.md" in o and "not compared" in o):
            bad.append(f"skills: an absent clone skips the skill-dependent comparison with a warning: {rc} {o} {e}")
        os.remove(os.path.join(out, "agents", "alpha-impl.md"))
        if run("check")[0] != 1:
            bad.append("skills: a missing skill-bearing agent still fails with the clone absent")
        rc, o, e = run("build")
        if not (rc != 0 and "kit:alpha" in e and "missing" in e):
            bad.append(f"skills: build needs the clone: {rc} {e}")
        os.rename(moved, src)
        # refusals
        git(src, "commit", "-q", "--allow-empty", "-m", "moved")
        refused("moved HEAD", "HEAD is")
        git(src, "checkout", "-q", "-f", sha)
        wr("skills/alpha/extra.txt", "x\n")
        refused("dirty tree", "local changes")
        os.remove(os.path.join(src, "skills", "alpha", "extra.txt"))
        refused("missing skill", "no SKILL.md", ({"use": "kit:ghost"},))
        refused("unknown source", "not listed in office.json sources", ({"use": "nope:alpha"},))
        for label, rel, text, want in (
                ("a scripts/ dir", "skills/alpha/scripts/run.sh", "echo hi\n", "scripts is not allowed"),
                ("a non-md file in references/", "skills/alpha/references/data.json", "{}\n", "references/data.json is not a plain .md"),
                ("a subdirectory of references/", "skills/alpha/references/sub/y.md", "y\n", "references/sub is not a plain .md"),
                ("a hooks dir", "skills/alpha/hooks/h.md", "h\n", "hooks is not allowed"),
                ("allowed-tools frontmatter", "skills/alpha/SKILL.md", "---\nname: alpha\nallowed-tools: Bash\n---\nx\n", "key allowed-tools"),
                ("hooks frontmatter", "skills/alpha/SKILL.md", "---\nname: alpha\nhooks:\n  a: b\n---\nx\n", "key hooks"),
                ("context frontmatter", "skills/alpha/SKILL.md", "---\nname: alpha\ncontext: fork\n---\nx\n", "key context"),
                ("no frontmatter", "skills/alpha/SKILL.md", "just text\n", "no frontmatter")):
            wr(rel, text)   # committed and pinned: the refusal is about the content, not a dirty tree
            git(src, "add", "-A")
            git(src, "commit", "-q", "-m", label)
            office(sha=git(src, "rev-parse", "HEAD"))
            refused(label, want)
            git(src, "checkout", "-q", "-f", sha)
            git(src, "clean", "-qfd")
            office()
        shutil.rmtree(out, ignore_errors=True)
        # the workspace's own team check: a skill in the present clone, a missing source name, and an absent clone as a warning
        recipe({"use": "kit:alpha"})
        r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "team"), "check"], env=dict(genv, BUSYBODY_WORKSPACE=ws), capture_output=True, text=True)
        if r.returncode != 0 or "warn" in r.stdout:
            bad.append(f"skills: team check with the clone present: {r.stdout} {r.stderr}")
        os.rename(src, src + ".away")
        r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "team"), "check"], env=dict(genv, BUSYBODY_WORKSPACE=ws), capture_output=True, text=True)
        if r.returncode != 0 or "warn alpha: kit:alpha: clone sources/kit is absent" not in r.stdout:
            bad.append(f"skills: team check with the clone absent warns: {r.returncode} {r.stdout} {r.stderr}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def self_test():
    import io, contextlib
    team = load_team()
    bad = []
    ws = tempfile.mkdtemp()
    try:
        def put(name, **kw):
            t = {"name": name, "purpose": f"purpose of {name}", "room": "project", "head": {"role": "room-lead", "model": "sonnet"},
                 "desks": [{"name": "impl", "model": "sonnet", "max": 2}, {"name": "rev", "model": "opus", "max": 1, "readOnly": True}],
                 "entry": ["a"], "phases": ["work"], "output": "merged-pr", "done": {"check": "pr-merged"},
                 "worktree": True, "draftPr": True, "land": False, "caps": {"softUsdPerDay": 15, "hardUsdPerDay": 40}, "measures": ["cost"]}
            t.update(kw)
            d = os.path.join(ws, "teams", name)
            os.makedirs(d, exist_ok=True)
            json.dump(t, open(os.path.join(d, "team.json"), "w"))
            open(os.path.join(d, "SKILL.md"), "w").write(f"---\nname: {name}\ndescription: d\n---\n")

        put("alpha")
        put("beta", desks=[{"name": "scout", "model": "haiku", "max": 3}])
        put("nodesk", desks=[], draftPr=False, worktree=False, output="verdict", done={"check": "verdict-posted"})
        put("staffy", room="staff", head={"role": "analyst", "model": "sonnet"}, output="report", done={"check": "report-posted"},
            draftPr=False, worktree=False)
        os.makedirs(os.path.join(ws, "roles", "analyst"))
        open(os.path.join(ws, "roles", "analyst", "role.json"), "w").write("{}")
        out = os.path.join(ws, "desks")
        with contextlib.redirect_stdout(io.StringIO()):
            build(team, ws, out)
        names = sorted(os.listdir(os.path.join(out, "agents")))
        if names != ["alpha-impl.md", "alpha-rev.md", "beta-scout.md"]:
            bad.append(f"agent files: {names}")
        pj = json.load(open(os.path.join(out, ".claude-plugin", "plugin.json")))
        if pj.get("name") != "desks" or not pj.get("version") or not pj.get("description"):
            bad.append(f"plugin.json: {pj}")

        def agent(n):
            return open(os.path.join(out, "agents", n + ".md")).read()

        impl, rev, scout = agent("alpha-impl"), agent("alpha-rev"), agent("beta-scout")
        if not (impl.startswith("---\nname: alpha-impl\n") and "\nmodel: sonnet\n" in impl and "disallowedTools" not in impl):
            bad.append(f"impl frontmatter: {impl[:200]}")
        if not ("\nname: alpha-rev\n" in rev and "\nmodel: opus\n" in rev and "\ndisallowedTools: Edit, Write, NotebookEdit\n" in rev
                and "read-only" in rev):
            bad.append(f"reviewer frontmatter: {rev[:300]}")
        if "\nmodel: haiku\n" not in scout:
            bad.append("a haiku desk keeps its model")
        if "{{" in impl + rev + scout or "`implementer`" in impl or "`impl` desk of the `alpha` team" not in impl:
            bad.append("placeholders must be filled")
        if not all(x.endswith("\n") and not x.endswith("\n\n") for x in (impl, rev, scout)):
            bad.append("one trailing newline")
        first = {r: open(os.path.join(out, r)).read() for r in ("agents/alpha-impl.md", ".claude-plugin/plugin.json")}
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            build(team, ws, out)
            if any(open(os.path.join(out, r)).read() != t for r, t in first.items()):
                bad.append("build must be deterministic")
            if check(team, ws, out) != 0:
                bad.append("a fresh build must pass the drift check")
            if shape(out) != 0:
                bad.append("a fresh build has the right shape")
            p = os.path.join(out, "agents", "alpha-rev.md")
            good = open(p).read()
            open(p, "w").write(good.replace("model: opus", "model: sonnet"))
            if check(team, ws, out) != 1:
                bad.append("a hand edit must fail the drift check")
            open(p, "w").write(good)
            os.remove(os.path.join(out, "agents", "beta-scout.md"))
            if check(team, ws, out) != 1:
                bad.append("a missing agent must fail the drift check")
            build(team, ws, out)
            open(os.path.join(out, "agents", "ghost.md"), "w").write("x\n")
            if check(team, ws, out) != 1:
                bad.append("a stale agent must fail the drift check")
            os.remove(os.path.join(out, "agents", "ghost.md"))
            os.makedirs(os.path.join(out, "hooks"))
            open(os.path.join(out, "hooks", "hooks.json"), "w").write("{}\n")
            if check(team, ws, out) != 1 or shape(out) != 1:
                bad.append("a hooks/ dir must fail the drift and shape checks")
            shutil.rmtree(os.path.join(out, "hooks"))
            open(os.path.join(out, ".mcp.json"), "w").write("{}\n")
            if shape(out) != 1:
                bad.append(".mcp.json must fail the shape check")
            os.remove(os.path.join(out, ".mcp.json"))
            if check(team, ws, os.path.join(ws, "nope")) != 1:
                bad.append("a missing desks dir fails kit check")
        # --out elsewhere leaves the workspace's own desks/ alone, and an invalid recipe stops the build
        alt = os.path.join(ws, "alt")
        with contextlib.redirect_stdout(io.StringIO()):
            build(team, ws, alt)
        if sorted(os.listdir(os.path.join(alt, "agents"))) != ["alpha-impl.md", "alpha-rev.md", "beta-scout.md"]:
            bad.append("build --out writes there")
        put("broken", desks=[{"name": "x", "model": "gpt", "max": 1}])
        r = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "build"], env=dict(os.environ, BUSYBODY_WORKSPACE=ws),
                           capture_output=True, text=True)
        if not (r.returncode != 0 and "broken" in r.stderr):
            bad.append(f"an invalid recipe must stop the build: {r.returncode} {r.stderr}")
        lead_start_cases(bad)
        skills_cases(bad)
    finally:
        shutil.rmtree(ws, ignore_errors=True)
    if bad:
        print("kit self-test: FAILED: " + "; ".join(bad))
        return 1
    print("kit self-test: ok")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 1
    if argv[0] == "--self-test":
        return self_test()
    cmd, rest = argv[0], argv[1:]
    if cmd == "shape":
        return shape(rest[0] if rest else die("usage: bin/kit shape DIR"))
    if cmd not in ("build", "check"):
        die(f"unknown command {cmd}; see bin/kit --help")
    opt, i = {}, 0
    while i < len(rest):
        if rest[i] in ("--out", "--dir") and i + 1 < len(rest):
            opt[rest[i]] = rest[i + 1]
            i += 2
        else:
            die(f"unknown argument {rest[i]}")
    team = load_team()
    root = team.WORKSPACE_ROOT
    if cmd == "build":
        return build(team, root, os.path.abspath(opt.get("--out", os.path.join(root, "desks"))))
    return check(team, root, os.path.abspath(opt.get("--dir", os.path.join(root, "desks"))))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
