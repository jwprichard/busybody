        expect("no --team leaves the settings as they were", "Bash(*bin/land*)" not in _role_settings("s", 0)["permissions"]["deny"])
        expect("--team with an unknown recipe is refused", role("run", "test-role", "x", "--controller", "c", "--team", "nope", "--dry-run").returncode != 0)
        expect("dry run writes no settings", not os.path.exists(os.path.join(ws, ".claude", "role-sessions")))
        expect("dry run says the pass issue opens at launch", "opened at launch" in out and "label refine" not in out and "label test-role-pass" in out)
