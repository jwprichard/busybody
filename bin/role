#!/usr/bin/python3 -I
"""Standing roles: memory-backed subagents that own an area (the busybody:standing-role skill).

  bin/role status [--json|--brief]  every role (--brief: only flagged roles, silent if none — SessionStart): memory vs caps, uses, pilot, pending diff, cost, flags
  bin/role cost [<role>] [--json]   spend per role: its spawns and role sessions (role-<role>-*), plus its workers (<role>-c-*), list-price estimate
  bin/role review [<role>]          the monthly review: cost vs budget, value signals (draft and memory rated apart), cited memory
                                    lines confirmed/contradicted, memory kill criterion (>20% of cited lines contradicted, or none
                                    confirmed over the pilot), candidates, flags
  bin/role diff <role>              the pending memory diff (stat + changed lines, <= 30 lines)
  bin/role commit-candidates <role> commit candidates.md changes that need no owner review, as `role(<role>): candidates` (not a use);
                                    `run` and `promote` do it first, and a candidates-only diff never counts as "waiting"
  bin/role batch <role>             the pending diff as numbered yes/no items for the owner: PROMOTE / ARCHIVE / RESTORE
                                    (max 5 shown; the rest stay on disk for the next DONE), a `batch: <hash>` line and the accept command
                                    per item; `accept|reject --expect <hash>` refuses if the pending items changed since
  bin/role accept <role> [--expect HASH] [--items 1,3] [--rating-draft R] [--rating-memory R] [--drafts approved=N,unedited=M]
                         [--confirmed m1,m2] [--contradicted m3] [--no-memory]
                                    commit the pending memory diff as ONE use `role(<role>): use N`. --items accepts only those
                                    batch items (unlisted shown items are declined and restored; default = all shown). candidates.md
                                    changes always commit. --rating (old) = --rating-draft. --rating-draft -> `Role-Value:` trailer,
                                    --rating-memory -> `Role-Memory-Value:`. --confirmed/--contradicted record which memory lines
                                    this pass cited and how they fared (roles/<role>/memory-cites.json). Refuses with no diff unless
                                    --no-memory, so the office and the controller can't double-count a use
  bin/role reject <role> [--expect HASH] [--redo] [--rating-draft R] [--rating-memory R] [--drafts …]
                                    drop the whole proposal and record the use as `(memory rejected)`; candidates.md changes still
                                    commit. --redo: restore without recording a use, because the redo stays inside this use.
                                    Refuses with no diff, so it can't follow an accept unnoticed. R = saved-time|useful|no-value
  bin/role promote <role> <cid> [--link URL2] [--trigger 2-links|1-link|correction]
                                    move candidate cN into MEMORY.md as the next mN, on disk, uncommitted (one batch item). The
                                    trigger is inferred (--link = 2-links; a generality word in the quote = 1-link; `corrects m<N>` =
                                    correction); over the 15-line cap the least-cited line is archived in the same batch
  bin/role archive <role> <mN> --because <comment-url> [--reason TEXT]
                                    move mN to archive.md and commit at once `role(<role>): archive mN` (no owner wait)
  bin/role restore <role> <mN>      archive.md -> MEMORY.md as a proposed, uncommitted item (batch/accept like a promotion)

Memory files (.claude/agent-memory/<role>/, only .md; contract enforced by bin/lib/role-memory-check):
  MEMORY.md     injected, <= 15 content lines (# headers exempt), ids m1.. never reused:
                - m<N> <YYYY-MM-DD>: <line>. Changes: <the question/recommendation/action>. "<verbatim quote>" (<url>)[ (<url2>)][ 1-link|correction]
                trigger: two DIFFERENT comment urls | `1-link` (single link, quote has always/never/by default/unless said otherwise/
                from now on/every time) | `correction` (owner corrected a line's recommendation; the line says `corrects m<N>`)
  candidates.md never injected, committed without owner review, <= 30 lines, 60-day expiry, first sightings:
                - c<N> <date>: <line>. Changes: <...>. "<quote>" (<url>)
  archive.md    never injected: the moved line + ` | archived <date>: <why>, <link>`
  A line enters MEMORY.md only by promotion (same text as its candidate). Drafts cite MEMORY.md ids only; candidates are read
  only in the debrief AFTER the owner has answered.
  bin/role new <role> --goal G --metric-cmd C --metric-desc D --budget USD [--contractor-budget USD]  (budget for its workers) [--cadence-days N] [--model sonnet] [--no-issue]
  bin/role keep <role>              end probation (the pilot said keep)
  bin/role disable <role> <reason>  stop loading the role; memory stays in git, frozen
  bin/role enable <role>            load it again (back on probation)
  bin/role run <role> <task…> [--controller NAME] [--team NAME] [--dry-run [--show-brief]]
                                    start ONE on-demand background session (role-<role>-<slug>) for a pass: it imports its
                                    charter and memory, asks the owner on its issue, hears the answers, hires <role>-c-*
                                    workers, proposes a memory diff and ends. Passes of one role run in parallel (each has its own session name; cost is
                                    attributed by that name).
  bin/role check                    exit 1 unless the memory pre-commit guard is installed
  bin/role install-hook             install the guard into .git/hooks/pre-commit (chains any existing hook)
  bin/role --self-test              guard, promotion/archive/restore, batches, ratings, cites, cost and use counting, in a scratch repo

State is derived, not kept: uses and ratings come from `role(<role>): use N` commits and their
`Role-Value:` trailer; enabled/disabled from where the charter lives; cost from transcripts.
roles/<role>/role.json holds only config and decisions (budget, metric, authority, pilot, issue).
"""
import glob, importlib.machinery, json, os, re, shutil, subprocess, sys, tempfile
from datetime import datetime, timedelta

HERE = ENGINE_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HERE, "bin", "lib"))
from officeroot import invoked_root, workspace_root, bb_env, selftest_reexec  # noqa: E402
selftest_reexec(ENGINE_ROOT)
import officeconfig  # noqa: E402
import sessions  # noqa: E402
from tracker import Tracker  # noqa: E402
WS = bb_env(None, "ROLE_WS", "SCH_ROLE_WS") or workspace_root(ENGINE_ROOT, invoked=invoked_root())   # BUSYBODY_ROLE_WS is a test hook
import costlib  # noqa: E402

sys.dont_write_bytecode = True
G = importlib.machinery.SourceFileLoader("role_memory_check", os.path.join(HERE, "bin", "lib", "role-memory-check")).load_module()

OFFICE = officeconfig.load_or_exit(WS, "role")
REPO = OFFICE.minutes_repo
TRACKER = Tracker(OFFICE.tracker)
AGENTS, DISABLED = ".claude/agents", ".claude/agents.disabled"
MEM, ROLES = ".claude/agent-memory", "roles"
CAP_INDEX, CAP_ROLE = 8 * 1024, 16 * 1024
STALE_DAYS, IDLE_DAYS, DIFF_LINES = 60, 30, 30
RATINGS = ("saved-time", "useful", "no-value")
MARKER = "busybody role-memory pre-commit guard"
LEGACY_MARKERS = ("sch-workspace role-memory pre-commit guard",)   # hooks installed before the rename are still ours
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,40}$")
LABEL = "list-price estimate"


def die(msg):
    sys.exit(f"role: {msg}")


def p(*parts):
    """A workspace-owned path (roles/, .claude/, decisions/)."""
    return os.path.join(WS, *parts)


def e(*parts):
    """An engine-owned path (templates/, teams/, bin/)."""
    return os.path.join(ENGINE_ROOT, *parts)


def git(*a, check=True):
    r = subprocess.run(["git", *a], cwd=WS, capture_output=True, text=True)
    if check and r.returncode:
        die(f"git {' '.join(a[:3])} failed: {(r.stderr or r.stdout).strip()[:300]}")
    return r


def today():
    return datetime.now(costlib.NZ).date()


def load_cfg(name):
    try:
        with open(p(ROLES, name, "role.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_cfg(name, cfg):
    with open(p(ROLES, name, "role.json"), "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


def role_names():
    return sorted(os.path.basename(os.path.dirname(f)) for f in glob.glob(p(ROLES, "*", "role.json")))


def need_role(name):
    if not name or load_cfg(name) is None:
        die(f"no role {name!r} (roles/<role>/role.json); known: {', '.join(role_names()) or 'none'}")
    return load_cfg(name)


# ---- derived state -------------------------------------------------------------------------

def uses(name):
    """Newest first: {date, n, rating, rejected}. From `role(<name>): use N` commits."""
    fmt = ("%cI%x1f%s%x1f%(trailers:key=Role-Value,valueonly,separator=%x2C)"
           "%x1f%(trailers:key=Role-Drafts,valueonly,separator=%x2C)"
           "%x1f%(trailers:key=Role-Memory-Value,valueonly,separator=%x2C)%x1e")
    r = git("log", f"--format={fmt}", "-E", f"--grep=^role\\({re.escape(name)}\\): use [0-9]+", check=False)
    out = []
    for rec in r.stdout.split("\x1e"):
        rec = rec.strip("\n")
        if not rec:
            continue
        ts, subj, rating, drafts, mrating = (rec.split("\x1f") + ["", "", "", ""])[:5]
        m = re.match(rf"^role\({re.escape(name)}\): use (\d+)", subj)
        if not m:
            continue
        dr = dict(re.findall(r"(approved|unedited)=(\d+)", drafts))
        out.append({"date": ts[:10], "n": int(m.group(1)), "rating": rating.strip() or None,
                    "memory_rating": mrating.strip() or None,
                    "rejected": "memory rejected" in subj,
                    "drafts": {k: int(v) for k, v in dr.items()} if dr else None})
    return out


def memory(name):
    d = p(MEM, name)
    files = sorted(glob.glob(os.path.join(d, "**", "*"), recursive=True))
    files = [f for f in files if os.path.isfile(f)]
    total = sum(os.path.getsize(f) for f in files)
    idx = os.path.join(d, "MEMORY.md")
    idx_bytes = os.path.getsize(idx) if os.path.exists(idx) else 0
    cutoff = today() - timedelta(days=STALE_DAYS)
    lines = stale = 0
    for f in files:
        if not f.endswith(".md") or os.path.basename(f) in ("archive.md", "candidates.md"):
            continue  # archived lines are old on purpose; candidates have their own 60-day expiry
        for ln in open(f, encoding="utf-8", errors="replace"):
            dates = re.findall(r"\b(20\d\d-[01]\d-[0-3]\d)\b", ln)
            if not dates:
                continue
            lines += 1
            try:
                if datetime.fromisoformat(max(dates)).date() < cutoff:
                    stale += 1
            except ValueError:
                pass
    mem_lines = len(G.mem_content("\n".join(read_disk(name, "MEMORY.md"))))
    cands = [l for l in read_disk(name, "candidates.md") if not G.exempt(l)]
    old = 0
    for l in cands:
        m = G.CAND_LINE.match(l)
        dt = m and G.parse_date(m.group(2))
        if dt and (today() - dt).days > G.CANDIDATE_DAYS:
            old += 1
    return {"memory_lines": mem_lines, "candidate_lines": len(cands), "candidates_expired": old, "index_bytes": idx_bytes, "total_bytes": total, "cap_index": CAP_INDEX, "cap_role": CAP_ROLE,
            "files": len(files), "dated_lines": lines, "stale_lines": stale}


def pending(name):
    r = git("status", "--porcelain", "--untracked-files=all", "--", f"{MEM}/{name}/", check=False)
    # candidates.md commits without owner review, so a diff in it alone is not "waiting" (commit_candidates)
    return [l for l in r.stdout.splitlines() if l.strip() and not l.rstrip().endswith("/candidates.md")]


def hook_path():
    common = git("rev-parse", "--git-common-dir").stdout.strip()
    return os.path.join(common if os.path.isabs(common) else p(common), "hooks", "pre-commit")


def _ours(text):
    return any(m in text for m in (MARKER,) + LEGACY_MARKERS)


def hook_installed():
    hp = hook_path()
    try:
        return _ours(open(hp).read()) and os.access(hp, os.X_OK)
    except OSError:
        return False


def _metas():
    for meta in glob.glob(os.path.join(costlib.PROJECTS, "*", "*", "subagents", "agent-*.meta.json")):
        try:
            m = json.load(open(meta))
        except (OSError, ValueError):
            continue
        j = meta[: -len(".meta.json")] + ".jsonl"
        if os.path.exists(j):
            yield m, j


def _contractor_of(m):
    """The role a worker works for: a spawn named `<role>-c-<task>` (agentType = the Agent name)."""
    mt = re.match(r"^([a-z][a-z0-9-]*?)-c-", m.get("agentType") or "")
    return mt.group(1) if mt else None


_AGENTS = None


def agents_list():
    """`claude agents --json --all` (or the file in $BUSYBODY_ROLE_AGENTS_JSON), read once. [] when unavailable."""
    global _AGENTS
    if _AGENTS is None:
        try:
            fixture = bb_env(None, "ROLE_AGENTS_JSON", "SCH_ROLE_AGENTS_JSON")
            if fixture:
                _AGENTS = json.load(open(fixture))
            else:
                out = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True, text=True, timeout=30)
                _AGENTS = json.loads(out.stdout)
        except (OSError, ValueError, subprocess.SubprocessError):
            _AGENTS = []
    return _AGENTS


def role_sessions(name):
    """Role sessions of one role (`bin/role run` names them role-<role>-<slug>), newest first."""
    out = [a for a in agents_list() if (a.get("name") or "").startswith(f"role-{name}-") and a.get("sessionId") and a.get("cwd")]
    return sorted(out, key=lambda a: -(a.get("startedAt") or 0))


def _session_files(name):
    """(own, hired, sessions): a role session's own transcript plus its subagents, split by the
    `<role>-c-` name prefix. An unnamed helper spawned inside a session is the role's own cost."""
    own, hired, seen = [], [], set()
    sessions = role_sessions(name)
    for a in sessions:
        for f in costlib.transcript_files(a["sessionId"], a["cwd"]):
            seen.add(f)
            meta = f[: -len(".jsonl")] + ".meta.json"
            try:
                m = json.load(open(meta)) if os.path.exists(meta) else {}
            except (OSError, ValueError):
                m = {}
            (hired if _contractor_of(m) == name else own).append(f)
    return own, hired, seen, len(sessions)


def cost(name):
    """Spend of the role's own spawns and sessions, plus its workers (`<role>-c-*`) as a separate line.

    Named spawns carry spawnedAgentType "general-purpose", so workers are matched on the
    agentType prefix and never counted under the type they were spawned as. A role session
    (`role-<role>-*`) is billed by its name, with its subagents split the same way."""
    own, hired, seen, sessions = _session_files(name)
    for m, j in _metas():
        if j in seen:
            continue
        if _contractor_of(m) == name:
            hired.append(j)
        elif not _contractor_of(m) and (m.get("spawnedAgentType") == name
                                       or (not m.get("spawnedAgentType") and m.get("agentType") == name)):
            own.append(j)
    out = _price(own)
    out["sessions"] = sessions
    out["contractors"] = _price(hired)
    out["workers"] = out["contractors"]  # new name; "contractors" kept for readers of the old field
    return out


def _price(files):
    prices = costlib.load_prices()
    spawns = len(files)
    t = today()
    month = last30 = total = 0.0
    unpriced, last = set(), ""
    for ts, model, u in costlib.collect(files).values():
        c, ok = costlib.row_cost(prices, model, u)
        if not ok:
            unpriced.add(model)
        total += c
        d = costlib.nz_date(ts)
        if d and (d.year, d.month) == (t.year, t.month):
            month += c
        if d and d > t - timedelta(days=30):
            last30 += c
        last = max(last, ts)
    return {"month": round(month, 4), "last30": round(last30, 4), "total": round(total, 4), "spawns": spawns,
            "per_spawn": round(total / spawns, 4) if spawns else 0.0, "unpriced": sorted(unpriced),
            "last_activity": last, "label": LABEL}


def flags(name, cfg, st):
    out = []
    budget = cfg.get("budget_usd_month") or 0
    if budget and st["cost"]["month"] > budget:
        out.append(f"over budget: ${st['cost']['month']:.2f} of ${budget:.0f} this month")
    cbudget = cfg.get("contractor_budget_usd_month") or 0
    if cbudget and st["cost"]["contractors"]["month"] > cbudget:
        out.append(f"workers over budget: ${st['cost']['contractors']['month']:.2f} of ${cbudget:.0f} this month")
    us = st["uses"]
    if len(us) >= 3 and all(u["rating"] == "no-value" for u in us[:3]):
        out.append("3 no-value uses in a row")
    since = us[0]["date"] if us else (cfg.get("pilot") or {}).get("start")
    if since and st["enabled"]:
        idle = (today() - datetime.fromisoformat(since).date()).days
        if idle > IDLE_DAYS:
            out.append(f"unused {idle} days")
        elif cfg.get("cadence_days") and idle >= cfg["cadence_days"]:
            out.append(f"due: last used {idle} days ago (cadence {cfg['cadence_days']} days)")
    pil = cfg.get("pilot") or {}
    if st["enabled"] and not cfg.get("kept_on") and pil.get("start"):
        days = (today() - datetime.fromisoformat(pil["start"]).date()).days
        if days >= 7 * pil.get("weeks", 3) or len(us) >= pil.get("uses", 6):
            out.append("pilot window over: keep / reshape / disable" if len(us) >= 3
                       else f"pilot inconclusive ({len(us)} uses < 3): extend once")
    m = st["memory"]
    if m["dated_lines"] and m["stale_lines"] / m["dated_lines"] > 0.2:
        out.append(f"{m['stale_lines']}/{m['dated_lines']} memory lines stale (>20%)")
    if m["index_bytes"] > CAP_INDEX or m["total_bytes"] > CAP_ROLE:
        out.append("memory over cap")
    if m["candidate_lines"] >= G.CAP_CANDIDATES - 5:
        out.append(f"candidates.md near its cap ({m['candidate_lines']}/{G.CAP_CANDIDATES}): promote or drop some")
    if m["candidates_expired"]:
        out.append(f"{m['candidates_expired']} candidate(s) older than {G.CANDIDATE_DAYS} days: promote or drop")
    if m["memory_lines"] > G.CAP_MEMORY_LINES:
        out.append(f"MEMORY.md has {m['memory_lines']} lines (cap {G.CAP_MEMORY_LINES})")
    ck = st["cites"]
    if ck["records"] and ck["contradicted"] / max(1, ck["confirmed"] + ck["contradicted"]) > 0.2:
        out.append(f"memory kill criterion: {ck['contradicted']} of {ck['confirmed'] + ck['contradicted']} cited lines contradicted (>20%)")
    elif ck["records"] and not ck["confirmed"] and st["pilot_over"]:
        out.append("memory kill criterion: no cited memory line was confirmed over the pilot")
    if st["pending"]:
        out.append(f"memory diff waiting for review ({len(st['pending'])} file(s))")
    if st["enabled"] and not st["hook"]:
        out.append("memory guard not installed: run bin/role install-hook")
    return out


def state(name):
    cfg = load_cfg(name) or {}
    enabled = os.path.exists(p(AGENTS, name + ".md"))
    us = uses(name)
    pil = cfg.get("pilot") or {}
    st = {"name": name, "goal": cfg.get("goal"), "enabled": enabled,
          "status": "disabled" if not enabled else ("kept" if cfg.get("kept_on") else "probation"),
          "issue": cfg.get("issue"), "budget_usd_month": cfg.get("budget_usd_month"),
          "contractor_budget_usd_month": cfg.get("contractor_budget_usd_month"),
          "drafts": {k: sum((u["drafts"] or {}).get(k, 0) for u in us) for k in ("approved", "unedited")},
          "authority": cfg.get("authority", 0), "metric": cfg.get("metric"),
          "uses": us, "use_count": len(us), "last_use": us[0]["date"] if us else None,
          "ratings": {r: sum(1 for u in us if u["rating"] == r) for r in RATINGS},
          "memory_ratings": {r: sum(1 for u in us if u["memory_rating"] == r) for r in RATINGS},
          "memory_rejected": sum(1 for u in us if u["rejected"]),
          "pilot": dict(pil, days=(today() - datetime.fromisoformat(pil["start"]).date()).days) if pil.get("start") else None,
          "cites": cite_summary(name),
          "uses_without_cites": 0,
          "pilot_over": bool(pil.get("start")) and ((today() - datetime.fromisoformat(pil["start"]).date()).days >= 7 * pil.get("weeks", 3)
                                                    or len(us) >= pil.get("uses", 6)),
          "memory": memory(name), "pending": pending(name), "hook": hook_installed(), "cost": cost(name),
          "disabled_reason": cfg.get("disabled_reason")}
    recorded = {r.get("use") for r in cite_records(name)}
    st["uses_without_cites"] = len([u for u in us if not u["rejected"] and u["n"] not in recorded]) if st["memory"]["memory_lines"] else 0
    st["flags"] = flags(name, cfg, st)
    return st


# ---- commands ------------------------------------------------------------------------------

def cmd_status(argv):
    names = [a for a in argv if not a.startswith("-")] or role_names()
    sts = [state(n) for n in names]
    if "--brief" in argv:
        for s in (s for s in sts if s["flags"]):
            print(f"role {s['name']} ({s['status']}): " + "; ".join(s["flags"]) + f"  — bin/role review {s['name']}")
        return
    if "--json" in argv:
        print(json.dumps({"generated_at": datetime.now(costlib.NZ).isoformat(), "hook": hook_installed(),
                          "roles": sts}, indent=1))
        return
    if not sts:
        print("no roles yet (bin/role new …)")
    for s in sts:
        m, c = s["memory"], s["cost"]
        pil = s["pilot"] or {}
        pilot = f"pilot {s['use_count']}/{pil.get('uses', '?')} uses, day {pil.get('days', '?')}/{7 * pil.get('weeks', 3)}" \
            if s["status"] == "probation" else s["status"]
        print(f"{s['name']:<20} {pilot:<32} memory {m['index_bytes'] / 1024:.1f}/{CAP_INDEX // 1024}KB "
              f"({m['total_bytes'] / 1024:.1f}/{CAP_ROLE // 1024}KB)  ${c['month']:.2f}/${s['budget_usd_month'] or 0:.0f} month"
              + (f" + workers ${c['contractors']['month']:.2f}/${s['contractor_budget_usd_month']:.0f}"
                 if s['contractor_budget_usd_month'] else "") + "  "
              f"last {s['last_use'] or '-'}")
        for f in s["flags"]:
            print(f"  ! {f}")


def cmd_cost(argv):
    names = [a for a in argv if not a.startswith("-")] or role_names()
    res = {n: cost(n) for n in names}
    if "--json" in argv:
        print(json.dumps({"label": LABEL, "roles": res}, indent=2))
        return
    for n, c in res.items():
        b = (load_cfg(n) or {}).get("budget_usd_month") or 0
        print(f"{n:<20} ${c['month']:>7.2f} month (budget ${b:.0f})  ${c['last30']:>7.2f} 30d  ${c['total']:>7.2f} total  "
              f"{c['spawns']} spawns  ${c['per_spawn']:.2f}/spawn{'  UNPRICED ' + ','.join(c['unpriced']) if c['unpriced'] else ''}")
        h = c["contractors"]
        if h["spawns"]:
            cb = (load_cfg(n) or {}).get("contractor_budget_usd_month") or 0
            print(f"{'  workers':<20} ${h['month']:>7.2f} month (budget ${cb:.0f})  ${h['total']:>7.2f} total  "
                  f"{h['spawns']} spawns ({n}-c-*)")
    print(f"({LABEL}; the controller's own relay/review tokens are not counted — limitations/role-cost-excludes-liaison.md)")


def cmd_review(argv):
    for n in [a for a in argv if not a.startswith("-")] or role_names():
        s, cfg = state(n), load_cfg(n) or {}
        c, r = s["cost"], s["ratings"]
        print(f"== {n} ({s['status']}) — {s['goal']}")
        print(f"   cost      ${c['month']:.2f} this month of ${s['budget_usd_month'] or 0:.0f} budget; ${c['total']:.2f} total; "
              f"${c['per_spawn']:.2f} per spawn ({c['spawns']} spawns)")
        if c["contractors"]["spawns"] or s["contractor_budget_usd_month"]:
            h = c["contractors"]
            print(f"   workers   ${h['month']:.2f} this month of ${s['contractor_budget_usd_month'] or 0:.0f} budget; "
                  f"${h['total']:.2f} total; {h['spawns']} spawns ({n}-c-*)")
        if s["drafts"]["approved"]:
            print(f"   drafts    {s['drafts']['unedited']} of {s['drafts']['approved']} approved without edits "
                  "(read only next to the post-build measure)")
        print(f"   value     {s['use_count']} uses; drafts: saved-time {r['saved-time']}, useful {r['useful']}, no-value {r['no-value']}, "
              f"unrated {s['use_count'] - sum(r.values())}; memory rejected {s['memory_rejected']}x")
        mr = s["memory_ratings"]
        print(f"   memory value  saved-time {mr['saved-time']}, useful {mr['useful']}, no-value {mr['no-value']}, "
              f"unrated {s['use_count'] - sum(mr.values())} (the owner rates the memory diff apart from the drafts)")
        print(f"   memory    {s['memory']['dated_lines']} dated lines, {s['memory']['stale_lines']} stale; "
              f"{s['memory']['index_bytes']}B index, {s['memory']['total_bytes']}B total")
        ck = s["cites"]
        if s["uses_without_cites"]:
            print(f"   ! no cite records for {s['uses_without_cites']} of {s['use_count']} uses although MEMORY.md has lines: a use settled without "
                  "--confirmed/--contradicted (the office path passes none) is invisible to the kill criterion")
        if ck["records"]:
            tot = ck["confirmed"] + ck["contradicted"]
            print(f"   cited memory  {ck['confirmed']} confirmed / {ck['contradicted']} contradicted over {ck['records']} use(s) "
                  f"({100 * ck['contradicted'] // max(1, tot)}% contradicted; kill criterion: >20% contradicted, or none confirmed over the pilot)")
        else:
            print("   cited memory  no uses recorded with --confirmed/--contradicted yet (kill criterion: >20% contradicted, or none confirmed over the pilot)")
        print(f"   candidates    {s['memory']['candidate_lines']}/{G.CAP_CANDIDATES} lines, {s['memory']['candidates_expired']} older than {G.CANDIDATE_DAYS} days; "
              f"MEMORY.md {s['memory']['memory_lines']}/{G.CAP_MEMORY_LINES} lines")
        if (cfg.get("metric") or {}).get("command"):
            print(f"   metric    {cfg['metric'].get('description', '')}: run `{cfg['metric']['command']}`")
        print("   verdict   " + ("; ".join(s["flags"]) if s["flags"] else "no flags"))


def cmd_diff(argv):
    name = argv[0] if argv else None
    need_role(name)
    d = f"{MEM}/{name}/"
    # Read-only: never touch the index (the office runs this every 20 s). Tracked changes come
    # from `git diff`; new, untracked files are diffed against /dev/null.
    stat = git("diff", "--stat", "HEAD", "--", d, check=False).stdout.rstrip()
    raw = git("diff", "-U0", "--no-color", "HEAD", "--", d, check=False).stdout
    new = git("ls-files", "--others", "--exclude-standard", "--", d, check=False).stdout.split()
    for f in new:
        raw += git("diff", "--no-index", "-U0", "--no-color", "/dev/null", f, check=False).stdout
        stat += f"\n {f} (new file)"
    stat = stat.strip()
    body = [l for l in raw.splitlines() if (l.startswith(("+", "-")) and not l.startswith(("+++", "---")))]
    if not stat:
        print(f"{name}: no memory changes")
        return
    print(stat)
    for l in body[:DIFF_LINES]:
        print(l)
    if len(body) > DIFF_LINES:
        print(f"… {len(body) - DIFF_LINES} more changed lines: a use should change little — consider reject")


def _rating(argv, flag="--rating-draft"):
    """The draft rating (`Role-Value:`): --rating-draft, or the old --rating as an alias."""
    flags = [flag, "--rating"] if flag == "--rating-draft" else [flag]
    for fl in flags:
        if fl in argv:
            r = argv[argv.index(fl) + 1] if argv.index(fl) + 1 < len(argv) else ""
            if r not in RATINGS:
                die(f"{fl} must be one of {', '.join(RATINGS)}")
            return r
    return None


def _guard_index(name):
    other = [n for n in git("diff", "--cached", "--name-only").stdout.splitlines() if not n.startswith(f"{MEM}/{name}/")]
    if other:
        die(f"other changes are staged ({', '.join(other[:3])}…); commit or unstage them first")


def _drafts(argv):
    """--drafts approved=N,unedited=M  ->  the Role-Drafts trailer value."""
    if "--drafts" not in argv:
        return None
    v = dict(re.findall(r"(approved|unedited)=(\d+)", argv[argv.index("--drafts") + 1]))
    if set(v) != {"approved", "unedited"} or int(v["unedited"]) > int(v["approved"]):
        die("--drafts approved=N,unedited=M (unedited <= approved)")
    return f"approved={v['approved']} unedited={v['unedited']}"


def _use_commit(name, rating, rejected, drafts=None, memory_rating=None):
    n = max([u["n"] for u in uses(name)] or [0]) + 1
    subj = f"role({name}): use {n}" + (" (memory rejected)" if rejected else "")
    msg = [subj, ""] + ([f"Role-Value: {rating}"] if rating else []) + (
        [f"Role-Memory-Value: {memory_rating}"] if memory_rating else []) + ([f"Role-Drafts: {drafts}"] if drafts else [])
    git("commit", "-q", "--allow-empty", "-m", "\n".join(msg).strip())
    return subj


MAX_ITEMS = 5


def _lines_diff(a, b):
    return [l for l in G.added("\n".join(a), "\n".join(b)) if l.strip()]


def pending_items(name):
    """(items, auto, H): the pending memory diff as owner yes/no items. `auto` = candidates.md
    changes not tied to an item (they commit without owner review). H = the committed lines."""
    H = {f: read_head(name, f) for f in G.FILES}
    D = {f: read_disk(name, f) for f in G.FILES}
    add = {f: _lines_diff(D[f], H[f]) for f in G.FILES}
    gone = {f: _lines_diff(H[f], D[f]) for f in G.FILES}
    items, used = [], set()

    def ops(**kw):
        return {f: {"add": list(v.get("add", [])), "del": list(v.get("del", []))} for f, v in
                {"MEMORY.md": kw.get("mem", {}), "candidates.md": kw.get("cand", {}), "archive.md": kw.get("arch", {})}.items()}

    for l in add["MEMORY.md"]:
        mid = line_id(l, "m")
        a = next((x for x in gone["archive.md"] if x.split(" | archived ")[0] == l and ("a", x) not in used), None)
        if mid is not None and a:
            used.add(("a", a))
            items.append({"kind": "restore", "rank": 1, "key": mid, "label": f"RESTORE m{mid} from the archive: {l}",
                          "ops": ops(mem={"add": [l]}, arch={"del": [a]})})
            continue
        body = G.body(l, G.MEM_LINE)
        c = next((x for x in gone["candidates.md"] if G.CAND_LINE.match(x) and body and body.startswith(G.CAND_LINE.match(x).group(3))
                  and ("c", x) not in used), None)
        if mid is not None and c:
            used.add(("c", c))
            items.append({"kind": "promote", "rank": 0, "key": mid, "label": f"PROMOTE c{line_id(c, 'c')} -> m{mid}: {l}",
                          "ops": ops(mem={"add": [l]}, cand={"del": [c]})})
            continue
        items.append({"kind": "edit", "rank": 3, "key": mid or 0, "label": f"ADD to MEMORY.md (not promoted from a candidate; the guard will refuse): {l}",
                      "ops": ops(mem={"add": [l]})})
    for l in gone["MEMORY.md"]:
        mid = line_id(l, "m")
        a = next((x for x in add["archive.md"] if x.startswith(l + " | archived ") and ("a+", x) not in used), None)
        if mid is not None and a:
            used.add(("a+", a))
            items.append({"kind": "archive", "rank": 2, "key": mid, "label": f"ARCHIVE m{mid} ({a.split(' | archived ')[1]}): {l}",
                          "ops": ops(mem={"del": [l]}, arch={"add": [a]})})
        else:
            items.append({"kind": "edit", "rank": 3, "key": mid or 0, "label": f"REMOVE from MEMORY.md: {l}", "ops": ops(mem={"del": [l]})})
    for l in add["archive.md"]:
        if ("a+", l) not in used:
            items.append({"kind": "edit", "rank": 3, "key": 0, "label": f"ADD to archive.md: {l}", "ops": ops(arch={"add": [l]})})
    for l in gone["archive.md"]:
        if ("a", l) not in used:
            items.append({"kind": "edit", "rank": 3, "key": 0, "label": f"REMOVE from archive.md: {l}", "ops": ops(arch={"del": [l]})})
    auto = ops(cand={"add": [l for l in add["candidates.md"] if ("c+", l) not in used],
                     "del": [l for l in gone["candidates.md"] if ("c", l) not in used]})
    known = {f"{MEM}/{name}/{f}" for f in G.FILES}
    for line in pending(name):
        path = line[3:].strip().strip('"')
        if path not in known and not path.endswith("/"):
            items.append({"kind": "other", "rank": 4, "key": 0, "label": f"CHANGE {path} (only .md files are allowed in memory)", "ops": ops(), "path": path})
    # a cap archive travels with the promotion/restore that made room, so no cut of the batch can split them
    caps = [it for it in items if it["kind"] == "archive" and f"over the {G.CAP_MEMORY_LINES}-line cap" in it["label"]]
    hosts = sorted([it for it in items if it["kind"] in ("promote", "restore")], key=lambda i: (i["rank"], i["key"]))
    if hosts:
        cites, recs = cite_counts(name), cite_records(name)
        for i, cap in enumerate(caps):
            host = hosts[min(i, len(hosts) - 1)]
            for f in G.FILES:
                host["ops"][f]["add"] += cap["ops"][f]["add"]
                host["ops"][f]["del"] += cap["ops"][f]["del"]
            gone_line = cap["ops"]["MEMORY.md"]["del"][0]
            mk = f"m{line_id(gone_line, 'm')}"
            host["label"] += (f" ; AND ARCHIVE {mk} to make room (cited {cites.get(mk, 0)}x"
                              + ("" if recs else "; no use has recorded cites yet, so the lowest id goes") + f"): {gone_line}")
            items.remove(cap)
    items.sort(key=lambda i: (i["rank"], i["key"], i["label"]))
    return items, auto, H


def _apply(H, op_sets):
    out = {f: list(H[f]) for f in G.FILES}
    for o in op_sets:
        for f in G.FILES:
            for l in o[f]["del"]:
                if l in out[f]:
                    out[f].remove(l)
            out[f] += o[f]["add"]
    return out


def _snapshot(name):
    d = p(MEM, name)
    return {f: open(f, "rb").read() for f in glob.glob(os.path.join(d, "**", "*"), recursive=True) if os.path.isfile(f)}


def _rollback(name, snap):
    d = p(MEM, name)
    for f in glob.glob(os.path.join(d, "**", "*"), recursive=True):
        if os.path.isfile(f) and f not in snap:
            os.remove(f)
    for f, data in snap.items():
        os.makedirs(os.path.dirname(f), exist_ok=True)
        open(f, "wb").write(data)


def _parse_items(argv, n):
    if "--items" not in argv:
        return set(range(1, n + 1))
    raw = _opt(argv, "--items", "")
    try:
        got = {int(x) for x in raw.split(",") if x.strip()}
    except ValueError:
        die("--items takes item numbers from `bin/role batch`, e.g. --items 1,3")
    bad = sorted(x for x in got if not 1 <= x <= n)
    if bad:
        die(f"no item {bad} (bin/role batch shows {n} item(s); only those are decided in a pass)")
    return got


def _ids_opt(argv, flag):
    return [i for i in re.split(r"[,\s]+", _opt(argv, flag, "")) if i]


def _cites(name, argv, H, reject):
    """--confirmed m1,m2 --contradicted m3: record which memory lines this pass cited and how they fared
    (roles/<role>/memory-cites.json, one record per use), staged into the use commit."""
    conf, contra = _ids_opt(argv, "--confirmed"), _ids_opt(argv, "--contradicted")
    if not conf and not contra:
        return None
    if reject:
        die("--confirmed/--contradicted record a use's citations: pass them to accept, not reject")
    have = {f"m{line_id(l, 'm')}" for l in H["MEMORY.md"] if line_id(l, "m")}
    bad = sorted((set(conf) | set(contra)) - have)
    if bad or set(conf) & set(contra):
        die(f"cited ids must be committed MEMORY.md lines, each confirmed or contradicted once: {bad or sorted(set(conf) & set(contra))}")
    return {"use": max([u["n"] for u in uses(name)] or [0]) + 1, "confirmed": sorted(set(conf)), "contradicted": sorted(set(contra))}


def _record_cites(name, rec):
    recs = cite_records(name) + [rec]
    path = p(ROLES, name, "memory-cites.json")
    with open(path, "w") as f:
        json.dump(recs, f, indent=1)
        f.write("\n")
    git("add", "--", os.path.relpath(path, WS))


def batch_hash(items):
    """Short fingerprint of the pending items: `accept/reject --expect <hash>` refuses if the batch changed since the owner saw it."""
    import hashlib
    return hashlib.sha1(json.dumps([[it["label"], it["ops"]] for it in items], sort_keys=True).encode()).hexdigest()[:8]


def _settle(name, argv, reject):
    """Accept or reject the pending memory diff, item by item, as ONE use commit."""
    items, auto, H = pending_items(name)
    expect = _opt(argv, "--expect")
    if expect and expect != batch_hash(items):
        die(f"stale batch: the pending memory items changed since `bin/role batch {name}` showed {expect} (now {batch_hash(items)}); show it again")
    cited = _cites(name, argv, H, reject)
    shown, over = items[:MAX_ITEMS], items[MAX_ITEMS:]
    take = set() if reject else _parse_items(argv, len(shown))
    redo = reject and "--redo" in argv
    snap = _snapshot(name)
    accepted = [it for i, it in enumerate(shown, 1) if i in take]
    committed = _apply(H, [auto] + [it["ops"] for it in accepted])
    _write_all(name, committed["MEMORY.md"], committed["candidates.md"], committed["archive.md"])
    for it in shown:
        if it["kind"] == "other" and it not in accepted:
            path = p(it["path"])
            if git("ls-files", "--error-unmatch", "--", it["path"], check=False).returncode == 0:
                git("checkout", "HEAD", "--", it["path"], check=False)
            elif os.path.exists(path):
                os.remove(path)
    held = f"; {len(over)} held-over item(s) were not part of this pass and stay on disk (bin/role batch {name})" if over else ""
    if redo:
        if over:
            later = _apply(committed, [it["ops"] for it in over])
            _write_all(name, later["MEMORY.md"], later["candidates.md"], later["archive.md"])
        print(f"{name}: dropped {len(shown)} shown item(s); redo it inside this use, then `bin/role batch {name}`. No use recorded{held}.")
        return
    paths = [f"{MEM}/{name}/{f}" for f in G.FILES if os.path.exists(p(MEM, name, f)) or read_head(name, f)]
    paths += [it["path"] for it in accepted if it["kind"] == "other"]
    git("add", "-A", "--", *paths, check=False)
    r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "lib", "role-memory-check")], cwd=WS)
    if r.returncode:
        git("reset", "-q", "--", f"{MEM}/{name}/", check=False)
        _rollback(name, snap)
        die("memory failed the guard (above): edit it, or `bin/role reject` to restore")
    rejected = bool(items) and not accepted
    if cited:
        _record_cites(name, cited)
    elif not reject and H["MEMORY.md"] and any(line_id(l, "m") for l in H["MEMORY.md"]):
        print("note: no --confirmed/--contradicted recorded for this use; if any memory line was cited, say how it fared "
              "(the kill criterion only sees recorded cites)")
    print(_use_commit(name, _rating(argv), rejected, _drafts(argv), _rating(argv, "--rating-memory")))
    if over:
        later = _apply(committed, [it["ops"] for it in over])
        _write_all(name, later["MEMORY.md"], later["candidates.md"], later["archive.md"])
    summary = f"items: accepted {[i for i in sorted(take)]}, declined {[i for i in range(1, len(shown) + 1) if i not in take]}"
    if over:
        summary += f", {len(over)} held-over item(s) left on disk for the next DONE (bin/role batch {name})"
    print(summary)


def commit_candidates(name):
    """Commit the candidates.md changes that belong to no owner item (new or dropped candidates), as
    `role(<role>): candidates`, not a use. Leaves a candidate removal that belongs to a pending promotion on disk."""
    items, auto, H = pending_items(name)
    new = _apply(H, [auto])["candidates.md"]
    if new == H["candidates.md"] or (not new and not H["candidates.md"]):
        return False
    _guard_index(name)
    path = f"{MEM}/{name}/candidates.md"
    blob = subprocess.run(["git", "hash-object", "-w", "--stdin"], cwd=WS, input="\n".join(new) + "\n",
                          capture_output=True, text=True).stdout.strip()
    git("update-index", "--add", "--cacheinfo", f"100644,{blob},{path}")
    r = git("commit", "-q", "-m", f"role({name}): candidates", check=False)
    if r.returncode:
        git("reset", "-q", "--", path, check=False)
        die(f"candidates refused by the guard: {(r.stderr or r.stdout).strip()[:400]}")
    print(f"role({name}): candidates")
    return True


def cmd_commit_candidates(argv):
    name = argv[0] if argv else None
    need_role(name)
    if not commit_candidates(name):
        print(f"{name}: no candidates.md changes to commit")


def cmd_batch(argv):
    name = argv[0] if argv else None
    need_role(name)
    items, auto, _ = pending_items(name)
    if not items:
        n = len(auto["candidates.md"]["add"]) + len(auto["candidates.md"]["del"])
        print(f"{name}: no memory items for the owner" + (f"; candidates.md has {n} changed line(s) that commit without review "
              f"(next use, or bin/role commit-candidates {name})" if n else ""))
        err = _check_worktree(name)
        print("guard: " + ("ok" if not err else "REFUSES\n" + err))
        return
    shown, over = items[:MAX_ITEMS], items[MAX_ITEMS:]
    print(f"{name}: {len(items)} memory item(s) for the owner, showing {len(shown)} (yes/no each)")
    for i, it in enumerate(shown, 1):
        print(f" [{i}] {it['label']}")
    n_auto = len(auto["candidates.md"]["add"]) + len(auto["candidates.md"]["del"])
    if n_auto:
        print(f" (candidates.md: +{len(auto['candidates.md']['add'])} -{len(auto['candidates.md']['del'])} line(s) commit without review)")
    if over:
        print(f" ({len(over)} more item(s) are not shown: max {MAX_ITEMS} per pass; they stay on disk for the next DONE)")
    if shown:
        h = batch_hash(items)
        print(f"batch: {h}\naccept all:  bin/role accept {name} --expect {h}\n"
              f"accept some: bin/role accept {name} --expect {h} --items 1,3   (unlisted = no)\n"
              f"reject all:  bin/role reject {name} --expect {h}   (or --redo to redo inside this use)")
    err = _check_worktree(name)
    print("guard: " + ("ok" if not err else "REFUSES\n" + err))


def commit_cand_pending(name):
    _, auto, _ = pending_items(name)
    return bool(auto["candidates.md"]["add"] or auto["candidates.md"]["del"])


def cmd_accept(argv):
    name = argv[0] if argv else None
    need_role(name)
    if not hook_installed():
        die("memory guard not installed: bin/role install-hook")
    _guard_index(name)
    cand_only = commit_cand_pending(name)
    if not pending(name) and not cand_only and "--no-memory" not in argv:
        die(f"{name} has no memory diff to accept (already accepted, e.g. from the office?). "
            "To record a use that learned nothing, pass --no-memory.")
    _settle(name, argv, reject=False)


def cmd_reject(argv):
    name = argv[0] if argv else None
    need_role(name)
    _guard_index(name)
    if not pending(name):
        die(f"{name} has no memory diff to reject (already accepted or rejected, e.g. from the office?). "
            f"Check `git log -1 -- .claude/agent-memory/{name}`; a use that learned nothing is "
            f"`bin/role accept {name} --no-memory`.")
    _settle(name, argv, reject=True)


# ---- memory lifecycle: promote, archive, restore -------------------------------------------
# Memory lives in .claude/agent-memory/<role>/{MEMORY.md,candidates.md,archive.md}; the contract is in
# bin/lib/role-memory-check. Lines are plain text, so every move below is a line move between files.

def mem_file(name, f):
    return p(MEM, name, f)


def read_disk(name, f):
    try:
        return open(mem_file(name, f), encoding="utf-8").read().splitlines()
    except OSError:
        return []


def read_head(name, f):
    r = git("show", f"HEAD:{MEM}/{name}/{f}", check=False)
    return r.stdout.splitlines() if r.returncode == 0 else []


def write_lines(name, f, lines, existed_in_head=True):
    path = mem_file(name, f)
    if not lines and not existed_in_head:
        if os.path.exists(path):
            os.remove(path)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + ("\n" if lines else ""))


def line_id(line, kind):
    m = re.match(rf"^- {kind}(\d+) ", line)
    return int(m.group(1)) if m else None


def next_mid(name):
    ids = [line_id(l, "m") for f in ("MEMORY.md", "archive.md") for l in read_disk(name, f) + read_head(name, f)]
    return max([i for i in ids if i] or [0]) + 1


def cite_records(name):
    try:
        return json.load(open(p(ROLES, name, "memory-cites.json")))
    except (OSError, ValueError):
        return []


def cite_summary(name):
    recs = cite_records(name)
    c, x = sum(len(r.get("confirmed", [])) for r in recs), sum(len(r.get("contradicted", [])) for r in recs)
    return {"records": len(recs), "confirmed": c, "contradicted": x}


def cite_counts(name):
    n = {}
    for rec in cite_records(name):
        for i in rec.get("confirmed", []) + rec.get("contradicted", []):
            n[i] = n.get(i, 0) + 1
    return n


def first_url(line):
    m = G.URL.search(line)
    return m.group(0).rstrip(".,;") if m else None


def archive_line(line, why, link):
    return f"{line} | archived {today().isoformat()}: {why}, {link}"


def cap_archive(name, mem, arch, keep_ids):
    """Over the 15-line cap: move the least-cited line (ties: the oldest id) not in keep_ids to arch."""
    cites = cite_counts(name)
    while len(G.mem_content("\n".join(mem))) > G.CAP_MEMORY_LINES:
        pool = [l for l in mem if line_id(l, "m") and f"m{line_id(l, 'm')}" not in keep_ids]
        if not pool:
            die("MEMORY.md is over its cap and nothing is left to archive")
        victim = min(pool, key=lambda l: (cites.get(f"m{line_id(l, 'm')}", 0), line_id(l, "m")))
        mem.remove(victim)
        arch.append(archive_line(victim, f"over the {G.CAP_MEMORY_LINES}-line cap (least cited)", first_url(victim) or "n/a"))
        print(f"cap: m{line_id(victim, 'm')} archived with this batch ({G.CAP_MEMORY_LINES}-line cap, least cited)")


def _check_worktree(name):
    r = subprocess.run([os.path.join(ENGINE_ROOT, "bin", "lib", "role-memory-check"), "--worktree", name], cwd=WS, capture_output=True, text=True)
    return r.stderr.strip()


def _write_all(name, mem, cand, arch):
    for f, lines in (("MEMORY.md", mem), ("candidates.md", cand), ("archive.md", arch)):
        write_lines(name, f, lines, existed_in_head=bool(read_head(name, f)) or f == "MEMORY.md")


def _propose(name, mem, cand, arch, keep_ids):
    """Write a proposed (uncommitted) memory state; undo it if the guard refuses."""
    before = {f: read_disk(name, f) for f in G.FILES}
    heads = {f: bool(read_head(name, f)) for f in G.FILES}
    in_head = set(read_head(name, "MEMORY.md"))
    keep_ids = set(keep_ids) | {f"m{line_id(l, 'm')}" for l in mem if line_id(l, "m") and l not in in_head}
    cap_archive(name, mem, arch, keep_ids)
    _write_all(name, mem, cand, arch)
    err = _check_worktree(name)
    if err:
        for f in G.FILES:
            write_lines(name, f, before[f], existed_in_head=heads[f] or f == "MEMORY.md")
        die("the guard refuses this proposal:\n" + err)


def cmd_promote(argv):
    name = argv[0] if argv else None
    need_role(name)
    pos = [a for i, a in enumerate(argv[1:], 1) if not a.startswith("--") and argv[i - 1] not in ("--link", "--trigger")]
    if len(pos) != 1 or not re.fullmatch(r"c?\d+", pos[0]):
        die("usage: bin/role promote <role> <cid> [--link URL2] [--trigger 2-links|1-link|correction]")
    cid = int(pos[0].lstrip("c"))
    if commit_candidates(name):  # the candidate must be in HEAD, or the guard cannot see where the line came from
        pass
    mem, cand, arch = read_disk(name, "MEMORY.md"), read_disk(name, "candidates.md"), read_disk(name, "archive.md")
    src = next((l for l in cand if line_id(l, "c") == cid), None)
    if not src:
        die(f"no candidate c{cid} in {MEM}/{name}/candidates.md")
    m = G.CAND_LINE.match(src)
    link, trig = _opt(argv, "--link"), _opt(argv, "--trigger")
    text = m.group(3)
    if link:
        text += f" ({link})"
    quotes = G.QUOTE.findall(text)
    urls = {u.rstrip(".,;") for u in G.URL.findall(text)}
    if trig is None:
        trig = "2-links" if (link or len(urls) >= 2) else ("1-link" if any(G.GENERAL.search(q) for q in quotes) else
                                       "correction" if G.CORRECTS.search(text) else None)
    if trig not in ("2-links", "1-link", "correction"):
        die("no trigger: pass --link URL2 (2 links), or the quote needs a generality word (1-link), or the line a `corrects m<N>` (correction)")
    if trig == "2-links" and len(urls) < 2:
        die("--trigger 2-links needs --link URL2: a second, different comment URL")
    if trig != "2-links":
        text += f" {trig}"
    new = f"- m{next_mid(name)} {m.group(2)}: {text}"
    cand.remove(src)
    mem.append(new)
    _propose(name, mem, cand, arch, {f"m{line_id(new, 'm')}"})
    print(f"proposed (uncommitted): {new}\nnext: bin/role batch {name}")


def cmd_archive(argv):
    name = argv[0] if argv else None
    need_role(name)
    pos = [a for i, a in enumerate(argv[1:], 1) if not a.startswith("--") and argv[i - 1] not in ("--because", "--reason")]
    because = _opt(argv, "--because")
    if len(pos) != 1 or not re.fullmatch(r"m\d+", pos[0]) or not because or not G.URL.fullmatch(because):
        die("usage: bin/role archive <role> <mN> --because <comment-url> [--reason TEXT]")
    if not hook_installed():
        die("memory guard not installed: bin/role install-hook")
    _guard_index(name)
    if pending(name):
        die(f"{name} has a memory diff waiting; accept or reject it first (archive commits at once and must not carry it)")
    mem, arch = read_head(name, "MEMORY.md"), read_head(name, "archive.md")
    victim = next((l for l in mem if line_id(l, "m") == int(pos[0][1:])), None)
    if not victim:
        die(f"no line {pos[0]} in the committed MEMORY.md")
    mem.remove(victim)
    arch.append(archive_line(victim, _opt(argv, "--reason", "the owner said it is wrong or unhelpful"), because))
    write_lines(name, "MEMORY.md", mem)
    write_lines(name, "archive.md", arch)
    paths = [f"{MEM}/{name}/MEMORY.md", f"{MEM}/{name}/archive.md"]
    git("add", "--", *paths)
    r = git("commit", "-q", "-m", f"role({name}): archive {pos[0]}", "--", *paths, check=False)
    if r.returncode:
        git("reset", "-q", "--", *paths, check=False)
        git("checkout", "--", *paths, check=False)
        die(f"archive refused: {(r.stderr or r.stdout).strip()[:400]}")
    print(f"role({name}): archive {pos[0]}")


def cmd_restore(argv):
    name = argv[0] if argv else None
    need_role(name)
    if len(argv) != 2 or not re.fullmatch(r"m\d+", argv[1]):
        die("usage: bin/role restore <role> <mN>")
    mem, cand, arch = read_disk(name, "MEMORY.md"), read_disk(name, "candidates.md"), read_disk(name, "archive.md")
    src = next((l for l in arch if line_id(l, "m") == int(argv[1][1:])), None)
    if not src:
        die(f"no line {argv[1]} in {MEM}/{name}/archive.md")
    arch.remove(src)
    new = src.split(" | archived ")[0]
    mem.append(new)
    _propose(name, mem, cand, arch, {argv[1]})
    print(f"proposed (uncommitted): restore {new}\nnext: bin/role batch {name}")



def _opt(argv, flag, default=None):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else default


def cmd_new(argv):
    name = argv[0] if argv and not argv[0].startswith("-") else None
    if not name or not NAME_RE.match(name):
        die("role name: lowercase letters, digits and dashes, e.g. backlog-owner")
    goal, mcmd, mdesc, budget = (_opt(argv, f) for f in ("--goal", "--metric-cmd", "--metric-desc", "--budget"))
    model = _opt(argv, "--model", "sonnet")
    missing = [f for f, v in (("--goal", goal), ("--metric-cmd", mcmd), ("--metric-desc", mdesc), ("--budget", budget)) if not v]
    if missing:
        die("no number, no role: " + ", ".join(missing) + " required")
    try:
        budget = float(budget)
        assert budget > 0
    except (ValueError, AssertionError):
        die("--budget is USD per month, > 0")
    if model not in ("sonnet", "opus", "haiku"):
        die("--model sonnet|opus|haiku")
    for path in (p(ROLES, name), p(AGENTS, name + ".md"), p(DISABLED, name + ".md")):
        if os.path.exists(path):
            die(f"{os.path.relpath(path, WS)} already exists")
    user_agent = os.path.expanduser(f"~/.claude/agents/{name}.md")
    if os.path.exists(user_agent) and not bb_env(None, "ROLE_WS", "SCH_ROLE_WS"):
        die(f"name collides with user-level agent {user_agent}; pick another name")
    tpl = open(os.path.join(HERE, "templates", "role-charter.md")).read()
    for k, v in {"name": name, "goal": goal, "model": model, "metric_command": mcmd, "workspace": OFFICE.display_name, "minutes_repo": REPO,
                 "metric_description": mdesc, "authority": "0"}.items():
        tpl = tpl.replace("{{" + k + "}}", v)
    os.makedirs(p(AGENTS), exist_ok=True)
    os.makedirs(p(ROLES, name))
    os.makedirs(p(MEM, name), exist_ok=True)
    open(p(AGENTS, name + ".md"), "w").write(tpl)
    open(p(MEM, name, "MEMORY.md"), "w").write(f"# {name} memory\n")
    open(p(ROLES, name, "product.md"), "w").write(
        f"# {name} — product brief\n\n> NOT WRITTEN YET. The user writes this file; the role never edits it.\n"
        "> Until it is written, the role says so and does not invent goals.\n\n"
        "## This quarter's goals\n\n## Who we build for\n\n## What we're deliberately not doing\n")
    cadence = _opt(argv, "--cadence-days")
    cbudget = _opt(argv, "--contractor-budget")
    cfg = {"name": name, "goal": goal, "model": model, "budget_usd_month": budget, "authority": 0,
           "cadence_days": int(cadence) if cadence else None,
           "contractor_budget_usd_month": float(cbudget) if cbudget else None,
           "metric": {"command": mcmd, "description": mdesc},
           "pilot": {"start": today().isoformat(), "weeks": 3, "uses": 6}, "issue": None}
    if "--no-issue" not in argv:
        subprocess.run(["gh", "label", "create", "role", "-R", REPO, "--color", "5319E7",
                        "--description", "A standing role: its hiring, reviews and disabling"], capture_output=True)
        body = (f"Standing role **{name}**: {goal}\n\n- Charter: `{AGENTS}/{name}.md`\n- Config: `{ROLES}/{name}/role.json` "
                f"(budget ${budget:.0f}/month, authority 0)\n- Owned metric: {mdesc}\n- Design: the busybody:standing-role skill\n\n"
                "Probation: 3 weeks / 6 uses, then keep / reshape / disable. Hiring, reviews, authority changes and "
                "disabling are recorded as comments here. Uses, ratings and cost are derived: `bin/role review " + name + "`.")
        r = subprocess.run(["gh", "issue", "create", "-R", REPO, "--label", "role", "--assignee", "@me",
                            "--title", f"Role: {name} — {goal}", "--body", body], capture_output=True, text=True)
        if r.returncode == 0:
            cfg["issue"] = int(r.stdout.strip().rsplit("/", 1)[-1])
        else:
            print(f"role: could not open the role issue: {r.stderr.strip()[:200]}", file=sys.stderr)
    save_cfg(name, cfg)
    print(f"created role {name}: {AGENTS}/{name}.md, {ROLES}/{name}/{{role.json,product.md}}, {MEM}/{name}/MEMORY.md"
          + (f", issue #{cfg['issue']}" if cfg["issue"] else ""))
    print(f"next: the user writes {ROLES}/{name}/product.md; review the charter; commit; `bin/role check`")


def _lifecycle_commit(name, paths, subj):
    """Commit only these paths. Callers run _guard_index before they touch anything."""
    live = [x for x in paths if os.path.exists(p(x)) or git("ls-files", "--", x).stdout.strip()
            or git("ls-tree", "HEAD", "--", x, check=False).stdout.strip()]
    git("add", "-A", "--", *[x for x in live if os.path.exists(p(x))])
    git("commit", "-q", "-m", subj, "--", *live)
    print(subj)


def _comment(cfg, body):
    if cfg.get("issue"):
        subprocess.run(["gh", "issue", "comment", str(cfg["issue"]), "-R", REPO, "--body", body], capture_output=True)


def cmd_keep(argv):
    name = argv[0] if argv else None
    cfg = need_role(name)
    _guard_index(name)
    cfg["kept_on"] = today().isoformat()
    save_cfg(name, cfg)
    _lifecycle_commit(name, [f"{ROLES}/{name}/role.json"], f"role({name}): kept after probation")
    _comment(cfg, f"Kept after probation ({cfg['kept_on']}). `bin/role review {name}` for the numbers.")


def cmd_disable(argv):
    name = argv[0] if argv else None
    cfg = need_role(name)
    reason = " ".join(argv[1:]).strip()
    if not reason:
        die("disable needs a reason: bin/role disable <role> <reason>")
    _guard_index(name)
    src, dst = f"{AGENTS}/{name}.md", f"{DISABLED}/{name}.md"
    if not os.path.exists(p(src)):
        die(f"{name} is already disabled")
    os.makedirs(p(DISABLED), exist_ok=True)
    tracked = bool(git("ls-files", "--", src).stdout.strip())
    if tracked:
        git("mv", src, dst)
    else:
        shutil.move(p(src), p(dst))
    cfg.update(disabled_on=today().isoformat(), disabled_reason=reason)
    cfg.pop("kept_on", None)
    save_cfg(name, cfg)
    total = cost(name)["total"]
    _lifecycle_commit(name, [src, dst, f"{ROLES}/{name}/role.json"], f"role({name}): disabled — {reason}")
    _comment(cfg, f"Disabled {cfg['disabled_on']}: {reason}. Total spend ${total:.2f} ({LABEL}). Memory kept in git, frozen.")


def cmd_enable(argv):
    name = argv[0] if argv else None
    cfg = need_role(name)
    src, dst = f"{DISABLED}/{name}.md", f"{AGENTS}/{name}.md"
    if not os.path.exists(p(src)):
        die(f"{name} is not disabled")
    _guard_index(name)
    os.makedirs(p(AGENTS), exist_ok=True)
    git("mv", src, dst)
    for k in ("disabled_on", "disabled_reason", "kept_on"):
        cfg.pop(k, None)
    cfg["pilot"] = dict(cfg.get("pilot") or {}, start=today().isoformat())
    save_cfg(name, cfg)
    _lifecycle_commit(name, [src, dst, f"{ROLES}/{name}/role.json"], f"role({name}): enabled, back on probation")
    _comment(cfg, f"Enabled again {today().isoformat()}; back on probation (3 weeks / 6 uses).")


def cmd_check(_argv):
    if hook_installed():
        print(f"memory guard installed: {hook_path()}")
        return
    print("memory guard NOT installed: run bin/role install-hook (the controller refuses to spawn a role without it)")
    sys.exit(1)


def cmd_install_hook(_argv):
    if git("config", "--get", "core.hooksPath", check=False).stdout.strip():
        die("core.hooksPath is set: the guard (and lead-start's pre-push seatbelt) would not run")
    hp = hook_path()
    os.makedirs(os.path.dirname(hp), exist_ok=True)
    if os.path.exists(hp) and not _ours(open(hp).read()):
        if os.path.exists(hp + ".chained"):
            die(f"{hp} and {hp}.chained both exist; resolve by hand")
        shutil.move(hp, hp + ".chained")
        print(f"NOTE: existing pre-commit hook moved to {hp}.chained; the guard chains to it")
    shutil.copy(os.path.join(HERE, "bin", "lib", "pre-commit-role-memory"), hp)
    os.chmod(hp, 0o755)
    print(f"installed {hp}")


# ---- self-test -----------------------------------------------------------------------------

def _charter_body(name):
    txt = open(p(AGENTS, name + ".md"), encoding="utf-8").read()
    return re.sub(r"\A---\n.*?\n---\n", "", txt, count=1, flags=re.S).strip()


def _memory_text(name):
    """What a subagent would have injected: the first 200 lines / 25 KB of MEMORY.md."""
    try:
        txt = open(p(MEM, name, "MEMORY.md"), encoding="utf-8", errors="replace").read()
    except OSError:
        return "(empty: you have no memory yet)"
    return "\n".join(txt.splitlines()[:200])[:25 * 1024].strip() or "(empty: you have no memory yet)"


def _session_name(role, task):
    slug = re.sub(r"[^a-z0-9]+", "-", task.lower()).strip("-")[:30].strip("-") or "pass"
    taken = {a.get("name") for a in agents_list()}
    name, n = f"role-{role}-{slug}", 1
    while name in taken:
        n += 1
        name = f"role-{role}-{slug}-{n}"
    return name


def _trusted():
    try:
        d = json.load(open(os.path.expanduser("~/.claude.json")))
    except (OSError, ValueError):
        d = {}
    return (d.get("projects", {}).get(WS, {}) or {}).get("hasTrustDialogAccepted") is True


def _fill(template, values):
    return re.sub(r"\{\{([A-Z_]+)\}\}", lambda m: str(values[m.group(1)]), template)


# Authority level 1 (owner, 2026-10-08, #7): after the owner's all-clear the role writes the card
# description and sets the Ready label itself. Only those two tracker writes open up (office.json tracker.authorityAllow).
def _role_settings(session, authority=0, team="", tracker=None):
    tracker = tracker or TRACKER
    room = json.load(open(e("templates", "room-settings.json")))
    extra = json.load(open(e("templates", "role-settings.json")))
    extra_deny = [x for d in extra["deny"] for x in (tracker.write_deny if d == "{{tracker.writeDeny}}" else [d])]
    deny = list(room["permissions"]["deny"]) + list(room.get("_unlessProdRead", [])) + extra_deny
    perms = {"deny": deny}
    if int(authority or 0) >= 1:
        undeny, allow = tracker.level(1)
        perms = {"deny": [d for d in deny if d not in undeny]}
        if allow:
            perms["allow"] = allow
    if team:  # a power the recipe does not grant is denied, not just left out of the allow list
        t = json.load(open(p("teams", team, "team.json")))
        if not t["draftPr"]:
            perms["deny"] = perms["deny"] + ["Bash(gh pr create*)"]
        if not t["land"]:
            perms["deny"] = perms["deny"] + ["Bash(*bin/land*)"]
    env = dict(extra.get("env", {}), COMPOSE_PROJECT_NAME=session)
    return {"env": env, "permissions": perms}


def _pass_label(name):
    return "refine" if name == "analyst" else f"{name}-pass"


def _open_pass_issue(name, task, session, role_issue):
    """One issue per pass: its minutes are the pass's evidence. Returns (number, url) or dies."""
    label = _pass_label(name)
    subprocess.run(["gh", "label", "create", label, "-R", REPO, "--color", "BFD4F2",
                    "--description", f"A {name} staff-room pass: its minutes are the evidence"], capture_output=True)
    body = (f"**NOTE** · bin/role · #{role_issue}\n{name} pass: {task}\n\n"
            f"- Task: {task}\n- Session: `{session}`\n"
            f"- Role issue (personnel file): https://github.com/{REPO}/issues/{role_issue}\n\n"
            "The pass posts its `DECISION` / `ANSWER` / `DONE` minutes here. Resolve closes it.")
    r = subprocess.run(["gh", "issue", "create", "-R", REPO, "--label", label, "--assignee", "@me",
                        "--title", f"{name}: {task}", "--body", body], capture_output=True, text=True)
    url = (r.stdout or "").strip().splitlines()[-1] if r.returncode == 0 and (r.stdout or "").strip() else ""
    if not url.rsplit("/", 1)[-1].isdigit():
        die(f"could not open the pass issue: {(r.stderr or r.stdout).strip()[:200]}")
    num = int(url.rsplit("/", 1)[-1])
    subprocess.run(["gh", "issue", "comment", str(role_issue), "-R", REPO, "--body",
                    f"**RECORD** · bin/role · #{role_issue}\n{name} pass opened: {url}"], capture_output=True)
    return num, url


def cmd_run(argv):
    """Start one on-demand background session for a role. It ends when the pass is done."""
    dry, show = "--dry-run" in argv, "--show-brief" in argv
    liaison = _opt(argv, "--controller" if "--controller" in argv else "--liaison", bb_env(None, "CONTROLLER", "SCH_LIAISON_SESSION"))
    team = _opt(argv, "--team", "")
    valued = ("--liaison", "--controller", "--team")
    skip = {i for i, a in enumerate(argv) if a in valued} | {i + 1 for i, a in enumerate(argv) if a in valued}
    pos = [a for i, a in enumerate(argv) if i not in skip and not a.startswith("--")]
    if len(pos) < 2:
        die("usage: bin/role run <role> <task…> [--controller NAME] [--team NAME] [--dry-run [--show-brief]]")
    name, task = pos[0], " ".join(pos[1:])
    cfg = need_role(name)
    if not os.path.exists(p(AGENTS, name + ".md")):
        die(f"{name} is disabled: bin/role enable {name} first")
    if not liaison:
        die("controller session name required: --controller NAME or BUSYBODY_CONTROLLER")
    if not hook_installed():
        die("the memory guard is not installed: run bin/role install-hook")
    if not dry:
        commit_candidates(name)
    issue = cfg.get("issue")
    if not issue and not dry:
        die(f"{name} has no issue in role.json: its sticky notes need an issue")
    team_powers = ""
    if team:  # the recipe's powers go into the brief itself, like a room lead's
        r = subprocess.run([e("bin", "team"), "powers", team], capture_output=True, text=True, env=dict(os.environ, BUSYBODY_WORKSPACE=WS))
        if r.returncode:
            die(f"cannot render the powers of recipe {team}: {(r.stderr or r.stdout).strip()[:200]}")
        team_powers = "\n" + r.stdout.rstrip("\n")
    session = _session_name(name, task)
    role_issue = issue
    if dry:
        issue, issue_url = None, f"(pass issue \"{name}: {task}\", label {_pass_label(name)}: opened at launch, one per pass)"
    else:
        issue, issue_url = _open_pass_issue(name, task, session, role_issue)
        print(f"pass issue #{issue}: {issue_url}")
    brief = _fill(open(e("templates", "role-brief.md")).read(), {
        "ROLE": name, "SESSION": session, "TASK": task, "TODAY": today().isoformat(), "ISSUE_URL": issue_url,
        "ISSUE_NUM": issue or "N", "ROLE_ISSUE": role_issue or "N", "ISSUE_REPO": REPO, "LIAISON": liaison, "WS": WS, "ENGINE": ENGINE_ROOT,
        "AUTHORITY": f"level {cfg.get('authority', 0)}", "BUDGET": f"{cfg.get('budget_usd_month') or 0:g}",
        "CBUDGET": f"{cfg.get('contractor_budget_usd_month') or 0:g}",
        "TEAM_POWERS": team_powers, "CHARTER": _charter_body(name), "MEMORY": _memory_text(name)})
    settings_path = p(".claude", "role-sessions", session + ".json")
    model = cfg.get("model", "sonnet")
    cmd = ["claude", "--bg", "-n", session, "--model", model, "--permission-mode", "auto", "--settings", settings_path, brief]
    if dry:
        print(f"DRY RUN: nothing is written or launched.\nrole:      {name} ({model}, authority {cfg.get('authority', 0)})\n"
              f"session:   {session}\nissue:     {issue_url}\ncwd:       {WS} (trusted: {'yes' if _trusted() else 'NO: run `cd ' + WS + ' && claude` once'})\n"
              f"settings:  {settings_path} ({len(_role_settings(session, cfg.get('authority', 0), team)['permissions']['deny'])} deny rules)\n"
              f"brief:     {len(brief)} chars; charter + {len(_memory_text(name).splitlines())} memory line(s) imported\n"
              f"launch:    claude --bg -n {session} --model {model} --permission-mode auto --settings <settings> '<brief>'")
        if show:
            print("\n----- brief -----\n" + brief)
        return
    if not _trusted():
        die(f"{WS} is not trusted by Claude Code yet. Ask the user to run `cd {WS} && claude` once and accept the dialog; this never edits ~/.claude.json")
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    with open(settings_path, "w") as f:
        json.dump(_role_settings(session, cfg.get('authority', 0), team), f, indent=2)
    stamp = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    r = subprocess.run(cmd, cwd=WS, capture_output=True, text=True)
    if r.returncode:
        subprocess.run(["gh", "issue", "close", str(issue), "-R", REPO, "--comment",
                        f"**BLOCKED** · bin/role · #{issue}\nlaunch failed; pass not started"], capture_output=True)
        die(f"claude --bg failed: {(r.stderr or r.stdout).strip()[:300]}")
    print(f"launched {session}")
    import time
    for _ in range(36):
        time.sleep(5)
        g = subprocess.run(["gh", "issue", "view", str(issue), "-R", REPO, "--json", "comments"], capture_output=True, text=True)
        try:
            cs = json.loads(g.stdout)["comments"]
        except (ValueError, KeyError):
            continue
        if any(c["createdAt"] >= stamp and c["body"].startswith("PROGRESS:") and session in c["body"] for c in cs):
            print(f"role session online: first PROGRESS: comment seen on {issue_url}")
            return
    logs = subprocess.run(["claude", "logs", session], capture_output=True, text=True).stdout.splitlines()[-40:]
    sys.stderr.write(f"!!! no PROGRESS: comment from {session} within 180s on {issue_url}.\n"
                     "!!! It may be waiting on a trust or permission prompt. Do NOT answer it for the user: report it.\n" + "\n".join(logs) + "\n")
    sys.exit(2)


def _wt_guard(sh, ws):
    return sh(os.path.join(ws, 'engine', 'bin', 'lib', 'role-memory-check'), '--worktree', 'test-role')


def self_test():
    ok = True

    def expect(label, cond):
        nonlocal ok
        ok &= bool(cond)
        print(f"  {'PASS' if cond else 'FAIL'}  {label}")

    tmp = tempfile.mkdtemp(prefix="role-selftest-")
    try:
        ws = os.path.join(tmp, "ws")
        for d in ("bin/lib", "templates"):
            os.makedirs(os.path.join(ws, "engine", d))
        for f in ("bin/role", "bin/lib/role-memory-check", "bin/lib/pre-commit-role-memory", "bin/lib/costlib.py", "bin/lib/officeroot.py", "bin/lib/officeconfig.py", "bin/lib/tracker.py", "bin/lib/kitlib.py", "bin/lib/deskskills.py", "bin/lib/sessions.py",
                  "templates/role-charter.md", "templates/prices.json", "templates/role-brief.md", "templates/role-settings.json",
                  "templates/room-settings.json"):
            shutil.copy2(os.path.join(HERE, f), os.path.join(ws, "engine", f))
        env = dict(os.environ, BUSYBODY_ROLE_WS=ws, BUSYBODY_CLAUDE_PROJECTS=os.path.join(HERE, "fixtures", "roles", "projects"),
                   BUSYBODY_ROLE_AGENTS_JSON=os.path.join(HERE, "fixtures", "roles", "agents.json"),
                   GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")

        def sh(*a, **kw):
            return subprocess.run(list(a), cwd=ws, env=env, capture_output=True, text=True, **kw)

        def role(*a):
            return sh(os.path.join(ws, "engine", "bin", "role"), *a)

        r = subprocess.run([os.path.join(HERE, "bin", "lib", "role-memory-check"), "--self-test"], capture_output=True, text=True)
        print(r.stdout.rstrip())
        expect("guard unit tests (bin/lib/role-memory-check --self-test)", r.returncode == 0)
        sh("git", "init", "-q", "-b", "main")
        sh("git", "commit", "-q", "--allow-empty", "-m", "init")
        expect("check fails before install", role("check").returncode == 1)
        expect("install-hook", role("install-hook").returncode == 0 and role("check").returncode == 0)
        expect("new refuses without a metric", role("new", "test-role", "--goal", "g", "--budget", "5", "--no-issue").returncode != 0)
        r = role("new", "test-role", "--goal", "keep the test backlog healthy", "--metric-cmd", "echo 1",
                 "--metric-desc", "cards ready", "--budget", "5", "--no-issue")
