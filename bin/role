        gp = json.loads(role("cost", "general-purpose", "--json").stdout)["roles"]["general-purpose"]
        expect(f"contractors not counted under general-purpose (got ${gp['total']}, expect ${exp['general_purpose_total']})",
               abs(gp["total"] - exp["general_purpose_total"]) < 1e-6)
        expect(f"drafts from trailers (got {st['drafts']})", st["drafts"] == {"approved": 3, "unedited": 2})
        r = role("disable", "test-role", "not", "providing", "value")
