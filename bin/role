               and "- c2 " not in open(cpath).read() and sh("git", "status", "--porcelain").stdout.strip() != "")
        expect("promote refused when the second link is the same", role("promote", "test-role", "c4", "--link", cu(4)).returncode != 0)
        r = role("promote", "test-role", "c3")
        expect("promote infers 1-link from a generality word", r.returncode == 0 and any(l.startswith("- m3 ") and l.endswith(" 1-link") for l in mem_lines()))
        expect("promote of a missing candidate is refused", role("promote", "test-role", "c99").returncode != 0)
        sh("git", "checkout", "--", MEM)
