        st = json.loads(role("status", "--json").stdout)["roles"][0]
        expect("status says disabled", st["status"] == "disabled" and st["disabled_reason"] == "not providing value")
        expect("enable restores it on probation", role("enable", "test-role").returncode == 0
               and json.loads(role("status", "--json").stdout)["roles"][0]["status"] == "probation")
        # role sessions: bin/role run
        r = role("run", "test-role", "refine", "card", "#42!", "--controller", "controller-x", "--dry-run", "--show-brief")
        out = r.stdout
        expect(f"run --dry-run names the session by role and task (rc {r.returncode})", r.returncode == 0 and "session:   role-test-role-refine-card-42" in out)
        expect("brief imports the charter without its frontmatter", "keep the test backlog healthy" in out and "\nmodel: sonnet\nmemory: project" not in out and "description:" not in out.split("# Your charter")[1])
        expect("brief imports MEMORY.md", "frost alerts" in out)
        expect("brief makes the role ask on its issue and hear the answers",
               "ANSWER (from the user)" in out and "one `DECISION:` comment" in out and "end your turn and wait" in out)
        expect("brief names the workers <role>-c-*", "test-role-c-<task>" in out)
        expect("brief forbids committing or accepting memory", "Never commit, stage or push" in out and "bin/role accept" in out)
        expect("no unfilled placeholders", "{{" not in out)
        expect("without --team the brief has no team powers", "Team: " not in out and "**Team:" not in out)
        os.makedirs(os.path.join(ws, "teams"))
        shutil.copy2(os.path.join(HERE, "bin", "team"), os.path.join(ws, "engine", "bin", "team"))
        shutil.copytree(os.path.join(HERE, "fixtures", "teams", "dev-team"), os.path.join(ws, "teams", "dev-team"))
        rt = role("run", "test-role", "refine", "card", "--controller", "controller-x", "--team", "dev-team", "--dry-run", "--show-brief")
