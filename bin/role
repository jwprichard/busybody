                   {"name": "role-test-role-old2", "sessionId": "s2", "cwd": "/fixture/ws", "state": "blocked"}], open(two, "w"))
        ps = os.path.join(tmp, "ps.jsonl")
        with open(ps, "w") as f:
            f.write(json.dumps({"pid": 7001, "argv": ["claude", "bg-spare", "--bg-spare", "/tmp/x.sock"]}) + "\n")
        r = subprocess.run([os.path.join(ws, "engine", "bin", "role"), "run", "test-role", "x", "--liaison", "l", "--dry-run"], cwd=ws,
                           env=dict(env, BUSYBODY_ROLE_AGENTS_JSON=two, BUSYBODY_PS_FILE=ps), capture_output=True, text=True)
        expect("a second pass launches while one runs, and with a memory diff waiting (parallel passes)", r.returncode == 0 and "session:   role-test-role-x" in r.stdout)
        globals()["_AGENTS"] = [{"name": "role-test-role-x"}]
        expect("a second pass with the same task gets its own session name", _session_name("test-role", "x") == "role-test-role-x-2")
        globals()["_AGENTS"] = None
        sh("git", "checkout", "--", MEM)
        expect("run needs a controller", role("run", "test-role", "x", "--dry-run").returncode != 0)
        expect("run refuses a disabled role", (role("disable", "test-role", "t").returncode == 0
               and role("run", "test-role", "x", "--liaison", "l", "--dry-run").returncode != 0
               and role("enable", "test-role").returncode == 0))
        deny = json.load(open(os.path.join(HERE, "templates", "role-settings.json")))["deny"]
        expect("role settings deny git writes and accepting memory", "Bash(git commit*)" in deny and "Bash(*bin/role accept*)" in deny)
        card = Tracker({"type": "acme", "cardUrlRegex": r"https://tasks\.acme\.test/t/(\d+)", "get": "acme-tasks get {id}",
                        "writeDeny": ["Bash(acme-tasks set*)", "Bash(acme-tasks archive*)"],
                        "authorityAllow": {"1": {"undeny": ["Bash(acme-tasks set*)"], "allow": ["Bash(acme-tasks set x*)"]}}})
        l0, l1 = _role_settings("x", 0, tracker=card)["permissions"], _role_settings("x", 1, tracker=card)["permissions"]
        expect("authority 0 denies tracker writes; 1 opens only what the tracker lists",
               "Bash(acme-tasks set*)" in l0["deny"] and "allow" not in l0
               and "Bash(acme-tasks set*)" not in l1["deny"] and "Bash(acme-tasks archive*)" in l1["deny"]
               and l1["allow"] == ["Bash(acme-tasks set x*)"] and "Bash(git commit*)" in l1["deny"])
        none = Tracker({"type": "none"})
        n0, n1 = _role_settings("x", 0, tracker=none)["permissions"], _role_settings("x", 1, tracker=none)["permissions"]
        expect("tracker none: no tracker patterns, no allow, the rest still denied",
               not any("acme-tasks" in d or "{{" in d for d in n0["deny"] + n1["deny"]) and "allow" not in n1 and "Bash(git commit*)" in n1["deny"])
        # memory lifecycle: promote / archive / restore
        sh("git", "checkout", "--", MEM)
        cpath = os.path.join(ws, MEM, "test-role", "candidates.md")
        apath = os.path.join(ws, MEM, "test-role", "archive.md")
        cu = lambda i: f"https://github.com/acme-co/acme-office/issues/7#issuecomment-{100 + i}"

        def cline(n, quote="the owner said so", url=None, when=None):
            return (f'- c{n} {when or today().isoformat()}: Lesson {n}. Changes: ask question {n} first. "{quote}" ({url or cu(n)})')

        def set_cands(*lines):
            with open(cpath, "w") as f:
                f.write("# candidates\n" + "".join(l + "\n" for l in lines))
            sh("git", "add", "-A")
            return sh("git", "commit", "-q", "-m", "candidates").returncode == 0

        def mem_lines():
            return [l for l in open(mem).read().splitlines() if l.startswith("- m")]

        expect("candidates commit through the guard", set_cands(cline(2), cline(3, "never skip the repro"), cline(4), cline(5)))
        r = role("promote", "test-role", "c2")
