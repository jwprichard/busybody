        sh("git", "add", "-A")
        expect("scaffold commits through the guard", sh("git", "commit", "-q", "-m", "scaffold").returncode == 0)
        mem = os.path.join(ws, MEM, "test-role", "MEMORY.md")

        def write(text):
            with open(mem, "a") as f:
                f.write(text + "\n")

        u1, u2 = "https://github.com/acme-co/acme-office/issues/7#issuecomment-1", "https://github.com/acme-co/acme-office/issues/7#issuecomment-2"
        cands = os.path.join(ws, MEM, "test-role", "candidates.md")
        with open(cands, "w") as f:
            f.write(f'- c1 2026-10-06: The owner ranks frost alerts above reporting. Changes: rank frost alerts first. "frost before reports" ({u1})\n')
        sh("git", "add", "-A")
        expect("candidates commit through the guard", sh("git", "commit", "-q", "-m", "candidates").returncode == 0)
        write(f'- m1 2026-10-06: The owner ranks frost alerts above reporting. Changes: rank frost alerts first. "frost before reports" ({u1}) ({u2})')
        expect("diff shows the change", "frost alerts" in role("diff", "test-role").stdout)
        expect("accept a good line", role("accept", "test-role", "--rating", "saved-time", "--drafts", "approved=3,unedited=2").returncode == 0)
        expect("--drafts rejects unedited > approved", role("accept", "test-role", "--drafts", "approved=1,unedited=2").returncode != 0)
        write("- the user likes short cards")
        expect("accept rejects a line with no date or link", role("accept", "test-role").returncode != 0)
        expect("reject restores memory", role("reject", "test-role", "--rating", "no-value").returncode == 0
               and "short cards" not in open(mem).read() and "frost alerts" in open(mem).read())
        write(f"- m2 2026-10-06: account 123456789012 owns the bucket (#7) {u1}")
        expect("guard blocks a 12-digit ID", role("accept", "test-role").returncode != 0)
        role("reject", "test-role")
        write(f"- m2 2026-10-06: see acme-db.abc123.ap-southeast-2.rds.amazonaws.com (#7) {u1}")
        expect("guard blocks an AWS hostname", role("accept", "test-role").returncode != 0)
        role("reject", "test-role")
        write(f"- m2 2026-10-06: filler (#7) {u1} " + "x" * 9000)
        expect("guard blocks MEMORY.md over 8 KB", role("accept", "test-role").returncode != 0)
        role("reject", "test-role")
        with open(os.path.join(ws, MEM, "test-role", "notes.json"), "w") as f:
            f.write("{}")
        expect("guard blocks non-.md memory", role("accept", "test-role").returncode != 0)
        role("reject", "test-role")
        expect("reject removes new untracked files", not os.path.exists(os.path.join(ws, MEM, "test-role", "notes.json")))
        st = json.loads(role("status", "--json").stdout)["roles"][0]
        expect(f"uses derived from commits (got {st['use_count']}, expect 6)", st["use_count"] == 6)
        expect(f"ratings from trailers (got {st['ratings']})", st["ratings"] == {"saved-time": 1, "useful": 0, "no-value": 1})
        expect(f"rejected uses counted (got {st['memory_rejected']}, expect 5)", st["memory_rejected"] == 5)
        exp = json.load(open(os.path.join(HERE, "fixtures", "roles", "expected.json")))
        expect(f"cost attributed by spawnedAgentType and session name (got ${st['cost']['total']}, {st['cost']['spawns']} spawns; "
               f"expect ${exp['total']}, {exp['spawns']})",
