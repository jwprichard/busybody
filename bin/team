#!/usr/bin/python3 -I
"""Team recipes: validate, launch and resolve (docs/team-recipes.md is the spec).

  bin/team check [name…]    validate teams/*/ (all by default); one line per recipe; non-zero on any failure
  bin/team powers <recipe> [--land] [--desks]
                            the powers text for a launch brief, from the recipe's flags (--desks: name each desk's `desks:<team>-<desk>` agent type)
  bin/team brief <recipe> commit|prs|prlimit [--land]
                            the recipe-dependent lines of the room lead's brief (@BRANCH@ stands for the room's branch)
  bin/team start <recipe> <initiative|"task"> [--repo R] [--base REF] [--controller NAME] [--dry-run]
                            open the room: a project room through the lead launcher, a staff room through the role launcher (`role run <role> --issue N`, so it needs an initiative)
                            (initiative = N, #N or an issue URL of the workspace repo; anything else is a free-text task)
                            TEAM_LEAD_START and TEAM_ROLE_RUN name the launchers (default: the real scripts), TEAM_GH the gh command
  bin/team resolve <initiative> [--check NAME] [--room NAME] [--close] [--no-close]
                            run the recipe's done check (or NAME) against the issue: PASS / FAIL with the evidence it found.
                            --room NAME is needed for an issue with no Room block (a staff pass): only a DONE minute whose who is
                            exactly that name counts, and an old-style `DONE:` never does. A `--room role-…` (a role pass on an initiative) is used even when the issue
                            has a Room block, and its resolve leaves that initiative open; only a legacy pass issue (no Room block, titled
                            `<role>: <task>`, labelled `refine` or `<role>-pass`) is closed, with its RECORD, as before. Exit 0 pass, 1 fail, 2 cannot decide.
                            After a PASS it posts a `**RECORD**` minute (the check and its evidence) and closes the issue as completed, through
                            `gh issue close` and, if that errors (Projects classic), `gh api`. It never closes on FAIL/UNDECIDED, an issue
                            labelled `project`, or one with open sub-issues (it says why); an already-closed issue passes with no second minute.
                            --no-close skips the comment and the close. BUSYBODY_CONTROLLER names the minute's who (default: controller).
                            With --close, after a PASS it also runs `claude stop <room>` and then ends the room's own process (the claude binary with `-n <room>`,
                            SIGTERM, SIGKILL only if ignored; TEAM_CLAUDE names the claude command), which `claude stop` can miss.
                            Checks: pr-merged verdict-posted ready-card report-posted landed card-has-design-link.
                            TEAM_GH, TEAM_GIT and TEAM_TRACKER name the gh, git and tracker commands (TEAM_TRELLO is read too); TEAM_REPOS_DIR the clones' parent
  bin/team --self-test      one fixture case per rule, in a temp dir (never the real teams/)

A recipe is teams/<name>/SKILL.md (judgement) plus teams/<name>/team.json (what the harness enforces).
"""
import json, os, re, shlex, subprocess, sys, tempfile

ENGINE_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ENGINE_ROOT, "bin", "lib"))
from officeroot import invoked_root, workspace_root, bb_env, selftest_reexec  # noqa: E402
selftest_reexec(ENGINE_ROOT)
WORKSPACE_ROOT = workspace_root(ENGINE_ROOT, invoked=invoked_root())
import officeconfig  # noqa: E402
import kitlib  # noqa: E402
import deskskills  # noqa: E402
from tracker import Tracker, TrackerError  # noqa: E402
OFFICE = officeconfig.load_or_exit(WORKSPACE_ROOT, "team")
TRACKER = Tracker(OFFICE.tracker)
REPO = OFFICE.minutes_repo

KEYS = ("name", "purpose", "room", "head", "desks", "entry", "phases", "output", "done",
        "worktree", "draftPr", "land", "caps", "measures")
MODELS = ("sonnet", "opus", "haiku")
HEAD_MODELS = ("sonnet", "opus")
OPTIONAL = ("designSystem", "canvas")
ROOMS = ("project", "staff")
OUTPUT_CHECK = {"verdict": "verdict-posted", "merged-pr": "pr-merged", "ready-card": "ready-card",
                "report": "report-posted", "landed-branch": "landed",
                "approved-design": "card-has-design-link"}
DESK_KEYS = ("name", "model", "max", "readOnly", "phase", "skills")


def die(msg, code=1):
    sys.stderr.write(f"team: {msg}\n")
    sys.exit(code)


def _str(v):
    return isinstance(v, str) and v.strip() != ""


def _int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _strlist(v):
    return isinstance(v, list) and all(_str(x) for x in v)


def frontmatter_name(path):
    try:
        text = open(path).read()
    except OSError:
        return None
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    if not m:
        return None
    n = re.search(r"^name:\s*(\S+)\s*$", m.group(1), re.M)
    return n.group(1) if n else None


def validate(root, name):
    """Return a list of problems for teams/<name>/ under root (empty = valid) and the recipe (or None)."""
    d = os.path.join(root, "teams", name)
    errs = []
    path = os.path.join(d, "team.json")
    try:
        t = json.load(open(path))
    except OSError:
        return [f"teams/{name}/team.json is missing"], None
    except ValueError as e:
        return [f"team.json is not valid JSON ({e})"], None
    if not isinstance(t, dict):
        return ["team.json is not an object"], None
    for k in KEYS:
        if k not in t:
            errs.append(f"missing key {k}")
    for k in t:
        if k not in KEYS and k not in OPTIONAL:
            errs.append(f"unknown key {k}")
    if "designSystem" in t and not (_str(t["designSystem"]) and t["designSystem"].startswith("https://")):
        errs.append("designSystem must be an https URL")
    if "canvas" in t:
        c = t["canvas"]
        if not isinstance(c, dict) or set(c) != {"type", "onePerCard"} or not _str(c.get("type")) or not isinstance(c.get("onePerCard"), bool):
            errs.append("canvas must be {type: string, onePerCard: boolean}")
    if "name" in t:
        if not _str(t["name"]):
            errs.append("name must be a non-empty string")
        elif t["name"] != name:
            errs.append(f"name {t['name']!r} is not the directory name {name!r}")
    if "purpose" in t and not _str(t["purpose"]):
        errs.append("purpose must be a non-empty string")
    room = t.get("room")
    if "room" in t and room not in ROOMS:
        errs.append("room must be project or staff")
    head = t.get("head")
    if "head" in t:
        if not isinstance(head, dict) or set(head) != {"role", "model"}:
            errs.append("head must be {role, model}")
        else:
            if head["model"] not in HEAD_MODELS:   # the lead launcher accepts only these
                errs.append("head.model must be sonnet or opus")
            if not _str(head["role"]):
                errs.append("head.role must be a non-empty string")
            elif room == "project" and head["role"] != "room-lead":
                errs.append("a project room's head is room-lead")
            elif room == "staff" and not os.path.isfile(os.path.join(root, "roles", head["role"], "role.json")):
                errs.append(f"staff head {head['role']!r} has no roles/{head['role']}/role.json")
    if "desks" in t:
        desks = t["desks"]
        if not isinstance(desks, list):
            errs.append("desks must be a list")
        else:
            seen = set()
            for i, dk in enumerate(desks):
                if not isinstance(dk, dict):
                    errs.append(f"desks[{i}] must be an object")
                    continue
                for k in dk:
                    if k not in DESK_KEYS:
                        errs.append(f"desks[{i}] has unknown key {k}")
                if not _str(dk.get("name")):
                    errs.append(f"desks[{i}].name must be a non-empty string")
                elif dk["name"] in seen:
                    errs.append(f"duplicate desk name {dk['name']}")
                else:
                    seen.add(dk["name"])
                if dk.get("model") not in MODELS:
                    errs.append(f"desks[{i}].model must be sonnet, opus or haiku")
                if not _int(dk.get("max")) or dk["max"] < 1:
                    errs.append(f"desks[{i}].max must be a positive integer")
                if "readOnly" in dk and not isinstance(dk["readOnly"], bool):
                    errs.append(f"desks[{i}].readOnly must be a boolean")
                if "phase" in dk and not (isinstance(t.get("phases"), list) and dk["phase"] in t["phases"]):
                    errs.append(f"desks[{i}].phase must be one of the recipe's phases")
                if "skills" in dk:
                    errs.extend(deskskills.shape_errors(dk["skills"], f"desks[{i}]"))
            if not errs:   # the skills' sources and clones, against this workspace's office.json
                errs.extend(deskskills.recipe_problems(officeconfig.load(root, {}), [d for d in desks if "skills" in d])[0])
    for k in ("entry", "phases"):
        if k in t and (not _strlist(t[k]) or not t[k]):
            errs.append(f"{k} must be a non-empty list of non-empty strings")
    if "measures" in t and not _strlist(t["measures"]):
        errs.append("measures must be a list of non-empty strings")
    out, done = t.get("output"), t.get("done")
    if "output" in t and out not in OUTPUT_CHECK:
        errs.append("output must be one of " + ", ".join(OUTPUT_CHECK))
    if "done" in t:
        if not isinstance(done, dict) or set(done) != {"check"} or not _str(done.get("check")):
            errs.append("done must be {check}")
        elif out in OUTPUT_CHECK and done["check"] != OUTPUT_CHECK[out]:
            errs.append(f"output {out} pairs with done.check {OUTPUT_CHECK[out]}, not {done['check']}")
    for k in ("worktree", "draftPr", "land"):
        if k in t and not isinstance(t[k], bool):
            errs.append(f"{k} must be a boolean")
    if t.get("draftPr") is True and out in OUTPUT_CHECK and out != "merged-pr":
        errs.append("only a merged-pr recipe may open draft PRs")
    if t.get("land") is True and out in OUTPUT_CHECK and out != "landed-branch":
        errs.append("only a landed-branch recipe may land")
    if "caps" in t:
        c = t["caps"]
        if not isinstance(c, dict) or set(c) != {"softUsdPerDay", "hardUsdPerDay"}:
            errs.append("caps must be {softUsdPerDay, hardUsdPerDay}")
        elif not (_num(c["softUsdPerDay"]) and _num(c["hardUsdPerDay"])) or c["softUsdPerDay"] <= 0 or c["hardUsdPerDay"] <= 0:
            errs.append("caps must be positive numbers")
        elif c["softUsdPerDay"] > c["hardUsdPerDay"]:
            errs.append("caps: soft must not exceed hard")
    fm = frontmatter_name(os.path.join(d, "SKILL.md"))
    if not os.path.isfile(os.path.join(d, "SKILL.md")):
        errs.append("SKILL.md is missing")
    elif fm != name:
        errs.append(f"SKILL.md frontmatter name {fm!r} is not {name!r}")
    return errs, t


def recipe_names(root):
    base = os.path.join(root, "teams")
    if not os.path.isdir(base):
        return []
    return sorted(n for n in os.listdir(base) if os.path.isdir(os.path.join(base, n)))


def summary(t):
    return (f"{t['room']:<7} {t['output']:<13} done:{t['done']['check']:<14} head={t['head']['role']}/{t['head']['model']}"
            f" desks={len(t['desks'])} wt={'y' if t['worktree'] else 'n'} draft={'y' if t['draftPr'] else 'n'}"
            f" land={'y' if t['land'] else 'n'}")


def desks_drift(root):
    """Problems between <root>/desks/ and what bin/kit would generate; [] when desks/ is absent (a workspace that never ran kit)."""
    d = os.path.join(root, "desks")
    if not os.path.isdir(d):
        return []
    recipes = []
    for n in recipe_names(root):
        errs, t = validate(root, n)
        if errs:
            return []   # the recipe's own FAIL line says why; drift cannot be judged
        recipes.append(t)
    tpl = open(os.path.join(ENGINE_ROOT, "templates", "desk.md")).read()
    try:
        files, skipped = deskskills.render_desks(recipes, tpl, officeconfig.load(root, {}), lenient=True)
    except deskskills.SkillError as e:
        return [str(e)]
    return kitlib.drift(d, files, skipped)


def check(root, names):
    all_recipes = not names
    names = names or recipe_names(root)
    if not names:
        print("team check: no recipes found", file=sys.stderr)
        return 1
    bad = 0
    for n in names:
        if not os.path.isdir(os.path.join(root, "teams", n)):
            print(f"FAIL {n}: no such recipe")
            bad += 1
            continue
        errs, t = validate(root, n)
        if errs:
            bad += 1
            print(f"FAIL {n}: " + "; ".join(errs))
        else:
            print(f"ok   {n:<14} {summary(t)}")
            for w in deskskills.recipe_problems(officeconfig.load(root, {}), t["desks"])[1]:
                print(f"warn {n}: {w}")
    if all_recipes and not bad:
        drift = desks_drift(root)   # only when desks/ exists
        for p in drift:
            print(f"FAIL desks/: {p}")
        if drift:
            print("FAIL desks/: out of date; run `busybody kit build` and commit the result")
            bad += 1
    return 1 if bad else 0


# ------------------------------------------------------------------------------------------------
# self-test

def _base():
    return {"name": "x", "purpose": "p", "room": "project", "head": {"role": "room-lead", "model": "sonnet"},
            "desks": [{"name": "impl", "model": "sonnet", "max": 2}, {"name": "rev", "model": "opus", "max": 1, "readOnly": True}],
            "entry": ["a"], "phases": ["work"], "output": "merged-pr", "done": {"check": "pr-merged"},
            "worktree": True, "draftPr": True, "land": False,
            "caps": {"softUsdPerDay": 15, "hardUsdPerDay": 40}, "measures": ["cost"]}


def _write(root, name, t, skill_name=None, skill=True):
    d = os.path.join(root, "teams", name)
    os.makedirs(d, exist_ok=True)
    json.dump(t, open(os.path.join(d, "team.json"), "w"))
    if skill:
        open(os.path.join(d, "SKILL.md"), "w").write(f"---\nname: {skill_name or name}\ndescription: d\n---\n# {name}\n")


def self_test():
    bad = []
    root = tempfile.mkdtemp()
    os.makedirs(os.path.join(root, "roles", "analyst"))
    open(os.path.join(root, "roles", "analyst", "role.json"), "w").write("{}")

    def case(label, mutate, expect, **kw):
        t = _base()
        mutate(t)
        n = "x"
        import shutil
        shutil.rmtree(os.path.join(root, "teams"), ignore_errors=True)
        _write(root, n, t, **kw)
        errs, _ = validate(root, n)
        hit = any(expect in e for e in errs) if expect else not errs
        if not hit:
            bad.append(f"{label}: wanted {expect or 'valid'}, got {errs}")

    def drop(k):
        return lambda t: t.pop(k)

    case("valid", lambda t: None, None)
    case("valid staff", lambda t: t.update(room="staff", head={"role": "analyst", "model": "sonnet"}, output="report",
                                           done={"check": "report-posted"}, draftPr=False, worktree=False), None)
    for k in ("name", "purpose", "head", "desks", "output", "done", "worktree", "draftPr", "land", "caps", "measures", "phases", "entry"):
        case(f"missing {k}", drop(k), f"missing key {k}")
    case("unknown key", lambda t: t.update(extra=1), "unknown key extra")
    case("wrong name", lambda t: t.update(name="y"), "not the directory name")
    case("bad room", lambda t: t.update(room="lab"), "room must be")
    case("project head not room-lead", lambda t: t.update(head={"role": "analyst", "model": "sonnet"}), "room-lead")
    case("staff head without role.json", lambda t: t.update(room="staff", head={"role": "ghost", "model": "sonnet"}), "no roles/ghost/role.json")
    case("bad head model", lambda t: t["head"].update(model="gpt"), "head.model")
    case("haiku head", lambda t: t["head"].update(model="haiku"), "head.model must be sonnet or opus")
    case("haiku desk is fine", lambda t: t["desks"][0].update(model="haiku"), None)
    case("bad desk model", lambda t: t["desks"][0].update(model="fast"), "desks[0].model")
    case("duplicate desk", lambda t: t["desks"][1].update(name="impl"), "duplicate desk")
    case("max zero", lambda t: t["desks"][0].update(max=0), "desks[0].max")
    case("max bool", lambda t: t["desks"][0].update(max=True), "desks[0].max")
    case("readOnly not bool", lambda t: t["desks"][1].update(readOnly="yes"), "readOnly")
    case("desk unknown key", lambda t: t["desks"][0].update(color="red"), "unknown key color")
    case("empty phases", lambda t: t.update(phases=[]), "phases must be")
    case("blank entry", lambda t: t.update(entry=["ok", " "]), "entry must be")
    case("done mismatch", lambda t: t.update(done={"check": "landed"}), "pairs with done.check pr-merged")
    case("design recipe", lambda t: t.update(output="approved-design", done={"check": "card-has-design-link"}, draftPr=False,
                                              designSystem="https://claude.ai/artifact/x", canvas={"type": "Design", "onePerCard": True}), None)
    case("designSystem not a URL", lambda t: t.update(designSystem="ds"), "designSystem must be an https URL")
    case("canvas wrong shape", lambda t: t.update(canvas={"type": "Design"}), "canvas must be")
    case("canvas onePerCard not bool", lambda t: t.update(canvas={"type": "Design", "onePerCard": "yes"}), "canvas must be")
    case("desk phase in phases", lambda t: t["desks"][0].update(phase="work"), None)
    case("desk phase not in phases", lambda t: t["desks"][0].update(phase="nope"), "phase must be one of")
    # skills: shape, then the source against this scratch workspace's office.json (a clone that is absent is only a warning)
    src = {"url": "https://example.com/w/k", "ref": None, "sha": "0" * 40, "dir": "sources/k", "licence": "MIT", "vetted": "https://example.com/m/1"}
    json.dump({"minutesRepo": "a/b", "sources": {"k": src}}, open(os.path.join(root, "office.json"), "w"))
    sk = lambda *u: (lambda t: t["desks"][0].update(skills=[{"use": x} for x in u]))
    case("skills of a listed source", sk("k:one", "k:two"), None)
    case("skill with an at line", lambda t: t["desks"][0].update(skills=[{"use": "k:one", "at": "when stuck"}]), None)
    case("skills not a list", lambda t: t["desks"][0].update(skills="k:one"), "skills must be a list")
    case("skill not an object", lambda t: t["desks"][0].update(skills=["k:one"]), "skills[0] must be an object")
    case("skill unknown key", lambda t: t["desks"][0].update(skills=[{"use": "k:one", "x": 1}]), "unknown key x")
    case("skill without use", lambda t: t["desks"][0].update(skills=[{"at": "x"}]), "use must be <source>:<skill>")
    case("skill use with a slash", sk("k:a/b"), "use must be <source>:<skill>")
    case("skill use upper-case", sk("k:One"), "use must be <source>:<skill>")
    case("skill use without source", sk("one"), "use must be <source>:<skill>")
    case("duplicate skill", sk("k:one", "k:one"), "lists k:one twice")
    case("empty at", lambda t: t["desks"][0].update(skills=[{"use": "k:one", "at": " "}]), "skills[0].at")
    case("multi-line at", lambda t: t["desks"][0].update(skills=[{"use": "k:one", "at": "a\nb"}]), "skills[0].at")
    case("unknown source", sk("nope:one"), "source nope is not listed in office.json sources")
    os.makedirs(os.path.join(root, "sources", "k", "skills", "one"))
    open(os.path.join(root, "sources", "k", "skills", "one", "SKILL.md"), "w").write("---\nname: one\n---\n")
    os.makedirs(os.path.join(root, "sources", "k", "flat"))
    open(os.path.join(root, "sources", "k", "flat", "SKILL.md"), "w").write("---\nname: flat\n---\n")
    case("skill found under skills/", sk("k:one"), None)
    case("skill found at the source root", sk("k:flat"), None)
    case("skill missing from a present clone", sk("k:ghost"), "k:ghost: no SKILL.md")
    import shutil as _sh
    _sh.rmtree(os.path.join(root, "sources"))
    os.remove(os.path.join(root, "office.json"))
    case("approved-design pairs with card-has-design-link", lambda t: t.update(output="approved-design", draftPr=False), "pairs with done.check card-has-design-link")
    case("bad output", lambda t: t.update(output="essay"), "output must be")
    case("draft without merged-pr", lambda t: t.update(output="verdict", done={"check": "verdict-posted"}), "draft PRs")
    case("land without landed-branch", lambda t: t.update(land=True, draftPr=False), "may land")
    case("land ok for landed-branch", lambda t: t.update(land=True, draftPr=False, output="landed-branch", done={"check": "landed"}), None)
    case("soft above hard", lambda t: t["caps"].update(softUsdPerDay=50), "soft must not exceed hard")
    case("non-positive cap", lambda t: t["caps"].update(softUsdPerDay=0), "positive")
    case("flag not bool", lambda t: t.update(worktree="yes"), "worktree must be a boolean")
    case("missing SKILL.md", lambda t: None, "SKILL.md is missing", skill=False)
    case("SKILL name differs", lambda t: None, "frontmatter name", skill_name="other")
    # check(): one line per recipe, non-zero on any failure, never reads the real teams/
    import shutil, io, contextlib
    shutil.rmtree(os.path.join(root, "teams"), ignore_errors=True)
    _write(root, "x", _base())
    t2 = _base(); t2["name"] = "y"; t2["caps"]["softUsdPerDay"] = 99
    _write(root, "y", t2)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = check(root, [])
        rc_one = check(root, ["x"])
        rc_none = check(root, ["nope"])
    lines = buf.getvalue().splitlines()
    if not (rc == 1 and rc_one == 0 and rc_none == 1 and lines[0].startswith("ok   x") and lines[1].startswith("FAIL y")):
        bad.append(f"check(): rc={rc},{rc_one},{rc_none} lines={lines}")
    # desks/ drift: skipped when absent, checked when present, only on a full check
    shutil.rmtree(os.path.join(root, "teams"), ignore_errors=True)
    _write(root, "x", _base())
    kb = os.path.join(root, "desks")
    shutil.rmtree(kb, ignore_errors=True)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        if check(root, []) != 0 or "desks/" in buf.getvalue():
            bad.append("no desks/ means no drift check")
    tpl = open(os.path.join(ENGINE_ROOT, "templates", "desk.md")).read()
    for rel, text in kitlib.render([_base()], tpl).items():
        os.makedirs(os.path.dirname(os.path.join(kb, rel)), exist_ok=True)
        open(os.path.join(kb, rel), "w").write(text)
    with contextlib.redirect_stdout(io.StringIO()):
        if check(root, []) != 0:
            bad.append("a desks/ that matches the recipes passes team check")
        open(os.path.join(kb, "agents", "x-impl.md"), "a").write("hand edit\n")
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc_drift = check(root, [])
        if rc_drift != 1 or "FAIL desks/" not in buf.getvalue():
            bad.append(f"a hand-edited desks/ fails team check: {buf.getvalue()}")
        if check(root, ["x"]) != 0:
            bad.append("a named check skips the drift check")
    shutil.rmtree(kb, ignore_errors=True)
    # powers: wording follows the flags
    def pw(**kw):
        t = _base(); t.update(kw)
        return powers_text(t)
    a = pw()
    if not ("gh pr create --draft" in a and "may not land" in a and "impl up to 2 on sonnet" in a
