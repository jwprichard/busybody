    issue(52, team="writer", comments=["**DONE** · WHO · #52\nWrote it up\n\nReport: README.md"])
    expect("report fail (bare README.md not on the branch)", resolve(52), 1, "README.md, which is not on the room's branch")
    issue(53, team="writer", branch="no-such-branch", comments=["**DONE** · WHO · #53\nWrote it up\n\nReport: docs/findings.md"])
    expect("report undecided (path, branch missing)", resolve(53), 2, "UNDECIDED report-posted")
    issue(43, team="writer", comments=["**DONE** · WHO · #43\nWrote it up\n"])
    expect("report fail (no line)", resolve(43), 1, "no Report: line")
    issue(50, repo="acme-office")
    expect("a dev team in this repo (no PRs) resolves with landed, not pr-merged", resolve(50), 2, "UNDECIDED landed")
    issue(51, repo="acme-office", team="mad", comments=["**DONE** · WHO · #51\nVerdict: x\n"])
    expect("a no-PR recipe in this repo keeps its own check", resolve(51), 0, "PASS verdict-posted")
    # landed, and --check overriding the recipe
    issue(44, team="lander")
    expect("landed pass", resolve(44), 0, "PASS landed on #44: refs/heads/landed-b")
    issue(45, team="lander", branch="open-b")
    expect("landed fail", resolve(45), 1, "FAIL landed on #45: refs/heads/open-b")
    issue(48, team="lander", branch="empty-b")
    expect("landed fail (branch with no commits of its own)", resolve(48), 1, "no commits of its own")
    issue(46, team="lander", branch="no-such-branch")
    expect("landed undecided (no branch)", resolve(46), 2, "UNDECIDED landed")
    issue(47, team="dev-team", branch="landed-b")
    expect("--check overrides the recipe's check", resolve(47, "--check", "landed"), 0, "PASS landed on #47")
    git("remote", "add", "origin", os.path.join(fx, "nowhere"))
    git("update-ref", "refs/remotes/origin/main", "main~1")
    expect("landed fail when origin/main is behind", resolve(47, "--check", "landed"), 1, "origin/main")
    # resolve closes the issue on PASS, and only then
    raw = [""]

    def writes():
        log = open(glog).read()
        raw[0] = log
        open(glog, "w").write("")
        return [ln for ln in log.splitlines() if re.match(r"(issue (comment|close)|api (-X|repos/\S+/(comments|issues/\d+$)))", ln)]

    git("update-ref", "refs/remotes/origin/main", "main")
    writes()
    issue(60, branch="landed-b")
    expect("PASS closes", resolve(60, "--check", "landed"), 0, "#60 closed as completed (RECORD minute posted)")
    w = writes()
    if not (len(w) == 2 and w[0].startswith("issue comment 60 -R acme-co/") and "**RECORD** · controller · #60\nResolved: landed passed:" in raw[0]
            and w[1] == "issue close 60 -R " + REPO + " --reason completed"):
        bad.append(f"resolve PASS writes: {w}")
    os.environ["BUSYBODY_CONTROLLER"] = "ctl"
    resolve(60, "--check", "landed")
    if "**RECORD** · ctl · #60" not in "".join(writes()):
        bad.append("resolve minute's who does not follow BUSYBODY_CONTROLLER")
    os.environ.pop("BUSYBODY_CONTROLLER")
    issue(61, branch="open-b")
    expect("FAIL does not close", resolve(61, "--check", "landed"), 1, "FAIL landed")
    if writes():
        bad.append("resolve wrote on FAIL")
    issue(62, branch="no-such-branch")
    expect("UNDECIDED does not close", resolve(62, "--check", "landed"), 2, "UNDECIDED landed")
    if writes():
        bad.append("resolve wrote on UNDECIDED")
    expect("--no-close skips", resolve(60, "--check", "landed", "--no-close"), 0, "PASS landed on #60")
    if writes():
        bad.append("--no-close wrote")
    issue(63, labels=("project",))
    expect("project label stays open", resolve(63, "--check", "landed"), 0, "carries the `project` label: left open")
    if writes():
        bad.append("resolve closed a project")
    issue(64)
    json.dump([{"number": 7, "state": "closed"}, {"number": 8, "state": "open"}], open(os.path.join(fx, "subs-64.json"), "w"))
    expect("open sub-issue stays open", resolve(64, "--check", "landed"), 0, "left open: open sub-issues #8")
    if writes():
        bad.append("resolve closed an issue with open sub-issues")
    json.dump([{"number": 7, "state": "closed"}], open(os.path.join(fx, "subs-64.json"), "w"))
    expect("closed sub-issues do not block", resolve(64, "--check", "landed"), 0, "#64 closed as completed")
    writes()
    issue(65, state="CLOSED")
    expect("already closed is idempotent", resolve(65, "--check", "landed"), 0, "PASS landed on #65")
    if writes():
        bad.append("resolve wrote on an already-closed issue")
    open(os.path.join(fx, "classic"), "w").close()   # gh issue comment/close error, as on a repo with Projects classic
    issue(66)
    expect("falls back to gh api", resolve(66, "--check", "landed"), 0, "#66 closed as completed")
    w = writes()
    if not [x for x in w if x.startswith(f"api repos/{REPO}/issues/66/comments")] or not [x for x in w if x.startswith(f"api -X PATCH repos/{REPO}/issues/66 ")]:
        bad.append(f"resolve fallback did not use gh api: {w}")
    os.remove(os.path.join(fx, "classic"))
    globals()["TRACKER"] = saved_tracker0
    for k in ("TEAM_GH", "TEAM_TRACKER", "TEAM_GIT", "TEAM_FIX", "TEAM_REPOS_DIR", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM"):
        os.environ.pop(k, None)
    for k, v in saved.items():
        if v is not None:
            os.environ[k] = v
    shutil.rmtree(fx, ignore_errors=True)
    # brief parts follow the flags
    for kw, part, want, nowant in (({}, "commit", "push the room's branch", "no repo changes"), ({"worktree": False}, "commit", "no repo changes", "push the room"),
                                   ({}, "prs", "draft\n  stack", "Open no PR"), ({"draftPr": False}, "prs", "Open no PR", "draft\n  stack"),
                                   ({}, "prlimit", "a dev team's draft", "opening any PR"), ({"draftPr": False}, "prlimit", "opening any PR", "draft")):
        t = _base(); t.update(kw)
        got = brief_part(t, part)
        if want not in got or nowant in got:
            bad.append(f"brief_part {part} {kw}: {got}")
    if "Open no PR" not in brief_part(_base(), "prs", True):
        bad.append("brief_part prs with --land must forbid PRs")
    # roots: the engine is this script's checkout; OFFICE_WORKSPACE moves only the workspace
    if workspace_root(ENGINE_ROOT, {"OFFICE_WORKSPACE": root}, root) != os.path.abspath(root):
        bad.append("OFFICE_WORKSPACE must set the workspace root")
    if workspace_root(ENGINE_ROOT, {}, tempfile.gettempdir()) != ENGINE_ROOT and not os.path.isfile(os.path.join(tempfile.gettempdir(), "office.json")):
        bad.append("with no OFFICE_WORKSPACE and no office.json the workspace root is the engine root")
    if subprocess.run([sys.executable, "-I", os.path.join(ENGINE_ROOT, "bin", "lib", "officeroot.py"), "--self-test"]).returncode:
        bad.append("officeroot self-test")
    if subprocess.run([sys.executable, "-I", os.path.join(ENGINE_ROOT, "bin", "lib", "officeconfig.py"), "--self-test"]).returncode:
        bad.append("officeconfig self-test")
    if subprocess.run([sys.executable, "-I", os.path.join(ENGINE_ROOT, "bin", "lib", "tracker.py"), "--self-test"]).returncode:
        bad.append("tracker self-test")
    if subprocess.run([os.path.join(ENGINE_ROOT, "bin", "status"), "--self-test"]).returncode:
        bad.append("status self-test")
    shutil.rmtree(root, ignore_errors=True)
    if bad:
        print("team self-test: FAILED: " + "; ".join(bad))
        return 1
    print("team self-test: ok")
    return 0


# ------------------------------------------------------------------------------------------------
# powers

def load_recipe(name, root=None):
    root = root or WORKSPACE_ROOT   # recipes belong to the workspace, not the engine
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name or "") or not os.path.isdir(os.path.join(root, "teams", name)):
        die(f"no such recipe: {name}")
    errs, t = validate(root, name)
    if errs:
        die(f"recipe {name} is invalid: " + "; ".join(errs))
    return t


def _or_list(names):
    """`a`, `b` or `c`"""
    q = [f"`{n}`" for n in names]
    return q[0] if len(q) == 1 else ", ".join(q[:-1]) + " or " + q[-1]


def powers_text(t, land_override=False, desks=False):
    """The bullets the launch brief states, from the recipe's flags. `land_override` is for a repo without
    PRs: the room lands with bin/land instead of opening draft PRs. `desks` is for a workspace with a generated
    desks/ plugin (bin/kit): the Desks bullet is then followed by one naming each desk's agent type."""
    draft = t["draftPr"] and not land_override
    land = t["land"] or land_override
    head = t["head"]
    out = [f"- **Team: {t['name']}** ({t['purpose']}). Recipe: `teams/{t['name']}/SKILL.md`. The room settings deny what this "
           "recipe withholds (as command patterns, a backstop), and the skill never loosens them."]
    if t["desks"]:
        ds = "; ".join(f"{d['name']} up to {d['max']} on {d['model']}" + (" (read-only)" if d.get("readOnly") else "") for d in t["desks"])
        out.append(f"- Desks (a maximum, never a quota: leave desks empty for small work): {ds}. You head the room on {head['model']}.")
        if desks:
            types = ", ".join(f'{d["name"]} = `subagent_type: "desks:{t["name"]}-{d["name"]}"`' for d in t["desks"])
            out.append(f"- Spawn each desk with its agent type ({types}). The agent type fixes the desk's model and its tools, "
                       "so pass no `model` and do not use a general-purpose agent for desk work.")
    else:
        out.append(f"- Desks: none. You work alone on {head['model']}.")
    out.append("- Worktree: this room has a worktree, and you may edit and commit in it." if t["worktree"] else
               "- Worktree: this team needs none. Do not edit repo files; your output is the minutes.")
    if draft:
        out.append("- Draft PRs: you may `gh pr create --draft` for the room's branch. Never open one ready and never run `gh pr ready`: "
                   "the owner promotes." + (" " + OFFICE.draft_note if OFFICE.draft_note else ""))
    else:
        out.append("- PRs: you may not open a PR (not even a draft).")
    if land:
        out.append("- Landing: this repo has no PRs, so you land your branch with `bin/land <branch>` (never `--no-checks`, never force-push).")
    else:
        out.append("- Landing: you may not land or move `main`.")
    c = t["caps"]
    out.append(f"- Caps: soft ${c['softUsdPerDay']:g} per day, hard ${c['hardUsdPerDay']:g} per day.")
    out.append(f"- Never, whatever the recipe says: merge a PR, run `gh pr ready`, push {_or_list(OFFICE.protected_branches())}, open a room "
               "(`claude --bg`, `bin/team start`, or the old launchers). Ask with a `DECISION:` sticky note.")
    return "\n".join(out)


# ------------------------------------------------------------------------------------------------
# start

def slugify(text):
    """Lowercase, dashes, at most 41 characters, no leading `room-` (a room is always room-<slug>)."""
    slug = re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
    slug = re.sub(r"^room-", "", slug)
    return slug[:41].strip("-")


def parse_target(text):
    """('initiative', number) for N, #N or an issue URL of the workspace repo; else ('task', text)."""
    text = (text or "").strip()
    m = re.fullmatch(r"#?(\d+)", text) or re.fullmatch(rf"https://github\.com/{re.escape(REPO)}/issues/(\d+)/?", text)
    return ("initiative", int(m.group(1))) if m else ("task", text)


def room_repo(body):
    """The `- repo:` line of the issue's `## Room` block, or None."""
    sec = re.search(r"(?ms)^## Room\b.*?(?=^## |\Z)", body or "")
    m = sec and re.search(r"(?m)^[-*]\s*repo:\s*`?([\w./-]+)`?\s*$", sec.group(0))
    return m.group(1) if m else None


def tool(env, default, args, **kw):
    return subprocess.run(shlex.split(os.environ.get(env) or default) + args, capture_output=True, text=True, **kw)


def read_issue(n):
    r = tool("TEAM_GH", "gh", ["issue", "view", str(n), "-R", REPO, "--json", "title,body"])
    try:
        d = json.loads(r.stdout)
        return d["title"], d.get("body") or ""
    except (ValueError, KeyError):
        die(f"cannot read issue #{n} in {REPO}: {(r.stderr or r.stdout).strip()[:200]}")


def cmd_start(argv, root=None):
    root = root or WORKSPACE_ROOT   # recipes belong to the workspace, not the engine
    pos, opt, dry = [], {}, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--dry-run":
            dry = True
        elif a in ("--repo", "--base", "--controller", "--liaison"):
            if i + 1 >= len(argv):
                die(f"{a} needs a value")
            opt["--controller" if a == "--liaison" else a] = argv[i + 1]
            i += 1
        elif a.startswith("--"):
            die(f"unknown flag {a}")
        else:
            pos.append(a)
        i += 1
    if len(pos) < 2:
        die('usage: bin/team start <recipe> <initiative|"task"> [--repo R] [--base REF] [--controller NAME] [--dry-run]')
    t = load_recipe(pos[0], root)
    kind, target = parse_target(" ".join(pos[1:]))
    controller = opt.get("--controller") or bb_env(None, "CONTROLLER", "SCH_LIAISON_SESSION")
    if not controller:
        die("controller session name required: --controller NAME or BUSYBODY_CONTROLLER")
    issue, title, body = None, target, ""
    if kind == "initiative":
        issue = target
        title, body = read_issue(issue)
    head = t["head"]
    if t["room"] == "staff":
        launcher = os.environ.get("TEAM_ROLE_RUN") or os.path.join(ENGINE_ROOT, "bin", "role")
        if not issue:
            die("a staff-room pass runs on an initiative issue: pass its number, not a task")
        argv_out = [launcher, "run", head["role"], title, "--issue", str(issue), "--controller", controller, "--team", t["name"]]
        repo = None
    else:
        repo = opt.get("--repo") or room_repo(body)
        if not repo:
            die("no repo: name one with --repo (the issue has no Room block repo)")
        slug = slugify(title)
        if not slug:
            die("cannot derive a slug from the title: " + repr(title))
        launcher = os.environ.get("TEAM_LEAD_START") or os.path.join(ENGINE_ROOT, "bin", "lead-start")
        argv_out = [launcher, repo, slug, "--controller", controller]
        if issue:
            argv_out += ["--issue", str(issue)]
        if opt.get("--base"):
            argv_out += ["--base", opt["--base"]]
        argv_out += ["--model", head["model"], "--team", t["name"]]
    # a repo whose merge is "land" has no PRs: a team that opens draft PRs lands instead. The launcher reads that from office.json itself.
    land = bool(repo) and t["draftPr"] and merge_mode(repo) == "land"
    if dry:
        print("DRY RUN: nothing is launched.")
        print(f"recipe:   {t['name']} ({t['room']} room, head {head['role']} on {head['model']})")
        print("target:   " + (f"initiative #{issue} {title!r}" if issue else f"task {title!r}"))
        if repo:
            print(f"repo:     {repo}")
        print("command:  " + " ".join(shlex.quote(a) for a in argv_out))
        print("powers (goes into the launch brief):")
        print("\n".join("  " + ln for ln in powers_text(t, land).splitlines()))
        return 0
    return subprocess.run(argv_out).returncode


# ------------------------------------------------------------------------------------------------
# resolve

TYPES = "PROGRESS|DECISION|BLOCKED|DONE|ANSWER|WAITING|NOTE|RECORD"
HEADER_RE = re.compile(rf"^\s*\*\*({TYPES})\*\*\s*·\s*([^·\n]*?)\s*(?:·\s*(.*?))?\s*$", re.I)
VERB_RE = re.compile(rf"^\s*({TYPES})\b[^:\n]*:\s*(.*)$", re.I)
APPROVAL_RE = re.compile(rf"github\.com/{re.escape(REPO)}/issues/\d+#issuecomment-\d+")


class Undecided(Exception):
    pass


def room_block(body):
    """The `## Room` block's `- key: value` lines as a dict (empty when there is none)."""
    sec = re.search(r"(?ms)^## Room\b.*?(?=^## |\Z)", body or "")
    out = {}
    for m in re.finditer(r"(?m)^[-*]\s*([\w-]+):\s*(.*?)\s*$", sec.group(0) if sec else ""):
        out.setdefault(m.group(1), m.group(2).strip("`"))
    return out


def minute(comment):
    """(type, who, summary, body, url) of a comment, or None when it is not a minute."""
    body = comment.get("body") or ""
    lines = body.splitlines()
    if not lines:
        return None
    h = HEADER_RE.match(lines[0])
    if h:
        rest = [ln.strip() for ln in lines[1:] if ln.strip()]
        return h.group(1).upper(), h.group(2).strip(), rest[0] if rest else "", body, comment.get("url", "")
    v = VERB_RE.match(lines[0])
    if v:
        return v.group(1).upper(), "", v.group(2).strip(), body, comment.get("url", "")
    return None


def done_minute(comments, room):
    """The latest DONE minute whose `who` is exactly the room's name. An old-style `DONE:` has no who, so it is never trusted:
    anyone could have typed it."""
    found = None
    for c in comments:
        m = minute(c)
        if m and m[0] == "DONE" and room and m[1] == room:
            found = m
    return found


def need_done(ctx):
    if not ctx.get("room_name"):
        raise Undecided("no Room block names the room, so no DONE minute can be trusted: pass --room NAME (the session name)")
    return ctx["done"]


def gh_json(args):
    r = tool("TEAM_GH", "gh", args)
    try:
        return json.loads(r.stdout)
    except ValueError:
        raise Undecided(f"gh {' '.join(args[:2])} failed: {(r.stderr or r.stdout).strip()[:150]}")


def repo_dir(repo):
    base = os.environ.get("TEAM_REPOS_DIR")
    if OFFICE.is_workspace(repo) and not base:
        return WORKSPACE_ROOT
    return os.path.join(base or WORKSPACE_ROOT, repo)


def check_pr_merged(ctx):
    repo, branch = ctx["room"].get("repo"), ctx["room"].get("branch")
    if not repo or not branch:
        raise Undecided("the Room block names no repo and branch")
    owner_repo = OFFICE.github(repo)
    prs = gh_json(["pr", "list", "-R", owner_repo, "--head", branch, "--state", "all", "--json", "url,state"])
    if not isinstance(prs, list):
        raise Undecided("unexpected gh pr list output")
    for pr in prs:
        if pr.get("state") == "MERGED":
            return True, f"{pr.get('url')} is merged"
    return False, ("no PR for branch " + branch if not prs else "no merged PR for branch " + branch + ": " + ", ".join(f"{x.get('url')} {x.get('state')}" for x in prs))


def check_verdict_posted(ctx):
    m = need_done(ctx)
    if not m:
        return False, "no DONE minute from the room"
    if m[2].startswith("Verdict:"):
        return True, f"DONE minute {m[4] or '(no url)'} says: {m[2][:100]}"
    return False, f"the DONE minute's summary line does not start with 'Verdict:' ({m[4] or 'no url'})"


def branch_has_file(ctx, path):
    """Whether `path` exists on the room's branch (local, else origin as last fetched)."""
    repo, branch = ctx["room"].get("repo"), ctx["room"].get("branch")
    if not repo or not branch:
        raise Undecided("the Report: line names a path, but the Room block names no repo and branch to look it up on")
    d = repo_dir(repo)
    if not os.path.isdir(d):
        raise Undecided(f"no local clone of {repo} at {d} to look {path} up in")
    git = shlex.split(os.environ.get("TEAM_GIT") or "git") + ["-C", d]
    for ref in (f"refs/heads/{branch}", f"refs/remotes/origin/{branch}"):
        if subprocess.run(git + ["rev-parse", "--verify", "-q", ref], capture_output=True).returncode == 0:
            return subprocess.run(git + ["cat-file", "-e", f"{ref}:{path}"], capture_output=True).returncode == 0
    raise Undecided(f"branch {branch} is not in {repo}, so {path} cannot be looked up")


def check_report_posted(ctx):
    m = need_done(ctx)
    if not m:
        return False, "no DONE minute from the room"
    for ln in m[3].splitlines():
        r = re.match(r"\s*Report:\s*(.*)$", ln)
        if r:
            url = re.search(r"https?://[^\s)>\]]+", r.group(1))
            if url:
                return True, f"DONE minute {m[4] or '(no url)'} links {url.group(0).rstrip('.,')}"
            path = re.search(r"(?<![\w/.-])[\w.-]+(?:/[\w.-]+)*\.md\b", r.group(1))
            if not path:
                return False, "the Report: line holds no link"
            if branch_has_file(ctx, path.group(0)):
                return True, f"DONE minute {m[4] or '(no url)'} names {path.group(0)}, which exists on the room's branch"
            return False, f"the Report: line names {path.group(0)}, which is not on the room's branch"
    return False, "the DONE minute has no Report: line"


def fetch_card(cid):
    try:
        return TRACKER.get(cid)
    except TrackerError as e:
        raise Undecided(str(e))


DESIGN_RE = re.compile(r"(?mi)^\s*Design:\s*.*?(https://claude\.ai/(?:code/)?artifact/[\w-]+)")


def check_card_has_design_link(ctx):
    m = need_done(ctx)
    if not m:
        return False, "no DONE minute from the room"
    if not TRACKER.enabled:
        return True, f"DONE minute {m[4] or '(no url)'}; tracker is none, so the card is not checked"
    ids = TRACKER.ids(m[3])
    if not ids:
        return False, f"the DONE minute names no {TRACKER.name} card URL"
    good, bad = [], []
    for cid in ids:
        desc = fetch_card(cid)["description"]
        d, a = DESIGN_RE.search(desc), APPROVAL_RE.search(desc)
        if d and a:
            good.append(f"{cid}: Design: line links {d.group(1)} with an approval link")
        else:
            bad.append(f"{cid}: " + ("no Design: line with a claude.ai artifact link" if not d else "no link to the owner's approval comment"))
    return (False, "; ".join(bad + good)) if bad else (True, "; ".join(good))


def check_ready_card(ctx):
    m = need_done(ctx)
    if not m:
        return False, "no DONE minute from the room"
    if not TRACKER.enabled:
        return True, f"DONE minute {m[4] or '(no url)'}; tracker is none, so the card is not checked"
    ids = TRACKER.ids(m[3])
    if not ids:
        return False, f"the DONE minute names no {TRACKER.name} card URL"
    notes, bad = [], []
    for cid in ids:
        card = fetch_card(cid)
        ready = any(lab.strip().lower() == "ready" for lab in card["labels"])
        approved = bool(APPROVAL_RE.search(card["description"]))
        (notes if ready and approved else bad).append(f"{cid}: " + ("Ready with an approval link" if ready and approved else
                                                                  ("Ready label but no approval link" if ready else "no Ready label")))
    if bad:
        return False, "; ".join(bad + notes)
    return True, "; ".join(notes)


def check_landed(ctx):
    repo, branch = ctx["room"].get("repo"), ctx["room"].get("branch")
    if not repo or not branch:
        raise Undecided("the Room block names no repo and branch")
    d = repo_dir(repo)
    if not os.path.isdir(d):
        raise Undecided(f"no local clone of {repo} at {d}")
    git = shlex.split(os.environ.get("TEAM_GIT") or "git") + ["-C", d]

    def g(*a):
        return subprocess.run(git + list(a), capture_output=True, text=True)

    tip = None
    for ref in (f"refs/heads/{branch}", f"refs/remotes/origin/{branch}"):
        r = g("rev-parse", "--verify", "-q", ref)
        if r.returncode == 0:
            tip, src = r.stdout.strip(), ref
            break
    if not tip:
        raise Undecided(f"branch {branch} is not in {repo} (locally or on origin as last fetched)")
    # A branch with no commits of its own sits on an old main commit and would pass the ancestor test: the oldest
    # reflog entry is where the branch was created, so the tip must differ from it.
    first = [x for x in g("reflog", "show", "--format=%H", src).stdout.split() if x]
    if not first:
        raise Undecided(f"{src} has no reflog, so its creation point is unknown")
    if first[-1] == tip:
        return False, f"{src} ({tip[:7]}) has no commits of its own (still at the commit it was created from)"
    targets = ["refs/heads/main"]
    if g("remote", "get-url", "origin").returncode == 0:
        targets.append("refs/remotes/origin/main")
    for ref in targets:
        if g("rev-parse", "--verify", "-q", ref).returncode:
            raise Undecided(f"{ref} does not exist in {repo}")
        if g("merge-base", "--is-ancestor", tip, ref).returncode != 0:
            return False, f"{src} ({tip[:7]}) is not an ancestor of {ref.replace('refs/heads/', '').replace('refs/remotes/', '')}"
    return True, f"{src} ({tip[:7]}) is an ancestor of " + " and ".join(t.replace("refs/heads/", "").replace("refs/remotes/", "") for t in targets)


def merge_mode(repo):
    """The repo's `merge` from office.json ("pr" or "land"); a repo without one stops the command with one line."""
    try:
        return OFFICE.merge(repo)
    except officeconfig.ConfigError as e:
        die(str(e))


def effective_check(t, repo):
    """The recipe's done check, except in this repo (no PRs): a recipe that opens draft PRs lands here instead, as bin/team start
    arranges, so it is `landed` and never `pr-merged`."""
    if t["draftPr"] and repo in OFFICE.repos and merge_mode(repo) == "land":   # a repo office.json does not list has no merge mode: PRs
        return "landed"
    return t["done"]["check"]


RESOLVERS = {"pr-merged": check_pr_merged, "verdict-posted": check_verdict_posted, "ready-card": check_ready_card,
             "report-posted": check_report_posted, "landed": check_landed,
             "card-has-design-link": check_card_has_design_link}


CHECKS = tuple(RESOLVERS)


def cmd_resolve(argv, root=None):
    root = root or WORKSPACE_ROOT   # recipes belong to the workspace, not the engine
    pos, override, room_opt, i, close, no_close = [], None, None, 0, False, False
    while i < len(argv):
        if argv[i] == "--close":
            close = True
        elif argv[i] == "--no-close":
            no_close = True
        elif argv[i] in ("--check", "--room"):
            if i + 1 >= len(argv):
                die(f"{argv[i]} needs a value", 2)
            if argv[i] == "--check":
                override = argv[i + 1]
            else:
                room_opt = argv[i + 1]
            i += 1
        elif argv[i].startswith("--"):
            die(f"unknown flag {argv[i]}", 2)
        else:
            pos.append(argv[i])
        i += 1
    kind, n = parse_target(" ".join(pos))
    if len(pos) != 1 or kind != "initiative":
        die("usage: bin/team resolve <initiative> [--check NAME] [--room NAME] [--close] [--no-close]", 2)
    if override and override not in CHECKS:
        die(f"unknown check {override}; one of: " + ", ".join(CHECKS), 2)
    check = override
    try:
        r = tool("TEAM_GH", "gh", ["issue", "view", str(n), "-R", REPO, "--json", "title,body,comments,state,labels"])
        try:
            issue = json.loads(r.stdout)
        except ValueError:
            raise Undecided(f"cannot read issue #{n}: {(r.stderr or r.stdout).strip()[:150]}")
        room = room_block(issue.get("body"))
        if not check:
            if not room:
                raise Undecided("the issue has no Room block, so no recipe: name a check with --check")
            team = room.get("team") or "dev-team"
            errs, t = validate(root, team) if os.path.isdir(os.path.join(root, "teams", team)) else (["no such recipe"], None)
            if errs:
                raise Undecided(f"recipe {team} cannot be read ({'; '.join(errs)}): name a check with --check")
            check = effective_check(t, room.get("repo"))
        comments = issue.get("comments") or []
        # a role pass (`--room role-…`) resolves the pass, not the initiative: its DONE is found even when the issue has a Room block
        is_pass = bool(room_opt and room_opt.startswith("role-"))
        # a legacy pass issue (no Room block, titled `<role>: <task>`, labelled `refine` or `<role>-pass`) is the pass's own issue: it closes as before
        pm = re.match(r"^([a-z][a-z0-9-]*): \S", issue.get("title") or "")
        labels = {(lb.get("name") if isinstance(lb, dict) else lb) for lb in issue.get("labels") or []}
        legacy_pass = bool(is_pass and not room and pm and room_opt.startswith(f"role-{pm.group(1)}-") and ({"refine", f"{pm.group(1)}-pass"} & labels))
        name = room_opt if is_pass else (room.get("room") or room_opt)   # otherwise the Room block wins: --room only names a pass session when there is no block
        ctx = {"room": room, "room_name": name, "done": done_minute(comments, name), "comments": comments}
        ok, evidence = RESOLVERS[check](ctx)
    except Undecided as e:
        print(f"UNDECIDED {check or '?'} on #{n}: {e}")
        return 2
    print(f"{'PASS' if ok else 'FAIL'} {check} on #{n}: {evidence}")
    if ok and is_pass and not legacy_pass:
        print(f"#{n} stays open: {name} is a pass on this initiative, not the initiative's room")
    elif ok and not no_close and not close_issue(n, issue, check, evidence):
        return 3   # the check passed but the issue could not be closed: fail loudly
    if ok and close and name and not close_session(name):
        return 3   # the check passed but the session is still running: fail loudly
    return 0 if ok else 1


def gh_write(args):
    """A gh write; True when it succeeded."""
    return tool("TEAM_GH", "gh", args).returncode == 0


def open_sub_issues(n):
    """Open sub-issues of #n; None when gh cannot say (so the caller does not close blind)."""
    r = tool("TEAM_GH", "gh", ["api", f"repos/{REPO}/issues/{n}/sub_issues"])
    try:
        subs = json.loads(r.stdout)
    except ValueError:
        return None
    if r.returncode or not isinstance(subs, list):
        return None
    return [s.get("number") for s in subs if str(s.get("state", "")).lower() == "open"]


def close_issue(n, issue, check, evidence):
    """After a PASS: a RECORD minute, then close as completed. Skips (and says why) for a closed issue, a `project`, open sub-issues."""
    if str(issue.get("state", "")).upper() == "CLOSED":
        print(f"#{n} is already closed: nothing to do")
        return True
    if any((lb.get("name") if isinstance(lb, dict) else lb) == "project" for lb in issue.get("labels") or []):
        print(f"#{n} carries the `project` label: left open")
        return True
    subs = open_sub_issues(n)
    if subs is None:
        print(f"#{n} left open: could not read its sub-issues (close it by hand)")
        return True
    if subs:
        print(f"#{n} left open: open sub-issues " + ", ".join(f"#{x}" for x in subs))
        return True
    who = bb_env(None, "CONTROLLER") or "controller"
    body = f"**RECORD** · {who} · #{n}\nResolved: {check} passed: {evidence}"
    # `gh issue comment` / `gh issue close` can error on a repo with Projects (classic); the REST calls do not
    if not (gh_write(["issue", "comment", str(n), "-R", REPO, "--body", body])
            or gh_write(["api", f"repos/{REPO}/issues/{n}/comments", "-f", f"body={body}"])):
        print(f"#{n} not closed: could not post the RECORD minute")
        return False
    if not (gh_write(["issue", "close", str(n), "-R", REPO, "--reason", "completed"])
            or gh_write(["api", "-X", "PATCH", f"repos/{REPO}/issues/{n}", "-f", "state=closed", "-f", "state_reason=completed"])):
        print(f"#{n} not closed: the RECORD minute is posted but the close failed (close it by hand)")
        return False
    print(f"#{n} closed as completed (RECORD minute posted)")
    return True


def close_session(name):
    """--close, after a PASS: `claude stop`, then end the room's process itself (it may be running although stop finds no job)."""
    import sessions
    try:
        r = tool("TEAM_CLAUDE", "claude", ["stop", name], timeout=60)
        print(f"claude stop {name}: " + ("ok" if r.returncode == 0 else ((r.stderr or r.stdout).strip().splitlines() or [f"exit {r.returncode}"])[0][:120]))
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"claude stop {name}: did not run ({type(e).__name__})")
    try:
        ok, lines = sessions.end(name)
    except ValueError as e:
        print(f"end-session: {e}")
        return False
    print("\n".join(lines) + ("" if ok else f"\n(end it by hand: {os.path.join(ENGINE_ROOT, 'bin', 'end-session')} {name})"))
    return ok


def brief_part(t, part, land_override=False):
    """Lines of templates/lead-brief.md that depend on the recipe, so the brief never contradicts the powers text."""
    draft = t["draftPr"] and not land_override
    if part == "commit":
        if t["worktree"]:
            return "- Commit, and push the room's branch `@BRANCH@` (and only branches you created for this room)."
        return "- This team makes no repo changes: do not commit or push. Your output is the minutes."
    if part == "prs":
        if draft:
            return ("- Open any other PR only if the issue says so. If the work splits into several PRs, open them as a **draft\n"
                    "  stack** up front per `decisions/2026-10-07-stacked-prs.md`: one worker per branch, update by\n"
                    "  `git merge origin/<parent>` (never rebase or force-push), and never mark ready.")
        return "- Open no PR of any kind, not even a draft or a stack. If the work needs one, ask with a `DECISION:` sticky note."
    if part == "prlimit":
        if draft:
            return ("opening a PR that is not a draft (a dev team's draft, or a stack draft, is allowed; unless the issue says otherwise); "
                    "marking ready; merging, ever")
        return "opening any PR; marking ready; merging, ever"
    die(f"unknown brief part {part}; one of commit, prs, prlimit")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 1
    if argv[0] == "--self-test":
        return self_test()
    if argv[0] == "check":
        return check(WORKSPACE_ROOT, argv[1:])
    if argv[0] == "resolve":
        return cmd_resolve(argv[1:])
    if argv[0] == "start":
        return cmd_start(argv[1:])
    if argv[0] == "brief":
        names = [a for a in argv[1:] if not a.startswith("--")]
        if len(names) != 2:
            die("usage: bin/team brief <recipe> commit|prs|prlimit [--land]")
        print(brief_part(load_recipe(names[0]), names[1], "--land" in argv))
        return 0
    if argv[0] == "powers":
        names = [a for a in argv[1:] if not a.startswith("--")]
        if len(names) != 1:
            die("usage: bin/team powers <recipe> [--land] [--desks]")
        print(powers_text(load_recipe(names[0]), "--land" in argv, "--desks" in argv))
        return 0
    die(f"unknown command {argv[0]}; see bin/team --help")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
