{
  "_comment": "Role-session settings template. bin/role run merges the seatbelts of templates/room-settings.json (permissions.deny, minus _unlessProdRead which is always added) with these extras. The `{{tracker.writeDeny}}` entry expands in place to the tracker's write-deny patterns from office.json. A role session runs in the workspace checkout, may only comment on its issue and proposes memory in a MEMORY minute (it writes no memory file; the controller runs `role apply`); git writes and the repo's own files are denied. Edit(...) rules are relative to the session cwd.",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "deny": [
    "Bash(git commit*)",
    "Bash(git add*)",
    "Bash(git push*)",
    "Bash(git reset*)",
    "Bash(git checkout*)",
    "Bash(git restore*)",
    "Bash(git stash*)",
    "Bash(git rm*)",
    "Bash(git mv*)",
    "Bash(git merge*)",
    "Bash(git rebase*)",
    "Bash(git switch*)",
    "Bash(*bin/role accept*)",
    "Bash(*bin/role reject*)",
    "Bash(*bin/role apply*)",
    "Bash(*bin/role promote*)",
    "Bash(*bin/role commit-candidates*)",
    "Bash(*bin/role run*)",
    "Bash(*bin/role disable*)",
    "Bash(*bin/role enable*)",
    "Bash(*bin/role keep*)",
    "Bash(*bin/role new*)",
    "Bash(*bin/role install-hook*)",
    "Bash(gh issue edit*)",
    "Bash(gh issue close*)",
    "Bash(gh issue create*)",
    "Bash(gh issue delete*)",
    "Bash(gh pr *)",
    "Bash(gh label *)",
    "Bash(gh release *)",
    "{{tracker.writeDeny}}",
    "Edit(bin/**)",
    "Edit(templates/**)",
    "Edit(docs/**)",
    "Edit(decisions/**)",
    "Edit(limitations/**)",
    "Edit(fixtures/**)",
    "Edit(mods/**)",
    "Edit(roles/**)",
    "Edit(.claude/agent-memory/**)",
    "Edit(.claude/agents/**)",
    "Edit(.claude/agents.disabled/**)",
    "Edit(.claude/skills/**)",
    "Edit(.claude/settings*)",
    "Edit(.claude-plugin/**)",
    "Edit(.github/**)",
    "Edit(CLAUDE.md)",
    "Edit(README.md)"
  ]
}
