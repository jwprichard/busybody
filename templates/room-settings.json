      "Bash(gh api *--method=post*)",
      "Bash(gh api *-X put*)",
      "Bash(gh api *-Xput*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method=put*)",
      "Bash(gh api *-X patch*)",
      "Bash(gh api *-Xpatch*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=patch*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *-f=*)",
      "Bash(gh api graphql*)",
      "mcp__claude_ai_Gmail__send_message",
